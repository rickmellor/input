def _resolve_seat(name):
    """(model_id, base_url) for a seat name or a bare saint model id; None if empty."""
    if not name:
        return None
    if name in SEATS:
        return SEATS[name]
    return (name, SAINT_BASE)          # treat an unknown name as a saint-* model id


# --- per-model agent concurrency -------------------------------------------------
# Parallel sub-agents must not overwhelm a backend: a local inference server handles far
# less concurrency than a cloud API. Each MODEL gets its own bounded semaphore (default
# local=2, cloud=5, tunable via settings "agent_concurrency"), enforced inside spawn_agent
# so the limit holds across every in-flight spawn regardless of which turn issued it.
_MODEL_SEMS = {}
_MODEL_SEMS_LK = threading.Lock()
_AGENT_TLS = threading.local()   # per-worker handle to its ticker slot; spawn_agent flips it to
                                 # "running" the instant it clears the per-model semaphore


def _seat_kind(model, base):
    """'local' for a directly-hosted inference seat, else 'cloud' (incl. saint-auto/router)."""
    m, b = (model or "").lower(), (base or "")
    if "local" in m or "qwen" in m or "gemma" in m:
        return "local"
    if "cloud" in m:
        return "cloud"
    if ("127.0.0.1" in b or "localhost" in b) and ":4000" not in b:  # direct port, not the router
        return "local"
    return "cloud"                     # saint-auto / router / unknown → the generous budget


def _agent_caps():
    c = load_settings().get("agent_concurrency") or {}
    return {"local": max(1, int(c.get("local", 2))), "cloud": max(1, int(c.get("cloud", 5)))}


def _model_sem(model, base):
    """The bounded semaphore for `model` (created once, at that seat-kind's cap)."""
    with _MODEL_SEMS_LK:
        s = _MODEL_SEMS.get(model)
        if s is None:
            s = threading.BoundedSemaphore(_agent_caps()[_seat_kind(model, base)])
            _MODEL_SEMS[model] = s
        return s


class _StdoutRouter:
    """Installed as sys.stdout. Writes go to a thread-local buffer when one is set (so
    parallel tool dispatch captures each agent's output for ordered, non-interleaved flush),
    otherwise straight to the real stdout — transparent when nothing is capturing."""
    def __init__(self, real):
        self._real = real
        self._loc = threading.local()
        self._lock = threading.RLock()   # serialize writes so the footer thread can't interleave

    def _t(self):
        return getattr(self._loc, "buf", None) or self._real

    def write(self, s):
        with self._lock:
            return self._t().write(s)

    def flush(self):
        try:
            with self._lock:
                return self._t().flush()
        except Exception:
            pass

    def isatty(self):
        try:
            return self._real.isatty()
        except Exception:
            return False

    def capture(self, buf):
        self._loc.buf = buf

    def release(self):
        self._loc.buf = None

    def __getattr__(self, n):
        return getattr(self._real, n)


_STDOUT = None


def _install_stdout_router():
    """Idempotently wrap sys.stdout so parallel tool dispatch can buffer per-agent output."""
    global _STDOUT
    if _STDOUT is None and not isinstance(sys.stdout, _StdoutRouter):
        _STDOUT = _StdoutRouter(sys.stdout)
        sys.stdout = _STDOUT
    return _STDOUT


# --- footer status line: a persistent bottom row (mode · gate · live job alerts · ephemeral) ---
# A scroll region (DECSTBM) reserves the last row; output/the line-editor live in rows 1..h-1,
# the footer is repainted on row h via save/restore cursor so it never disturbs typing. A daemon
# repaints ~1/s so job counts update live. footer_disable() (finally + atexit) always resets the
# region, so a bug can never leave the terminal broken. Opt-in (settings "footer" / /footer on).
_FOOTER_ACTIVE = False
_footer_stop = threading.Event()
_footer_flash = {"msg": "", "until": 0.0}
_SAINT_RETRAIN = None          # x-saint-retrain reason (classifier drift) from the last SAINT response, or None
_SAINT_RETRAIN_NOTED = False   # printed the one-time session notice yet?


def _footer_clip(s, width):
    """Clip to `width` visible columns, keeping ANSI escapes (which take no columns)."""
    out, vis, i = [], 0, 0
    while i < len(s) and vis < width:
        if s[i] == "\033":
            j = s.find("m", i)
            if j == -1:
                break
            out.append(s[i:j + 1]); i = j + 1; continue
        out.append(s[i]); vis += 1; i += 1
    return "".join(out)


def footer_flash(msg, ttl=6.0):
    """Show a transient message in the footer for `ttl` seconds (a background event)."""
    _footer_flash["msg"], _footer_flash["until"] = msg, time.time() + ttl
    render_footer()


def _footer_text():
    parts = [f"{BOLD}▸ {PERM_MODE}{RESET}{DIM}"]
    g = load_settings().get("gate") or {}
    parts.append(f"gate ≤{g.get('interactive', 'low')}/{g.get('autonomous', 'low')}")
    try:
        states = [job_state(j) for j in list_jobs()]
    except Exception:
        states = []
    active = sum(1 for s in states if s in ("running", "queued"))
    blocked = sum(1 for s in states if s == "blocked")
    if active:
        parts.append(f"{active} job{'s' if active != 1 else ''} running")
    if blocked:
        parts.append(f"{RED_VIVID}{blocked} ⛔ /jobs answer{RESET}{DIM}")
    if _SAINT_RETRAIN:
        parts.append(f"{YEL}⚠ saint retrain{RESET}{DIM}")
    if _footer_flash["msg"] and time.time() < _footer_flash["until"]:
        parts.append(_footer_flash["msg"])
    return "  ·  ".join(parts)


def render_footer():
    """Repaint the footer on the reserved bottom row without moving the logical cursor."""
    if not _FOOTER_ACTIVE or not sys.stdout.isatty():
        return
    try:
        sz = shutil.get_terminal_size((80, 24))
        h, w = sz.lines, sz.columns
        txt = _footer_clip(_footer_text(), w - 1)
        sys.stdout.write(f"\0337\033[{h};1H\033[2K{DIM}{txt}{RESET}\0338")  # save·go·clear·write·restore
        sys.stdout.flush()
    except Exception:
        pass


def footer_enable():
    """Reserve the bottom row and start the repaint daemon (tty only, idempotent)."""
    global _FOOTER_ACTIVE
    if not sys.stdout.isatty() or _FOOTER_ACTIVE:
        return
    h = shutil.get_terminal_size((80, 24)).lines
    sys.stdout.write(f"\033[1;{h - 1}r\033[{h - 1};1H")   # scroll region 1..h-1; cursor into it
    sys.stdout.flush()
    _FOOTER_ACTIVE = True
    _footer_stop.clear()
    render_footer()
    threading.Thread(target=_footer_loop, daemon=True).start()


def footer_disable():
    """Reset the scroll region and clear the footer — restore a normal terminal."""
    global _FOOTER_ACTIVE
    _footer_stop.set()
    if sys.stdout.isatty() and _FOOTER_ACTIVE:
        h = shutil.get_terminal_size((80, 24)).lines
        sys.stdout.write(f"\033[r\033[{h};1H\033[2K"); sys.stdout.flush()
    _FOOTER_ACTIVE = False


def clear_screen():
    """Clear the visible screen AND scrollback, cursor home; re-paint the footer if active."""
    if not sys.stdout.isatty():
        return
    sys.stdout.write("\033[3J\033[2J\033[H")   # scrollback + screen + home
    sys.stdout.flush()
    if _FOOTER_ACTIVE:
        render_footer()


def _footer_loop():
    last_h = None
    while not _footer_stop.wait(1.0):
        if _FOOTER_ACTIVE and sys.stdout.isatty():
            h = shutil.get_terminal_size((80, 24)).lines
            if h != last_h:                                   # terminal resized → re-assert region
                sys.stdout.write(f"\0337\033[1;{h - 1}r\0338"); last_h = h
        render_footer()


_SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"


def _call_label(name, args):
    """Short live-status label for a tool call: the sub-agent's skill/seat, else the tool."""
    if name == "spawn_agent" and isinstance(args, dict):
        sk = (args.get("skill") or "").strip()
        if sk:
            return sk
        mdl = (args.get("model") or "").strip()
        if mdl:
            return mdl.split("-")[-1] if "-" in mdl else mdl   # cloud-small → small
        return "agent"
    return name


def _agents_ticker(agents, stop):
    """Live multi-line spinner over parallel agents: a header + one indented line per agent
    carrying a running elapsed clock (s → Mm SSs → Hh MMm via _fmt_dur), redrawn in place
    until `stop` is set. Own thread, writes to the real terminal (workers write to their own
    buffers). Self-clears the whole block on stop, so the caller needn't know its height."""
    n = len(agents)
    width = min(40, max((len(a["label"]) for a in agents), default=0))
    drawn, f = 0, 0
    while not stop.wait(0.1 if f else 0):
        frame = _SPIN[f % len(_SPIN)]
        now = time.monotonic()
        done = sum(1 for a in agents if a["state"] == "done")
        run = sum(1 for a in agents if a["state"] == "running")
        q = sum(1 for a in agents if a["state"] == "queued")
        head = f"  {frame} {n} agents · {run} running" + (f" · {q} queued" if q else "") + f" · {done} done"
        out = [f"{DIM}{head}{RESET}"]
        for a in agents:
            cell = f"{a['label'][:width]:<{width}}"
            if a["state"] == "done":
                out.append(f"{DIM}      {cell}  {RESET}{GREEN_BUILD}✓{RESET}{DIM} done · {_fmt_dur(a['dur'] or 0)}{RESET}")
            elif a["state"] == "running":
                out.append(f"{DIM}      {cell}  {frame} running · {_fmt_dur(now - (a['start'] or now))}{RESET}")
            else:
                out.append(f"{DIM}      {cell}  · queued{RESET}")
        buf = (f"\033[{drawn}A" if drawn else "") + "".join("\r\033[K" + ln + "\n" for ln in out)
        sys.stdout.write(buf); sys.stdout.flush()
        drawn, f = len(out), f + 1
    if drawn:                                      # wipe the whole block on stop
        sys.stdout.write(f"\033[{drawn}A\r\033[J"); sys.stdout.flush()


_SEAT_GUIDANCE_CACHE = {}      # (target) -> (expiry_ts, guidance|None); johnny resolve is a subprocess

def seat_guidance(target, ttl=60.0):
    """What agent-guidance does the seat backing `target` want? (johnny `resolve --json` → `guidance`)

    johnny profiles can declare `guidance: roadmap` on a seat whose model executes delegated work
    well but plans it poorly — measured on gemma-4-26B (PlanBench 34%, AutomationBench 0-6.7% on
    30-50-step loops, yet 5/5 on short delegate tasks). With an explicit ordered brief it needed
    5.1 tool steps instead of 6.4 and stayed off the step ceiling on the ambiguous task (5-6 vs
    8/8 bare, 2026-08-24). Correctness was unchanged at short horizons — this buys efficiency and
    margin, so it's an optimization, not a crutch. Best-effort: any failure returns None and the
    caller falls back to a bare brief."""
    now = time.monotonic()
    hit = _SEAT_GUIDANCE_CACHE.get(target)
    if hit and hit[0] > now:
        return hit[1]
    g = None
    try:
        out = subprocess.run(["johnny", "resolve", target, "--json"], capture_output=True,
                             text=True, timeout=8)
        if out.returncode == 0:
            g = (json.loads(out.stdout) or {}).get("guidance") or None
    except Exception:
        g = None
    _SEAT_GUIDANCE_CACHE[target] = (now + ttl, g)
    return g


_ROADMAP_BRIEF = (
    "This seat executes reliably but plans weakly: work the brief in the order given and do not "
    "re-plan it. If the brief lacks an explicit sequence, derive the shortest one, state it in a "
    "line or two, then follow it. When a step is ambiguous (e.g. two files could hold the fix), "
    "pick one, say why in a sentence, and proceed instead of exploring alternatives. Run ONE step at a "
    "time and read its output before starting the next — never fire off a batch of steps and assume "
    "they all worked."
)

def _subagent_system(cwd, skill, seat=None, model_id=None, write=False, max_rounds=None, guidance=None):
    """A sub-agent's system prompt: grounding + the cwd's folder context + one skill brief +
    autonomy framing. Deliberately WITHOUT the parent's mode directives / loaded skills.
    `seat`/`model_id` name the seat this agent runs on so it can self-report / a skill can
    verify its own model pin (the harness otherwise never tells a sub-agent its own model)."""
    parts = [stable_context()]
    if seat or model_id:
        which = f"the {seat} seat" if seat else "the assigned seat"
        mid = f" (model {model_id})" if model_id else ""
        parts.append(f"You are running on {which}{mid}.")
    if guidance == "roadmap":       # johnny profile says this seat wants an explicit plan
        parts.append(_ROADMAP_BRIEF)
    fc = folder_context(cwd)
    if fc:
        parts.append(fc)
    if skill:
        body = skill_body(skill)
        if body:
            parts.append(f"## Skill: {skill}\n{body}")
    parts.append(
        "You are a SUB-AGENT working autonomously toward the task below. Use your tools to do "
        "the work; do NOT ask the user questions — make reasonable assumptions and note them. "
        "Your FINAL message is your entire deliverable back to the orchestrator: make it "
        "complete and self-contained (findings, what you did, any caveats). Report ONLY what you "
        "actually observed: if a command fails, returns nothing, or is unavailable to you, say so "
        "and show the failure — never fill the gap with a plausible-looking result. A short report "
        "of real findings beats a complete-looking one you partly invented.")
    allowed = SANDBOX_DEV if write else SANDBOX_READONLY
    parts.append(
        "## Tool rules (sandbox)\n"
        f"- Sandbox root: {cwd}. read/list/write paths must stay inside it.\n"
        "- `bash` is SHELL-LESS: one command per call, argv-split, NO pipes, redirects, globs, heredocs, "
        "`&&`/`;`. `~` IS expanded. Use `grep`/`find`/`head` flags instead of pipes; for code use a "
        "single `python3 -c '…'`. " + ("`bash -c '…'` is available for real shell syntax." if write else
        "`bash -c`, `git clone`, package installs and writes are NOT available in this read-only agent — "
        "say what you would have run; ask the orchestrator for write=true if the task truly needs it.") + "\n"
        f"- Allowed command prefixes: {', '.join(allowed)}.\n"
        + (f"- Budget: {max_rounds} tool rounds (repeating the exact same calls 4× counts as a stall). Write your final report as TEXT "
           "(a message with no tool calls) — if the budget runs out you get one last no-tools turn to "
           "summarize what you have, so keep notes in your own words as you go.\n" if max_rounds else ""))
    return "\n\n".join(p for p in parts if p)


def _tool_spawn_agent(args):
    a = args or {}
    task = (a.get("task") or a.get("brief") or "").strip()
    if not task:
        return "Error: spawn_agent needs a 'task'."
    skill = (a.get("skill") or "").strip()
    if skill and skill not in SKILLS:
        return f"Error: no such skill {skill!r}. Available: {', '.join(SKILLS) or '(none)'}"
    cwd = os.path.abspath(os.path.expanduser(a.get("cwd") or os.getcwd()))
    write = bool(a.get("write"))
    budget = int(a.get("budget_tokens") or 200_000)
    max_rounds = max(2, int(a.get("max_rounds") or SUBAGENT_MAX_ROUNDS))
    # model: explicit pin > skill's declared seat > (classify the brief) hard→reasoning_seat, else saint-auto
    model = (a.get("model") or "").strip() or (SKILLS.get(skill, {}).get("seat") or "")
    if not model:
        model = agentic_seat(task)
    m, b = _resolve_seat(model) or SEATS.get("saint") or (MODEL, BASE)
    guidance = seat_guidance(model if model in SEATS else m)
    system = _subagent_system(cwd, skill, seat=(model if model in SEATS else None), model_id=m,
                              write=write, max_rounds=max_rounds, guidance=guidance)
    sb = Sandbox(root=cwd, allow=(SANDBOX_DEV if write else SANDBOX_READONLY))
    tools = sandbox_tools(sb, write=write)
    label = skill or (m.split("-")[-1] if "-" in m else m)

    def on_tool(ev, tc, out):
        if ev == "call":
            fn = tc.get("function") or {}
            print(f"{DIM}    ⟳ {fn.get('name')}({_fmt_args(fn.get('arguments'))[:56]}){RESET}")
        return None

    print(f"{DIM}  ⟳ spawn[{label} · {m}{' · write' if write else ''}]: {task[:64]}{RESET}")
    with _model_sem(m, b):                 # per-model concurrency cap (local=2, cloud=5)
        slot = getattr(_AGENT_TLS, "slot", None)   # now holding a real slot → mark it running
        if slot is not None:
            slot["state"] = "running"; slot["start"] = time.monotonic()
        t0 = time.monotonic()              # time generation only, not queue wait on the semaphore
        res = run_thread(task, system=system, model=m, base=b, tools=tools, quiet=True,
                         budget_tokens=budget, on_tool=on_tool, gate=False,
                         max_rounds=max_rounds, finalize_on_cap=True)
        dt = time.monotonic() - t0
    tag = "" if res["stopped"] == "done" else f" [{res['stopped']}]"
    rate = res["tokens_out"] / res["decode_s"] if res.get("decode_s") else 0  # decode rate, not wall
    dur = f"{dt:.1f}s" if dt < 10 else _fmt_dur(dt)   # wall time (incl. prefill/TTFT); decimals when short
    # this sub-agent's own metrics (kept OUT of the main stats, which stay the orchestrator's)
    print(f"{DIM}  ⟳ done[{label}] {res['rounds']}r · {res['tool_calls']} tools · "
          f"↓{res['tokens_in']} ↑{res['tokens_out']} · {rate:.0f} tok/s · {dur}{tag}{RESET}")
    if res["error"]:
        return f"(sub-agent errored: {res['error']})"
    return res["text"] or f"(sub-agent produced no text; stopped={res['stopped']})"


