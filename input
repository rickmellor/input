            sys.stdout.write(f"\033[{drawn[0]}A")
        total = 0
        name_w = max(18, max(len(n) for n in names))
        src_w = max(len(f"[{TOOLS[n].source}]") for n in names)
        indent = 6 + name_w + src_w + 2           # ONE description column for every row (aligned wraps)
        width = max(20, cols - indent - 1)
        for i, n in enumerate(names):
            t = TOOLS[n]
            box = f"{CODE_FG}[x]{RESET}" if t.enabled else f"{DIM}[ ]{RESET}"
            cur = f"{BOLD}❯{RESET} " if i == sel else "  "
            src = f"[{t.source}]"
            lines = textwrap.wrap(" ".join(t.description.split()), width=width) or [""]
            sys.stdout.write(f"\r\033[K{cur}{box} {n:<{name_w}}{DIM}{src:<{src_w}}  {lines[0]}{RESET}\r\n")
            for ln in lines[1:]:
                sys.stdout.write(f"\r\033[K{' ' * indent}{DIM}{ln}{RESET}\r\n")
            total += len(lines)
        drawn[0] = total
        sys.stdout.flush()

    try:
        tty.setraw(fd)
        draw(first=True)
        while True:
            ch = os.read(fd, 1)
            if ch in (b"q", b"\x03"):
                break
            if ch in (b" ", b"\r", b"\n"):
                TOOLS[names[sel]].enabled = not TOOLS[names[sel]].enabled; draw()
            elif ch in (b"a", b"A"):
                for n in names: TOOLS[n].enabled = True
                draw()
            elif ch in (b"n", b"N"):
                for n in names: TOOLS[n].enabled = False
                draw()
            elif ch in (b"j", b"J"):
                sel = (sel + 1) % len(names); draw()
            elif ch in (b"k", b"K"):
                sel = (sel - 1) % len(names); draw()
            elif ch == b"\x1b":
                if select.select([fd], [], [], 0.05)[0]:
                    seq = os.read(fd, 2)
                    if seq == b"[A":
                        sel = (sel - 1) % len(names); draw()
                    elif seq == b"[B":
                        sel = (sel + 1) % len(names); draw()
                else:
                    break                          # bare Esc closes
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
    st = load_settings()
    st["tools_state"] = {n: TOOLS[n].enabled for n in TOOLS
                         if TOOLS[n].enabled != TOOLS[n].default_enabled}
    st.pop("tools_disabled", None)                    # migrated to tools_state
    save_settings(st)
    on = sum(TOOLS[n].enabled for n in names)
    print(f"{DIM}→ {on}/{len(names)} tools enabled{RESET}")


