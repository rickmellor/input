        _sb_prefixed = (user == "/sidebar" or user.startswith("/sidebar ")
                        or user == "/aside" or user.startswith("/aside "))
        _sb_bare = ((user in ("/merge", "/drop", "/done", "/return", "/update") and SIDEBARS)  # in-sidebar ops
                    or (user == "/list" and (SIDEBARS or _SB_PAUSED))                          # list any sidebars
                    or ((user == "/resume" or user.startswith("/resume ")) and _SB_PAUSED))    # resume a parked one
        if _sb_prefixed or _sb_bare:
            if _sb_prefixed:
                arg = user.split(None, 1)[1].strip() if " " in user else ""
            else:                                          # bare /merge /drop /done /return /update /list /resume
                arg = user[1:]
            sub = arg.split()[0].lower() if arg else ""
            tok = arg.split(None, 1)[1].strip() if len(arg.split()) > 1 else ""

            if sub in ("list", "ls"):                      # show the active nesting tree + parked ones
                if not SIDEBARS and not _SB_PAUSED:
                    print(f"{DIM}no sidebars — /sidebar [topic] starts one{RESET}"); continue
                root_here = f"{CODE_FG}  ★ you are here{RESET}" if not SIDEBARS else ""
                print(f"{DIM}  ▸ main thread{root_here}{RESET}")
                for i, f in enumerate(SIDEBARS):           # active stack = live nesting, root→current
                    indent = "   " + "   " * i
                    here = f"{CODE_FG}  ★ you are here{RESET}" if i == len(SIDEBARS) - 1 else ""
                    print(f"{DIM}{indent}└▸ #{f['id']} {f['label']}  (L{i + 1}){here}{RESET}")
                if _SB_PAUSED:                             # parked = detached branches, not in the tree
                    print(f"{DIM}  ⏸ parked (resume to re-enter):{RESET}")
                    for f in _SB_PAUSED:
                        print(f"{DIM}      #{f['id']} {f['label']}  ({len(f['branch'])} msgs){RESET}")
                print(f"{DIM}  /sidebar resume [#id|label] · /merge · /update · /return · /drop{RESET}")
                continue
            if sub == "resume":                            # re-enter a paused sidebar
                if not _SB_PAUSED:
                    print(f"{DIM}no paused sidebars — /sidebar list{RESET}"); continue
                entry = _sb_match_paused(tok) if tok else (_SB_PAUSED[0] if len(_SB_PAUSED) == 1 else None)
                if entry is None and not tok:              # >1 paused, none named → picker
                    labels = [f"#{f['id']}  {f['label']}  ({len(f['branch'])} msgs)" for f in _SB_PAUSED]
                    res = _pick(labels, 0, hint="↑/↓ or j/k · enter resume · q cancel")
                    if not res:
                        print(f"{DIM}resume cancelled{RESET}"); continue
                    entry = _SB_PAUSED[res[0]]
                if entry is None:
                    print(f"{DIM}no paused sidebar matches {tok!r} — /sidebar list{RESET}"); continue
                _sb_resume(history, entry)
                print(f"{DIM}▸ resumed sidebar #{entry['id']} '{entry['label']}'  ·  /merge · /drop · /return{RESET}")
                continue

            if sub in ("update", "sync"):                  # post an interim update to main, stay in sidebar
                if not SIDEBARS:
                    print(f"{DIM}not in a sidebar — /sidebar [topic] starts one{RESET}"); continue
                f = SIDEBARS[-1]
                where = "the main thread" if len(SIDEBARS) == 1 else f"sidebar '{SIDEBARS[-2]['label']}'"
                print(f"{DIM}⇡ posting an interim update from '{f['label']}' to {where}…{RESET}")
                upd = sidebar_summarize(history, MODEL, BASE, incremental=True) or "(no update captured)"
                _SB_UNDER[-1].append({"role": "user",
                                      "content": f"[Interim update from sidebar '{f['label']}' (still open):] {upd}"})
                _SB_UNDER[-1].append({"role": "assistant", "content": f"Noted the sidebar's interim update: {upd}"})
                print(f"{DIM}  ⇡ update posted (sidebar stays open): {upd[:200]}{RESET}")
                continue

            if sub in ("merge", "done", "close", "drop", "cancel", "return", "back", "pause"):
                if not SIDEBARS:
                    print(f"{DIM}not in a sidebar — /sidebar [topic] starts one{RESET}"); continue
                if sub in ("drop", "cancel"):
                    f = _sb_leave(history)
                    print(f"{DIM}sidebar '{f['label']}' dropped — nothing merged{RESET}")
                elif sub in ("return", "back", "pause"):
                    f = _sb_pause(history)
                    where = "the main thread" if not SIDEBARS else f"sidebar '{SIDEBARS[-1]['label']}'"
                    print(f"{DIM}⏸ sidebar '{f['label']}' parked — back on {where}  ·  /sidebar resume returns to it{RESET}")
                else:                                      # merge / done / close
                    f = SIDEBARS[-1]
                    print(f"{DIM}⟲ folding sidebar '{f['label']}' back into the main thread…{RESET}")
                    summary = sidebar_summarize(history, MODEL, BASE) or "(no conclusion captured)"
                    _sb_leave(history)
                    history.append({"role": "user",
                                    "content": f"[Sidebar '{f['label']}' concluded — carrying back:] {summary}"})
                    history.append({"role": "assistant", "content": f"Noted the sidebar's conclusion: {summary}"})
                    print(f"{DIM}  ↩ merged: {summary[:200]}{RESET}")
                continue

            label = arg.strip() or "sidebar"               # otherwise: fork a new sidebar (topic optional)
            _sb_fork(history, label)
            depth = "▸" * len(SIDEBARS)
            print(f"{DIM}● sidebar {depth} {label}  (branch of the current thread; /merge folds back · "
                  f"/drop discards · /return parks it){RESET}")
            continue
        if user == "/jobs" or user.startswith("/jobs "):
            parts = user.split(None, 2)
            sub = parts[1].lower() if len(parts) > 1 else ""
            rest = parts[2].strip() if len(parts) > 2 else ""
            _JST = {"queued": DIM, "running": CODE_FG, "blocked": RED_VIVID, "done": GREEN_BUILD,
                    "failed": RED_VIVID, "dead": RED_VIVID, "stalled": YEL, "killed": DIM}
            if sub in ("", "list", "ls") or (sub in ("show", "status", "log", "tail") and not rest):
                if sub in ("show", "status", "log", "tail"):
                    print(f"{DIM}(need a job id — here are the jobs; /jobs {sub} <id> for one){RESET}")
                js = list_jobs()
                if not js:
                    print(f"{DIM}no jobs — /jobs build <plan-id> · /jobs run <goal…>{RESET}")
                for m in js:
                    st = job_state(m); col = _JST.get(st, DIM)
                    dur = _fmt_dur((m.get("ended") or time.time())
                                   - (m.get("started") or m.get("created") or time.time()))
                    dn, tot, pct = _job_progress(m)
                    prog = f" {pct}% ({dn}/{tot})" if pct is not None else ""
                    toks = f" · {m.get('tokens_out', 0)}out" if m.get("tokens_out") else ""
                    print(f"{DIM}  {m['id']}  {col}{st:<8}{RESET}{DIM} {dur:>6}{prog}{toks}  {m.get('title', '')[:44]}{RESET}")
            elif sub in ("show", "status", "log", "tail") and rest:
                jid = rest.split()[0]
                m = _read_meta(jid)
                if not m:
                    print(f"{DIM}no job {jid}{RESET}"); continue
                st = job_state(m)
                dn, tot, pct = _job_progress(m)
                print(f"{DIM}{jid} · {m.get('kind')} · {_JST.get(st, DIM)}{st}{RESET}{DIM} · {m.get('title', '')}{RESET}")
                print(f"{DIM}  goal: {m.get('goal', '')[:100]}{RESET}")
                print(f"{DIM}  cwd {m.get('cwd')} · model {m.get('model')} · "
                      f"run {_fmt_dur((m.get('ended') or time.time()) - (m.get('started') or m.get('created')))} · "
                      f"{m.get('rounds', 0)} rounds · {m.get('tool_calls', 0)} tools · "
                      f"↑{m.get('tokens_out', 0)} ↓{m.get('tokens_in', 0)}"
                      f"{f' · plan {pct}% {dn}/{tot}' if pct is not None else ''}{RESET}")
                if st == "blocked":
                    print(f"{RED_VIVID}  ⛔ needs: {m.get('need')}{RESET}{DIM}  → /jobs answer {jid} <text>{RESET}")
                logp = os.path.join(_job_dir(jid), "log.jsonl")
                if (sub in ("log", "tail")) and os.path.exists(logp):
                    for ln in open(logp).read().splitlines()[-14:]:
                        try:
                            e = json.loads(ln)
                            print(f"{DIM}   {e['kind']:<12} {e.get('name') or e.get('need') or e.get('error') or ''}"
                                  f"  {(e.get('out') or e.get('args') or '')[:60]}{RESET}")
                        except Exception:
                            pass
                elif m.get("result_path") and os.path.exists(m["result_path"]):
                    print(f"{DIM}  ── result ──{RESET}")
                    print(open(m["result_path"]).read()[:1600])
            elif sub in ("stop", "kill") and rest:
                jid = rest.split()[0]; m = _read_meta(jid)
                if m and m.get("pid") and _pid_alive(m["pid"]):
                    try:
                        os.killpg(os.getpgid(m["pid"]), 15)
                    except Exception:
                        try: os.kill(m["pid"], 15)
