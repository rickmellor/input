# --- instruction layer: skills + AGENTS.md/CLAUDE.md ------------------------------
# Two flavours of instruction source, differing only in loading policy:
#   skills     — on-demand playbooks. Claude Code's SKILL.md format verbatim (frontmatter
#                name/description[/model], markdown body) so one skill works in both tools.
#                Found in ~/.config/input/skills/, ~/.claude/skills/ (reuse Claude's), and
#                <git-root>/.claude/skills/; either <name>/SKILL.md or a bare <name>.md.
#                name+description ride the system prompt always (cheap); the BODY loads
#                only on trigger: explicit `/skill <name>` or the model calling load_skill.
#   AGENTS.md  — folder-scoped, always-on. Read AGENTS.md (else CLAUDE.md) from the project
#                (git) root down to cwd, plus a global ~/.config/input/AGENTS.md; stacked
#                root-first so the file CLOSEST to the work wins on conflict while inheriting
#                the rest. Keyed by cwd, so sub-agents/jobs load the folder they run in.
# Both ride the STABLE system prefix (cache-safe); they change rarely.
_SKILL_ROOTS = [os.path.expanduser("~/.config/input/skills"), os.path.expanduser("~/.claude/skills")]
_GLOBAL_AGENTS = os.path.expanduser("~/.config/input/AGENTS.md")
SKILLS = {}            # name -> {"name","description","path","seat"}; body read lazily
LOADED_SKILLS = []     # names whose bodies are in the system prompt (in load order)
_FOLDER_CACHE = {}     # cwd -> (signature, text)


def _frontmatter(text):
    """Minimal YAML-frontmatter reader: `key: value` and `key: |` block scalars. Returns
    (meta:dict, body:str). No frontmatter → ({}, text)."""
    if not text.startswith("---"):
        return {}, text
    end = text.find("\n---", 3)
    if end < 0:
        return {}, text
    head, body = text[3:end], text[end + 4:]
    meta, key, block = {}, None, None
    for line in head.splitlines():
        if block is not None and (line.startswith("  ") or line.startswith("\t") or not line.strip()):
            block.append(line.strip()); continue
        if block is not None:
            meta[key] = " ".join(x for x in block if x).strip(); block = None
        m = re.match(r"^([A-Za-z_][\w-]*):\s*(.*)$", line)
        if not m:
            continue
        key, val = m.group(1), m.group(2).strip()
        if val in ("|", ">", "|-", ">-"):
            block = []
        else:
            meta[key] = val.strip("'\"")
    if block is not None:
        meta[key] = " ".join(x for x in block if x).strip()
    return meta, body.lstrip("\n")


def _git_root(path):
    p = os.path.abspath(path)
    while True:
        if os.path.isdir(os.path.join(p, ".git")):
            return p
        parent = os.path.dirname(p)
        if parent == p:
            return None
        p = parent


def discover_skills(cwd=None):
    """(Re)scan the skill roots (+ the project's .claude/skills) into SKILLS."""
    roots = list(_SKILL_ROOTS)
    gr = _git_root(cwd or os.getcwd())
    if gr:
        roots.append(os.path.join(gr, ".claude", "skills"))
    # a skill for a capability an input subsystem owns (astoria/memoryos = ambient memory)
    # would steer the model at suppressed tools — hide it, mirroring mcp_claims().
    claimed = {"memoryos", "astoria"} if mem_config().get("enabled") else set()
    found = {}
    for root in roots:
        if not os.path.isdir(root):
            continue
        for entry in sorted(os.listdir(root)):
            full = os.path.join(root, entry)
            path = os.path.join(full, "SKILL.md") if os.path.isdir(full) else (full if entry.endswith(".md") else None)
            if not path or not os.path.isfile(path):
                continue
            try:
                meta, _ = _frontmatter(open(path).read())
            except Exception:
                continue
            name = (meta.get("name") or (entry[:-3] if entry.endswith(".md") else entry)).strip()
            if not name or name in found:        # first root wins (input's own > claude's > project)
                continue
            if name in claimed:                  # claimed by a subsystem (e.g. astoria = ambient memory)
                continue
            found[name] = {"name": name, "description": meta.get("description", "").strip(),
                           "path": path, "seat": (meta.get("model") or meta.get("seat") or "").strip()}
    SKILLS.clear(); SKILLS.update(found)
    return found


def skill_body(name):
    s = SKILLS.get(name)
    if not s:
        return None
    try:
        _, body = _frontmatter(open(s["path"]).read())
        return body.strip()
    except Exception:
        return None


def load_skill(name):
    """Load a skill's body into the system prompt. Returns the body, or None if unknown."""
    body = skill_body(name)
    if body is None:
        return None
    if name not in LOADED_SKILLS:
        LOADED_SKILLS.append(name)
    return body


def skills_index_text():
    """The always-on, cheap skills listing for the system prompt (names + descriptions)."""
    if not SKILLS:
        return ""
    lines = [f"- {n}: {s['description'] or '(no description)'}" for n, s in SKILLS.items()
             if n not in LOADED_SKILLS]
    if not lines:
        return ""
    return ("Available skills (playbooks). When a request matches one, call load_skill(name) "
            "to pull in its full instructions BEFORE acting:\n" + "\n".join(lines))


def folder_context(cwd=None):
    """AGENTS.md/CLAUDE.md stack for `cwd`: global file, then project root → cwd (root-first;
    closest wins). Cached by (cwd, file mtimes). Returns text ('' if none)."""
    cwd = os.path.abspath(cwd or os.getcwd())
    paths = []
    if os.path.isfile(_GLOBAL_AGENTS):
        paths.append(_GLOBAL_AGENTS)
    root = _git_root(cwd) or cwd
    chain, p = [], cwd
    while True:
        chain.append(p)
        if p == root or os.path.dirname(p) == p:
            break
        p = os.path.dirname(p)
    for d in reversed(chain):                  # root → cwd
        for fn in ("AGENTS.md", "CLAUDE.md"):  # AGENTS.md wins when both exist in a dir
            f = os.path.join(d, fn)
            if os.path.isfile(f):
                paths.append(f); break
    sig = tuple((f, os.path.getmtime(f)) for f in paths)
    hit = _FOLDER_CACHE.get(cwd)
    if hit and hit[0] == sig:
        return hit[1]
    parts = []
    for f in paths:
        try:
            body = open(f).read().strip()
        except Exception:
            continue
        if body:
            label = "global" if f == _GLOBAL_AGENTS else os.path.relpath(f, root) if f.startswith(root) else f
            parts.append(f"### {label}\n{body}")
    text = ""
    if parts:
        text = ("Project instructions (AGENTS.md / CLAUDE.md). Instructions closer to the "
                "working directory take precedence over those above them; otherwise all apply.\n\n"
                + "\n\n".join(parts))
    _FOLDER_CACHE[cwd] = (sig, text)
    return text


def instruction_layer(cwd=None):
    """Folder context + skills index + loaded skill bodies, for the system prompt."""
    blocks = []
    fc = folder_context(cwd)
    if fc:
        blocks.append(fc)
    idx = skills_index_text()
    if idx:
        blocks.append(idx)
    for n in LOADED_SKILLS:
        b = skill_body(n)
        if b:
            blocks.append(f"## Skill: {n}\n{b}")
    return "\n\n".join(blocks)


