        print(_status_line(stats))
        _offer_build()                             # if the model just saved a plan, offer to build it


# --- arg parsing ----------------------------------------------------------------
argv = sys.argv[1:]
MODE, task_words, JOB_ID = None, None, None
if "--job" in argv:                            # detached job runner: input --job <id>
    i = argv.index("--job")
    MODE, JOB_ID, argv = "--job", (argv[i + 1] if len(argv) > i + 1 else ""), argv[:i]
for flag in ("-e", "-x", "--goal", "--auto", "--gen"):
    if MODE:
        break
    if flag in argv:
        i = argv.index(flag)
        MODE, task_words, argv = flag, argv[i + 1:], argv[:i]
        break

if MODE == "--job":
    MODEL, BASE = SEATS.get("saint", (list(SEATS.values())[0] if SEATS else ("saint-auto", SAINT_BASE)))
elif argv and argv[0] in SEATS:
    MODEL, BASE = SEATS[argv[0]]
elif argv:
    MODEL, BASE = argv[0], (argv[1] if len(argv) > 1 else "http://127.0.0.1:8002/v1")
elif MODE in ("-e", "-x", "--goal", "--auto", "--gen"):
    MODEL, BASE = SEATS[_pick_seat("coder", "saint", "chat")]   # command/goal work → coder seat
else:
    MODEL, BASE = SEATS[load_default_seat() or _pick_seat("saint", "chat")]   # chat → saved default


def _task():
    t = " ".join(task_words)
    if t:
        return t
    if MODE == "--gen":
        sys.exit("usage: input --gen <buffer text>")
    try:
        return input("task: ").strip()
    except (EOFError, KeyboardInterrupt):
        sys.exit(130)


def _main():
    _install_stdout_router()   # transparent passthrough until parallel dispatch buffers output
    if MODE == "--job":
        sys.exit(run_job(JOB_ID))
    if MODE == "--gen":
        sys.stdout.write(generate(_task()))
    elif MODE in ("-e", "-x"):
        sys.exit(shell_mode(_task(), auto=(MODE == "-x")))
    elif MODE in ("--goal", "--auto"):
        sys.exit(goal_mode(_task(), auto=(MODE == "--auto")))
    else:
        repl()


if __name__ == "__main__":   # importable as a module (engine/sandbox reuse) without starting the REPL
    _main()
