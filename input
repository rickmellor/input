# --- settings + always-on grounding context -------------------------------------
# settings.json is the shared config store (location now; tool prefs later). Grounding
# is injected into the system context on EVERY request so the model always knows the
# current time — cheaper and more reliable than a get_current_time tool it must decide
# to call. Location rides along when set (settings 'location' or $INPUT_LOCATION).
_SETTINGS = os.path.expanduser("~/.config/input/settings.json")


def load_settings():
