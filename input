# --- /goal: exit criteria the agent works toward (anti-early-abort) -------------------
# A goal is a termination CONTRACT for a thread (the session, a sub-agent, a job): keep
# working until the exit criteria are met; don't stop at the first plausible answer. The
# only legitimate early stop is a HARD BLOCK — needs a credential/secret, an ambiguous spec
# that requires a human decision, a destructive/irreversible step, or repeated tool failure.
# Then the thread parks in `blocked` with a PRECISE need (resumable), never silently quits.
GOAL = ""              # the session's exit criteria ("" = none)
GOAL_SEAT = ""         # seat the goal loop is pinned to (set when the goal is HARD; "" = active seat)
GOAL_BLOCKED = ""      # the precise need when the session is hard-blocked ("" = not blocked)
GOAL_MAX_NUDGES = 4    # per turn: how many times we push the model back to work before pausing


def reasoning_seat():
    """The capable seat agentic HARD reasoning escalates to (settings `reasoning_seat`).
    Hard reasoning doesn't belong on weak local models — the goal/task's contract (GOAL MET /
    BLOCKED) and multi-step planning need a strong model; trivial/medium work stays on
    saint-auto (routed cheaply)."""
    s = load_settings().get("reasoning_seat") or "cloud-large"   # Opus: hard reasoning belongs on the strong seat
    return s if s in SEATS else "saint"


def classify_complexity(text):
    """Ask SAINT to classify `text` (one throwaway token; SAINT caches). Returns
    (domain, complexity) e.g. ('code','hard'), or ('','') if SAINT is unreachable."""
    try:
        req = urllib.request.Request(
            SAINT_BASE + "/chat/completions",
            json.dumps({"model": "saint-auto", "max_tokens": 1,
                        "messages": [{"role": "user", "content": (text or "")[:2000]}]}).encode(),
            {"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=8) as r:
            return r.headers.get("x-saint-domain", ""), r.headers.get("x-saint-complexity", "")
    except Exception:
        return "", ""


def agentic_seat(task, pinned=None, default="saint"):
    """Resolve the seat for agentic work: an explicit pin wins; else classify the task once —
    HARD → reasoning_seat() (capable), otherwise `default` (saint-auto routes per turn). The
    task's difficulty is judged from the WHOLE brief, not the trivial per-turn nudges, so a
    hard goal/job stays on a strong model for its whole loop."""
    if pinned:
        return pinned
    _, cx = classify_complexity(task)
    return reasoning_seat() if cx == "hard" else default
_GOAL_DIRECTIVE = (
    "SESSION GOAL (exit criteria): {goal}\n"
    "Work toward this goal persistently across turns until the exit criteria are genuinely met — "
    "do NOT stop early, do NOT declare success without evidence, do NOT ask permission for "
    "routine steps. When the criteria are met, end your reply with a line `GOAL MET: <evidence>`. "
    "The ONLY reason to stop short is a hard block: you need a credential/secret, the spec is "
    "ambiguous in a way only the user can resolve, the next step is destructive/irreversible, "
    "or a tool has failed repeatedly (3+) despite fixes. Then end your reply with ONE line "
    "`BLOCKED: <exactly what you need>` and stop. Otherwise keep going."
)
_GOAL_MET_RE = re.compile(r"^\s*GOAL MET\b", re.M)
_GOAL_BLOCKED_RE = re.compile(r"^\s*BLOCKED:\s*(.+)$", re.M)


def goal_terminate(goal, nudges_left):
    """Build a run_thread `terminate` hook for `goal`. Returns (done, nudge)."""
    state = {"left": nudges_left}

    def _t(text, res):
        global GOAL_BLOCKED
        t = text or ""
        m = _GOAL_BLOCKED_RE.search(t)
        if m:
            GOAL_BLOCKED = m.group(1).strip()
            res["blocked"] = GOAL_BLOCKED
            return True, None                   # parked: needs the user (resumable)
        if _GOAL_MET_RE.search(t):
            res["goal_met"] = True
            return True, None
        if state["left"] <= 0:
            res["goal_paused"] = True
            return True, None                   # pause; user can say "continue"
        state["left"] -= 1
        return False, ("The goal is not yet met. Continue working toward the exit criteria: "
                       f"{goal}. If you are genuinely hard-blocked, reply with `BLOCKED: <need>`; "
                       "when done, `GOAL MET: <evidence>`.")
    return _t


