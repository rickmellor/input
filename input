def read_line(prompt):
    """cbreak line reader: returns (text, mode). mode 'send' on Enter, 'pick' on
    Ctrl+Enter (terminals that send LF), None text with 'eof' on Ctrl-D. Falls back
    to input() off-TTY. Up/down walk readline history; basic cursor editing."""
    if not sys.stdin.isatty():
        try:
            return input(prompt), "send"
        except EOFError:
            return None, "eof"
    import select, termios
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    new = termios.tcgetattr(fd)
    new[3] &= ~(termios.ICANON | termios.ECHO)             # lflag: no line-buffer/echo (ISIG stays)
    new[0] &= ~(termios.ICRNL | termios.INLCR | termios.IGNCR)  # keep CR (Enter) and NL (Ctrl+Enter) distinct
    new[6][termios.VMIN], new[6][termios.VTIME] = 1, 0
    buf, pos = [], 0
    hlen = _rl.get_current_history_length() if _rl else 0
    hidx, saved = hlen, ""
    crow = 0                                   # cursor's row offset from the line's start row

    def redraw():
        # Wrapping-aware: the prompt+buffer may span several terminal rows. Go up to the
        # block's start, clear to end of screen, rewrite, then reposition the cursor —
        # otherwise a line past the screen width cascades one copy per keystroke.
        nonlocal crow
        w = max(1, shutil.get_terminal_size((80, 24)).columns)
        plen = _vlen(prompt)
        if crow:
            sys.stdout.write(f"\033[{crow}A")
        sys.stdout.write("\r\033[J" + prompt + "".join(buf))
        total = plen + len(buf)
        endrow = (total - 1) // w if total else 0
        if pos == len(buf):                    # cursor already at the natural end
            crow = endrow
        else:                                  # editing mid-line: move back to `pos`
            tgt = plen + pos
            trow, tcol = divmod(tgt, w)
            sys.stdout.write("\r")             # col 0 of the bottom row (clears pending wrap)
            if endrow - trow > 0:
                sys.stdout.write(f"\033[{endrow - trow}A")
            if tcol:
                sys.stdout.write(f"\033[{tcol}C")
            crow = trow
        sys.stdout.flush()

    def load(item):
        nonlocal buf, pos
        buf, pos = list(item), len(item); redraw()

    try:
        termios.tcsetattr(fd, termios.TCSANOW, new)
        redraw()
        while True:
            ch = os.read(fd, 1)
            if ch == b"\r":
                sys.stdout.write("\r\n"); return "".join(buf), "send"
            if ch == b"\n":
                sys.stdout.write("\r\n"); return "".join(buf), "pick"
            if ch == b"\x04":                          # Ctrl-D
                if not buf:
                    sys.stdout.write("\r\n"); return None, "eof"
            elif ch in (b"\x7f", b"\x08"):             # backspace
                if pos > 0:
                    del buf[pos - 1]; pos -= 1; redraw()
            elif ch == b"\x01":                        # Ctrl-A home
                pos = 0; redraw()
            elif ch == b"\x05":                        # Ctrl-E end
                pos = len(buf); redraw()
            elif ch == b"\x15":                        # Ctrl-U kill to start
                del buf[:pos]; pos = 0; redraw()
            elif ch == b"\x0b":                        # Ctrl-K kill to end
                del buf[pos:]; redraw()
            elif ch == b"\x1b":                        # escape sequences
                if select.select([fd], [], [], 0.05)[0]:
                    seq = os.read(fd, 2)
                    if seq == b"[A" and _rl and hidx > 0:
                        if hidx == hlen:
                            saved = "".join(buf)
                        hidx -= 1; load(_rl.get_history_item(hidx + 1) or "")
                    elif seq == b"[B" and _rl and hidx < hlen:
                        hidx += 1; load(saved if hidx == hlen else (_rl.get_history_item(hidx + 1) or ""))
                    elif seq == b"[C" and pos < len(buf):
                        pos += 1; redraw()
                    elif seq == b"[D" and pos > 0:
                        pos -= 1; redraw()
                    elif seq in (b"[H", b"OH"):
                        pos = 0; redraw()
                    elif seq in (b"[F", b"OF"):
                        pos = len(buf); redraw()
            elif ch >= b"\x20":                        # printable (+ utf-8 continuation)
                b0 = ch[0]
                extra = 0 if b0 < 0x80 else (1 if b0 < 0xE0 else (2 if b0 < 0xF0 else 3))
                if extra:
                    ch += os.read(fd, extra)
                try:
                    for cc in ch.decode():
                        buf.insert(pos, cc); pos += 1
                    redraw()
                except Exception:
                    pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def code_blocks(text):
    blocks, cur, in_code = [], [], False
    for line in (text or "").split("\n"):
        if line.lstrip().startswith("```"):
            if in_code:
                blocks.append("\n".join(cur)); cur, in_code = [], False
            else:
                in_code = True
        elif in_code:
            cur.append(line)
    if in_code and cur:
        blocks.append("\n".join(cur))
    return blocks


def _fmt_args(s):
    try:
        return json.dumps(json.loads(s or "{}"), separators=(",", ":"))
    except Exception:
        return s or "{}"


# Appended to the MODEL's copy of a display="full" result (not shown to the user) so it
# doesn't reproduce output the user already sees verbatim.
_SHOWN_NOTE = ("\n\n[This output has already been displayed to the user verbatim. Do NOT "
               "repeat, re-list, reformat, or summarize it. End your turn without further "
               "text unless you have something genuinely new to add, then keep it to one "
               "short sentence.]")


def _print_full_result(out, cap=200):
    """Print a tool result verbatim (for display='full' tools like list_files), under a
    dim gutter so it reads as tool output; capped so a huge dir can't flood the screen."""
    lines = out.splitlines()
    for ln in lines[:cap]:
        print(f"{DIM}│{RESET} {ln}")
    if len(lines) > cap:
        print(f"{DIM}  … {len(lines) - cap} more lines{RESET}")


def _fmt_result(out):
    """Compact one-line view of a tool result (the model still gets the full text).
    Small results show inline (whitespace flattened); large ones collapse to a peek + a
    size summary, so a big `ls`/`cat` doesn't dump a wall of dim text that reads like
    stuck thinking."""
    out = (out or "").strip()
    if not out:
        return "(no output)"
    flat = " ".join(out.split())
    if len(flat) <= 120:
        return flat
    n = len(out.splitlines())
    return f"{flat[:80]}… · {n} line{'' if n == 1 else 's'}, {len(out)} chars"


def _turn(history, thinks, user, stats, model=None, base=None):
    base_len = len(history)                       # roll back the whole turn on abort/error
    history.append({"role": "user", "content": user})
    stats.turns += 1
    recalled = mem_recall(user)                    # ambient memory for this turn (best-effort)
    if recalled:
        n = sum(1 for l in recalled.splitlines() if l.startswith("- "))
        print(f"{DIM}⟐ memory: {n} recalled{RESET}")
    final_text = ""
    try:
        tools = active_tools()
        for _ in range(MAX_TOOL_ROUNDS):
            text, tcs, usage = stream(history, thinks, model=model, base=base,
                                      tools=tools, volatile=recalled)
            stats.record(usage["prompt"], usage["completion"], usage["rate"])
            final_text = text or final_text
            msg = {"role": "assistant", "content": text}
            if tcs:
                msg["tool_calls"] = tcs
            history.append(msg)
            if not tcs:                            # plain answer → turn is done
                break
            for tc in tcs:                         # run each call, feed results back
                fn = tc.get("function") or {}
                print(f"{DIM}⚙ {fn.get('name')}({_fmt_args(fn.get('arguments'))}){RESET}")
                out = execute_tool(tc)             # gates per the tool's confirm policy
                tool = TOOLS.get(fn.get("name"))
                full = bool(out) and getattr(tool, "display", "compact") == "full"
                if full:
                    _print_full_result(out)        # e.g. list_files: show the whole ls -l
                else:
                    print(f"{DIM}  → {_fmt_result(out)}{RESET}")
                # model gets the full text either way; for full-display tools, tell it the
                # user already saw it so it doesn't re-list the same content back
                history.append({"role": "tool", "tool_call_id": tc["id"],
                                "content": out + _SHOWN_NOTE if full else out})
        else:
            print(f"{DIM}(stopped after {MAX_TOOL_ROUNDS} tool rounds){RESET}")
        mem_store(user, final_text)                # normal completion → persist the exchange
    except KeyboardInterrupt:
        print(f"{RESET}\n(interrupted)"); del history[base_len:]
    except Exception as e:
        print(f"[error: {e}]"); del history[base_len:]


