def _tool_run_command(args):
    cmd = ((args or {}).get("command") or "").strip()
    if not cmd:
        return "Error: no command given"
    timeout = (args or {}).get("timeout")
    try:
        p = subprocess.run(cmd, shell=True, executable=SHELL, capture_output=True,
                           text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return f"Command timed out after {timeout}s"
    except Exception as e:
        return f"Failed to run: {e}"
    out = ((p.stdout or "") + (p.stderr or "")).strip() or "(no output)"
    if len(out) > 4000:
        out = out[:4000] + f"\n… (truncated; {len(out)} chars total)"
    return f"exit={p.returncode}\n{out}"


