def mem_connect():
    """Connect MemoryOS if enabled+reachable; cache the profile. Returns a status string."""
    global _MEM, _MEM_PROFILE
    _MEM, _MEM_PROFILE, cfg = None, "", mem_config()
    if not cfg["enabled"]:
