                if PERM_MODE == "plan":
                    BUILD_ID = ""
            elif arg:
                print(f"{DIM}mode ∈ {{{', '.join(MODES)}}} — or Shift+Tab to cycle{RESET}"); continue
            print(f"{DIM}▸ {PERM_MODE} — {_mode_hint(PERM_MODE)}   (Shift+Tab cycles){RESET}")
            continue
        if user == "/gate" or user.startswith("/gate "):
            arg = user[len("/gate"):].strip()
            st = load_settings(); g = dict(st.get("gate") or {})
            inter = str(g.get("interactive", "low")).lower()
            auto = str(g.get("autonomous", "low")).lower()
            _lv = "none · low · medium · high · critical"
            if not arg:
                print(f"{DIM}gate — highest risk that AUTO-RUNS (the catastrophic denylist always blocks){RESET}")
                print(f"{DIM}  interactive: ≤ {CODE_FG}{inter}{RESET}{DIM}   (above → you confirm){RESET}")
                print(f"{DIM}  autonomous:  ≤ {CODE_FG}{auto}{RESET}{DIM}   (above → job blocks for /jobs answer){RESET}")
                print(f"{DIM}  set: /gate <level> (both) · /gate interactive <level> · /gate auto <level>   [{_lv}]{RESET}")
            else:
                p = arg.split()
                w0 = p[0].lower()
                if len(p) == 1 and w0 in _RISK_RANK:                 # /gate <level> → both
                    g["interactive"] = g["autonomous"] = w0
                    st["gate"] = g; save_settings(st)
                    print(f"{DIM}gate: interactive & autonomous → ≤ {w0}{RESET}")
                elif len(p) == 2 and w0 in ("interactive", "live", "auto", "autonomous", "jobs", "dark") \
                        and p[1].lower() in _RISK_RANK:
                    which = "interactive" if w0 in ("interactive", "live") else "autonomous"
                    g[which] = p[1].lower(); st["gate"] = g; save_settings(st)
                    print(f"{DIM}gate: {which} → ≤ {p[1].lower()}{RESET}")
                else:
                    print(f"{DIM}usage: /gate <level> · /gate interactive|auto <level>   [{_lv}]{RESET}")
            continue
