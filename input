# --- session stats + status line ------------------------------------------------
_CTX_CACHE = {}   # (model, base) -> context window (max_model_len) or None


def context_window(model, base):
    """Best-effort context window from the seat's /v1/models (vLLM max_model_len)."""
    key = (model, base)
    if key not in _CTX_CACHE:
        w = None
        try:
            d = json.load(urllib.request.urlopen(f"{base}/models", timeout=1.5))
            match = next((m for m in d.get("data", []) if m.get("id") == model), None)
            w = (match or (d.get("data") or [{}])[0]).get("max_model_len")
        except Exception:
            pass
        _CTX_CACHE[key] = w
    return _CTX_CACHE[key]


class Stats:
    """Cumulative per-session usage. record() is called once per streamed response
    (so tool-loop rounds all count); ctx tracks the latest request's footprint."""
    def __init__(self):
        self.t0 = time.monotonic()
        self.turns = self.in_tot = self.out_tot = self.ctx = 0
        self.rate = 0.0

    def record(self, prompt, completion, rate):
        self.in_tot += prompt or 0
        self.out_tot += completion or 0
        if prompt:
            self.ctx = prompt + (completion or 0)   # ~ next request's input; last round wins
        if rate:
            self.rate = rate


def _h(n):
    n = int(n or 0)
    if n >= 1_000_000:
        return f"{n / 1e6:.1f}M"
    if n >= 1000:
        return f"{n / 1000:.1f}k"
    return str(n)


def _status_line(stats):
    el = time.monotonic() - stats.t0
    dur = (f"{int(el // 3600)}h{int(el % 3600 // 60):02d}m" if el >= 3600
           else f"{int(el // 60)}m{int(el % 60):02d}s" if el >= 60 else f"{int(el)}s")
    win = context_window(MODEL, BASE)
    ctx = f"ctx {_h(stats.ctx)}" + (f"/{_h(win)} ({100 * stats.ctx / win:.0f}%)" if win else "")
    parts = [f"↓{_h(stats.in_tot)} ↑{_h(stats.out_tot)}"]
    if stats.rate:
        parts.append(f"{stats.rate:.0f} tok/s")
    parts += [ctx, f"{stats.turns}t", dur]
    return f"{DIM}" + "  ·  ".join(parts) + RESET


def stream(messages, think_store, model=None, base=None, tools=None, volatile=None,
           system=None, quiet=False, session=None):
    """Stream one assistant response. Returns (text, tool_calls, usage) — tool_calls is the
    OpenAI-shaped list (possibly empty) accumulated from the stream's deltas. `volatile`
    is per-turn context (e.g. recalled memory) placed after the cache breakpoint.
    `system` overrides the rendered system prompt (threads with their own cwd/brief);
    `quiet` suppresses all terminal output (background threads, sub-agents, jobs)."""
    model, base = model or MODEL, base or BASE
    if system is not None:
        content = system
    else:
        sm = chat_system()                    # user template (date/location tokens), fresh
        content = sm["content"] if sm else ""
    if _MEM_PROFILE:                          # stable → part of the cached prefix
        content = (content + "\n\n" if content else "") + "User profile: " + _MEM_PROFILE
    if volatile:                              # per-turn → after the sentinel (cache-safe)
        content = (content + "\n" + volatile if SAINT_SENTINEL in content
                   else (content + "\n" if content else "") + SAINT_SENTINEL + "\n" + volatile)
    if SAINT_SENTINEL in content and not _is_saint(base):
        content = content.replace(SAINT_SENTINEL, "").strip()   # direct seat: inline, drop marker
    msgs = ([{"role": "system", "content": content}] if content else []) + messages
    payload = {"model": model, "messages": msgs, "max_tokens": 8192, "stream": True,
               "stream_options": {"include_usage": True}}   # final chunk carries token usage
    if tools:
        payload["tools"] = tools
    body = json.dumps(payload).encode()
    headers = {"Content-Type": "application/json"}
    if session or SESSION:
        headers["x-session-id"] = session or SESSION
    req = urllib.request.Request(f"{base}/chat/completions", body, headers)
    reply, think_buf, phase, t0, tool_acc = [], [], "start", None, {}
    usage, t_first = None, None
    md = MDRender()
    import select as _sel
    interactive = (not quiet) and sys.stdin.isatty() and sys.stdout.isatty()
    fd, old_tty = sys.stdin.fileno(), None
    try:
        if interactive:
            import termios, tty
            old_tty = termios.tcgetattr(fd)
            tty.setcbreak(fd)   # poll stdin for Esc without echo; keeps output CR + SIGINT
        with urllib.request.urlopen(req, timeout=600) as r:
            saint_b = r.headers.get("x-saint-backend")  # only SAINT sets x-saint-*
            dom, cx = r.headers.get("x-saint-domain", ""), r.headers.get("x-saint-complexity", "")
            cls, state = r.headers.get("x-saint-classifier", ""), r.headers.get("x-saint-state", "")
            global _SAINT_RETRAIN, _SAINT_RETRAIN_NOTED
            _SAINT_RETRAIN = r.headers.get("x-saint-retrain") or None
            if _SAINT_RETRAIN and not _SAINT_RETRAIN_NOTED and not quiet:
                print(f"{YEL}⚠ saint: {_SAINT_RETRAIN}{RESET}")
                _SAINT_RETRAIN_NOTED = True
            _meta = []
            if dom:
                _meta.append(f"class: {dom}/{cx}")
            if cls:
                _meta.append(f"classifier: {cls}")
            if state:
                _meta.append(f"state: {state}")
            paren = f" ({', '.join(_meta)})" if _meta else ""
            banner_done = not saint_b
            for raw in r:
                if interactive and _sel.select([fd], [], [], 0)[0]:
                    ch = os.read(fd, 1)
                    if ch == b"\x1b":                        # Esc: bare = abort, seq = ignore
                        if _sel.select([fd], [], [], 0.02)[0]:
                            os.read(fd, 2)                   # drain arrow/escape sequence
                        else:
                            raise KeyboardInterrupt          # bare Esc aborts the generation
                line = raw.decode().strip()
                if not line.startswith("data: ") or line == "data: [DONE]":
                    continue
                chunk = json.loads(line[6:])
                if chunk.get("usage"):         # usage may ride a choices-bearing chunk (local
                    usage = chunk["usage"]     # seats do this) or a dedicated tail chunk (cloud)
                if not chunk.get("choices"):   # usage-only tail chunk (include_usage)
                    continue
                if not banner_done:  # first chunk carries the actually-served model name
                    served = chunk.get("model", "")
                    seat = f"{saint_b}/{served}" if served and served != saint_b else saint_b
                    if not quiet:
                        print(f"{DIM}--saint router → {seat}{paren}{RESET}")
                    banner_done = True
                delta = chunk["choices"][0].get("delta") or {}
                if t_first is None and (delta.get("reasoning_content") or delta.get("reasoning")
                                        or delta.get("content") or delta.get("tool_calls")):
                    t_first = time.monotonic()   # first output token → decode-rate clock start
                rc = delta.get("reasoning_content") or delta.get("reasoning")
                if rc:
                    if phase != "thinking":
                        if not quiet:
                            sys.stdout.write(f"{DIM}[think] ")
                        phase, t0 = "thinking", time.monotonic()
                    if not quiet:
                        sys.stdout.write(rc); sys.stdout.flush()
                    think_buf.append(rc)
                c = delta.get("content")
                if c:
                    if phase == "thinking" and not quiet:
                        _collapse_think(think_buf, t0)
                    phase = "content"
                    reply.append(c)
                    if not quiet:
                        md.feed(c)
                for tc in delta.get("tool_calls") or []:   # deltas: id/name once, args in pieces
                    acc = tool_acc.setdefault(tc.get("index", 0),
                                              {"id": None, "name": "", "arguments": ""})
                    if tc.get("id"):
                        acc["id"] = tc["id"]
                    fnd = tc.get("function") or {}
                    if fnd.get("name"):
                        acc["name"] += fnd["name"]
                    if fnd.get("arguments"):
                        acc["arguments"] += fnd["arguments"]
    finally:
        if old_tty is not None:
            import termios
            termios.tcsetattr(fd, termios.TCSADRAIN, old_tty)
    if phase == "thinking" and not quiet:   # round ended in thinking (e.g. →tool_call): collapse
        _collapse_think(think_buf, t0)
    if not quiet:
        md.finalize()
        sys.stdout.write(RESET)
        print()
    if think_buf and think_store is not None:
        think_store.append("".join(think_buf))
    tool_calls = [
        {"id": a["id"] or f"call_{i}", "type": "function",
         "function": {"name": a["name"], "arguments": a["arguments"] or "{}"}}
        for i, a in sorted(tool_acc.items())
    ]
    prompt = usage.get("prompt_tokens") if usage else None
    completion = usage.get("completion_tokens") if usage else None
    if prompt is None:      # seat didn't report usage — rough char/4 estimates
        prompt = sum(len(str(m.get("content") or "")) for m in msgs) // 4
    if completion is None:
        completion = max(1, len("".join(reply)) // 4)
    rate = completion / (time.monotonic() - t_first) if t_first and completion else 0.0
    return "".join(reply), tool_calls, {"prompt": prompt, "completion": completion, "rate": rate}


def _pick(labels, start, hint=None, allow_edit=False):
    """Selector; returns (index, make_default) or None — or (index, "edit") when allow_edit
    and Tab is pressed (hand the choice back to the command line). Falls back to numbers off-TTY.

    enter → use for the session; ctrl+enter (terminals that send LF) or 'd' → also
    persist as the launch default; q / bare-Esc → cancel. `hint` overrides the help line
    (e.g. for pickers where 'set default' doesn't apply).
    """
    if not sys.stdin.isatty():
        for i, lab in enumerate(labels, 1):
            print(f" {i}. {lab}")
        try:
            s = input("switch to (number, or Nd for default, blank=keep): ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            return None
        mk = s.endswith("d"); s = s[:-1] if mk else s
        return (int(s) - 1, mk) if s.isdigit() and 1 <= int(s) <= len(labels) else None

    import select, termios, tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    sel = start
    print(f"{DIM}{hint or '↑/↓ or j/k · enter use · ctrl+enter or d set default · q cancel'}{RESET}")

    def draw(first=False):
        if not first:
            sys.stdout.write(f"\033[{len(labels)}A")
        for i, lab in enumerate(labels):
            cur = f"{BOLD}❯ " if i == sel else "  "
            sys.stdout.write(f"\r\033[K{cur}{lab}{RESET}\r\n")
        sys.stdout.flush()

    try:
        tty.setraw(fd)                       # raw ONCE for the whole selection
        draw(first=True)
        while True:
            ch = os.read(fd, 1)              # read the fd directly, not buffered stdin
            if ch == b"\r":                  # Enter → session only
                return (sel, False)
            if ch in (b"\n", b"d", b"D"):    # Ctrl+Enter (LF) or 'd' → set as default
                return (sel, True)
            if ch == b"\t" and allow_edit:   # Tab → hand this choice back to the command line
                return (sel, "edit")
            if ch in (b"q", b"\x03"):        # q / Ctrl-C
                return None
            if ch == b"\x1b":                # ESC: arrow burst (ESC [ A/B) or bare ESC
                if select.select([fd], [], [], 0.05)[0]:
                    seq = os.read(fd, 2)
                    if seq == b"[A":
                        sel = (sel - 1) % len(labels); draw()
                    elif seq == b"[B":
                        sel = (sel + 1) % len(labels); draw()
                else:
                    return None              # bare ESC cancels
            elif ch == b"k":
                sel = (sel - 1) % len(labels); draw()
            elif ch == b"j":
                sel = (sel + 1) % len(labels); draw()
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def _seat_status(n):
    """Per-seat state: SAINT's reported state (ready|loading|absent) when known, else a
    live probe of the base (the static-fallback path)."""
    st = SEAT_META.get(n, {}).get("state")
    if st:
        return "up" if st == "ready" else st
    m, b = SEATS.get(n, (None, None))
    return "up" if (b and seat_alive(b)) else "down"


def _seat_extra(n):
    """Dim context + cost suffix for a seat label, from SAINT's map."""
    meta = SEAT_META.get(n, {})
    ctx = meta.get("context")
    bits = []
    if ctx:
        bits.append(f"{ctx // 1000}k ctx")
    # One comparable unit for every seat: $/Mtok output. Local = electricity (FREE of API
    # charge but real power); cloud = the output price. Same axis → easy visual comparison.
    if meta.get("kind") == "local":
        elec = meta.get("elec_per_mtok")
        bits.append(f"FREE · ~${elec:.2f}/Mtok" if elec else "FREE")
    elif meta.get("price_out") is not None:
        bits.append(f"${meta['price_out']:.2f}/Mtok")
    return f"  {DIM}· {' · '.join(bits)}{RESET}" if bits else ""


def _seat_label(n, default, width=12):
    st = _seat_status(n)
    status = "up" if st == "up" else f"{DIM}{st}{RESET}"
    star = f"{YEL}★{RESET}" if n == default else " "
    return f"{star} {n:<{width}} {SEATS[n][0]}  [{status}]{_seat_extra(n)}"


def models_menu():
