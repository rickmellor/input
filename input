    "entries. Path defaults to the current directory; ~ is allowed.",
    {"type": "object",
     "properties": {
         "path": {"type": "string", "description": "Directory to list; defaults to the cwd"}},
     "required": []},
    _tool_list_files,
    display="full"))     # a listing is meant to be shown, not summarized


def _html_to_text(html):
    import html as _h
    html = re.sub(r"(?is)<(script|style|head|nav|footer|aside)\b[^>]*>.*?</\1>", " ", html)
    html = re.sub(r"(?s)<[^>]+>", " ", html)
    return re.sub(r"\n\s*\n+", "\n\n", re.sub(r"[ \t]+", " ", _h.unescape(html))).strip()


def _tool_web_search(args):
    key = load_settings().get("brave_api_key")
    if not key:
        return "Error: no Brave API key configured (set brave_api_key in settings.json)"
    q = ((args or {}).get("query") or "").strip()
    if not q:
        return "Error: no query"
    count = max(1, min(int((args or {}).get("count") or 5), 10))
    url = "https://api.search.brave.com/res/v1/web/search?" + urllib.parse.urlencode(
        {"q": q, "count": count})
    req = urllib.request.Request(url, headers={"X-Subscription-Token": key,
                                               "Accept": "application/json"})
    try:
        d = json.load(urllib.request.urlopen(req, timeout=15))
    except Exception as e:
        return f"Search failed: {e}"
    results = (d.get("web") or {}).get("results") or []
    if not results:
        return "No results."
    out = []
    for i, r in enumerate(results[:count], 1):
        desc = re.sub(r"<[^>]+>", "", r.get("description", ""))   # Brave marks up matches
        out.append(f"{i}. {r.get('title','')}\n   {r.get('url','')}\n   {desc}")
    return "\n".join(out)


def _tool_web_fetch(args):
    url = ((args or {}).get("url") or "").strip()
    if not url:
        return "Error: no url"
    if not url.startswith(("http://", "https://")):
        url = "https://" + url
    req = urllib.request.Request(url, headers={"User-Agent": "input/2.1 (+local)"})
    try:
        raw = urllib.request.urlopen(req, timeout=20).read()
    except Exception as e:
        return f"Fetch failed: {e}"
    text = _html_to_text(raw.decode("utf-8", "replace"))
    if len(text) > 6000:
        text = text[:6000] + f"\n… (truncated; {len(text)} chars total)"
    return text or "(no readable text extracted)"


