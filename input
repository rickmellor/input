                    print(f"{DIM}rename cancelled (no title){RESET}"); continue
                r = megaplan_call("update", id=nid, title=ntitle)
                err = isinstance(r, dict) and "error" in r
                print(f"{DIM}{'megaplan: ' + r['error'] if err else 'renamed ' + nid + ' → ' + ntitle + ' (id unchanged)'}{RESET}")
            elif sub == "new":
                if not rest:
                    print(f"{DIM}usage: /plan new <goal>{RESET}"); continue
                _start_plan(rest)
            else:
                _start_plan(arg)                          # bare "/plan <free text>" → new plan
            continue
        if user == "/clear":
            history.clear(); thinks.clear()
            PERM_MODE, PLAN_GOAL, PLAN_ID, BUILD_ID = "cautious", "", "", ""
            SESSION = "input-" + os.urandom(6).hex()   # fresh conversation → fresh affinity
            print("(history cleared)"); continue
