def _command_hint_lines(buf):
    """Dim help for the slash command staged in the entry field (Ctrl+R peek): the specific
    command's flags if recognised, else a compact index of the commands."""
    text = "".join(buf).lstrip()
    cmd = (text.split() or [""])[0].lower()
    if cmd in _CMD_HINTS:
        return [f"{DIM}  {cmd}  {_CMD_HINTS[cmd]}{RESET}"]
    return [f"{DIM}  commands:{RESET}",
            f"{DIM}  /help  /new  /clear  /build  /jobs  /gate  /megaplan  /goal  /sidebar  /skill  /context  /cd  "
            f"/mcp  /tools  /models  /mode  /seats  /memory  /quit{RESET}"]


