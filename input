    "chmod", "ln", "sh -c", "bash -c",
)


_SHELL_OPS = {"|", "||", "&&", ";", "&", "<", "<<", "<<<", ">", ">>", "|&", "&>", ">&"}


def _shell_op_in(argv):
    """First unquoted shell operator / substitution in argv, else None. The sandbox runs
    without a shell, so these are passed as LITERAL args — a pipe/redirect then 'succeeds'
    with the wrong result, a heredoc opens a file named '<<'. Catch it and say so."""
    for t in argv:
        if t in _SHELL_OPS or re.fullmatch(r"\d*(<{1,3}|>{1,2})&?\d*", t):
            return t
        if "$(" in t:
            return "$(…)"
        if "`" in t:
            return "`…`"
    return None


class Sandbox:
    """Bounded execution surface for one spawned thread (port of aco's Sandbox). `bash`
    runs WITHOUT a shell, argv-split, only if the argv prefix matches the allowlist, and
    never if it matches the catastrophic denylist; read/write/edit are confined to `root`.
    `unsafe_shell=True` is the explicit opt-out (full shell; denylist still applies)."""

    def __init__(self, root=None, allow=None, unsafe_shell=False, timeout_s=120, max_output=20000):
        self.root = os.path.realpath(root or os.getcwd())
        self.allow = list(allow if allow is not None else SANDBOX_READONLY)
        self.unsafe_shell, self.timeout_s, self.max_output = bool(unsafe_shell), timeout_s, max_output

    def _allowed(self, argv):
        for entry in self.allow:
            pre = entry.split()
            if argv[:len(pre)] == pre:
                return True
        return False

    def _clip(self, text):
        return text if len(text) <= self.max_output else text[:self.max_output] + "\n…[output truncated]"

    def _resolve(self, path):
        p = path if os.path.isabs(path) else os.path.join(self.root, path)
        p = os.path.realpath(p)
        return p if (p == self.root or p.startswith(self.root + os.sep)) else None

    def bash(self, command, cwd=None):
        command = (command or "").strip()
        if not command:
            return "exit=-1\n(bash refused: empty command)"
        if danger(command):
            return "exit=-1\n(bash refused: matches the catastrophic denylist)"
        workdir = self._resolve(cwd) if cwd else self.root
        if workdir is None:
            return "exit=-1\n(bash refused: cwd escapes the sandbox root)"
        if self.unsafe_shell:
            return self._spawn(command, workdir, True)
        try:
            argv = shlex.split(command)
        except ValueError as e:
            return f"exit=-1\n(bash refused: unparsable command: {e})"
        op = _shell_op_in(argv)
        if op:
            return (f"exit=-1\n(bash refused: no shell here — the operator {op!r} is NOT "
                    "interpreted; it would be passed as a literal argument (a pipe/redirect "
                    "'succeeds' with the wrong result, a heredoc opens a file named '<<'). "
                    "Run ONE simple command per call: for inline code use a single invocation "
                    "like  python3 -c '…'  (not a heredoc), write to files with the write/edit "
                    "tools, and split pipelines across separate bash calls. To use real shell "
                    "syntax, wrap it explicitly:  bash -c '…'  (needs write access).)")
        if not argv or not self._allowed(argv):
            return ("exit=-1\n(bash refused: not on the sandbox allowlist)\n"
                    f"requested: {command}\nallowed prefixes include: {', '.join(self.allow[:10])} …\n"
                    "Report what you would have run and why; do not claim you ran it.")
        return self._spawn(argv, workdir, False)

    def _spawn(self, cmd, workdir, shell):
        try:
            p = subprocess.run(cmd, shell=shell, cwd=workdir, capture_output=True, text=True,
                               timeout=self.timeout_s, executable=SHELL if shell else None)
            out = ((p.stdout or "") + (p.stderr or "")).strip() or "(no output)"
            return f"exit={p.returncode}\n{self._clip(out)}"
        except subprocess.TimeoutExpired:
            return f"exit=-1\n(bash timed out after {self.timeout_s}s)"
        except FileNotFoundError:
            return "exit=-1\n(bash error: command not found)"
        except Exception as e:
            return f"exit=-1\n(bash error: {e})"

    def read(self, path):
        p = self._resolve(path)
        if p is None:
            return "(read refused: path escapes the sandbox root)"
        if not os.path.isfile(p):
            return f"(read error: not a file: {path})"
        try:
            return self._clip(open(p, encoding="utf-8", errors="replace").read())
        except Exception as e:
            return f"(read error: {e})"

    def write(self, path, content):
        p = self._resolve(path)
        if p is None:
            return "(write refused: path escapes the sandbox root)"
        try:
            os.makedirs(os.path.dirname(p), exist_ok=True)
            open(p, "w", encoding="utf-8").write(content or "")
            return f"wrote {len(content or '')} chars to {os.path.relpath(p, self.root)}"
        except Exception as e:
            return f"(write error: {e})"

    def edit(self, path, old, new, replace_all=False):
        p = self._resolve(path)
        if p is None:
            return "(edit refused: path escapes the sandbox root)"
        try:
            s = open(p, encoding="utf-8").read()
        except Exception as e:
            return f"(edit error: {e})"
        n = s.count(old or "")
        if not old or n == 0:
            return "(edit error: old_string not found — read the file and match exactly)"
        if n > 1 and not replace_all:
            return f"(edit error: old_string matches {n} places; pass replace_all or a longer unique string)"
        s = s.replace(old, new) if replace_all else s.replace(old, new, 1)
        open(p, "w", encoding="utf-8").write(s)
        return f"edited {os.path.relpath(p, self.root)} ({n if replace_all else 1} replacement)"

    def ls(self, path="."):
        p = self._resolve(path or ".")
        if p is None:
            return "(ls refused: path escapes the sandbox root)"
        try:
            return "\n".join(sorted(os.listdir(p))) or "(empty)"
        except Exception as e:
            return f"(ls error: {e})"


def sandbox_tools(sb, write=True):
    """Thread-local Tool objects bound to a Sandbox (NOT registered globally). The sandbox
    is the gate, so confirm='never'. write=False → read-only surface."""
    ts = [
        Tool("bash", "Run a command (no shell; allowlisted argv) inside the sandbox root. "
             "Returns exit code + combined output.",
             {"type": "object", "properties": {"command": {"type": "string"},
                                               "cwd": {"type": "string", "description": "subdir of the sandbox root"}},
              "required": ["command"]},
             lambda a: sb.bash(a.get("command", ""), a.get("cwd"))),
        Tool("read_file", "Read a file inside the sandbox root.",
             {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]},
             lambda a: sb.read(a.get("path", ""))),
        Tool("list_dir", "List a directory inside the sandbox root.",
             {"type": "object", "properties": {"path": {"type": "string"}}, "required": []},
             lambda a: sb.ls(a.get("path", "."))),
    ]
    if write:
        ts += [
            Tool("write_file", "Create or overwrite a file inside the sandbox root.",
                 {"type": "object", "properties": {"path": {"type": "string"}, "content": {"type": "string"}},
                  "required": ["path", "content"]},
                 lambda a: sb.write(a.get("path", ""), a.get("content", ""))),
            Tool("edit_file", "Replace an exact string in a file (must match once unless replace_all).",
                 {"type": "object", "properties": {"path": {"type": "string"}, "old_string": {"type": "string"},
                                                   "new_string": {"type": "string"}, "replace_all": {"type": "boolean"}},
                  "required": ["path", "old_string", "new_string"]},
                 lambda a: sb.edit(a.get("path", ""), a.get("old_string", ""), a.get("new_string", ""),
                                   bool(a.get("replace_all")))),
        ]
    return ts


def run_thread(task, *, history=None, system=None, model=None, base=None, tools=None,
               max_rounds=MAX_TOOL_ROUNDS, quiet=True, stats=None, thinks=None, volatile=None,
               terminate=None, budget_tokens=None, on_tool=None, session=None, gate=True):
    """Run one agent thread. `task` is appended as the user message to `history` (a list,
    mutated in place; new list if None). `tools` = list of Tool objects (thread-local).
    `system` overrides the system prompt (e.g. system_prompt(cwd) + a brief). `terminate`
    = fn(text, res) -> (done, nudge): called when the model stops calling tools; if not done
    the nudge is sent as the next user message (goal-directed loops). `budget_tokens` caps
    total tokens. Returns a dict: text, history, rounds, tool_calls, tokens_in/out, stopped
    ∈ done|rounds|budget|error, error. Raises KeyboardInterrupt (after rolling back)."""
    messages = history if history is not None else []
    base_len = len(messages)
    messages.append({"role": "user", "content": task})
    toolmap = {t.name: t for t in (tools or [])}
    schemas = [t.schema() for t in toolmap.values()] or None
    res = {"text": "", "history": messages, "rounds": 0, "tool_calls": 0,
           "tokens_in": 0, "tokens_out": 0, "decode_s": 0.0, "stopped": "done", "error": None}
    try:
        for _ in range(max_rounds):
            text, tcs, usage = stream(messages, thinks, model=model, base=base, tools=schemas,
                                      volatile=volatile, system=system, quiet=quiet, session=session)
            res["rounds"] += 1
            res["tokens_in"] += usage["prompt"] or 0; res["tokens_out"] += usage["completion"] or 0
            if usage.get("rate"):          # decode seconds = completion / decode-rate (excl. prefill/TTFT)
                res["decode_s"] += (usage["completion"] or 0) / usage["rate"]
            if stats is not None:
                stats.record(usage["prompt"], usage["completion"], usage["rate"])
            res["text"] = text or res["text"]
            msg = {"role": "assistant", "content": text}
            if tcs:
                msg["tool_calls"] = tcs
                if not (text or "").strip():
                    msg["content"] = None      # tool-call-only turn: send null, not "" — the
                                               # OpenAI-valid shape, so the Anthropic relay
                                               # doesn't pad an empty block with a visible
                                               # "[System: Empty message content sanitised]" line
            messages.append(msg)
            if budget_tokens and res["tokens_in"] + res["tokens_out"] > budget_tokens:
                res["stopped"] = "budget"; break
            if not tcs:                            # plain answer → done, unless the goal says otherwise
                if terminate is not None:
                    done, nudge = terminate(text, res)
                    if not done and nudge:
                        messages.append({"role": "user", "content": nudge}); continue
                break
            # Resolve confirmation gates first, on this thread — prompts can't run
            # concurrently. Then run the calls: one → inline (live output); several → a
            # thread pool, each call's output buffered and flushed in submit (== tcs) order
            # so parallel agents don't interleave. Per-MODEL limits live in spawn_agent.
            # FUTURE: an "observe" affordance to tail one parallel agent's live output (its
            # buffer is already isolated per-thread — surface it on demand instead of only
            # flushing at completion).
            decided = []
            for tc in tcs:
                fn = tc.get("function") or {}
                name = fn.get("name")
                try:
                    args = json.loads(fn.get("arguments") or "{}")
                except Exception:
                    args = {}
                tool = toolmap.get(name)
                allow, reason = True, None
                if tool is None:
                    allow, reason = False, f"Error: no such tool {name!r}"
                elif gate and not quiet and getattr(tool, "confirm", "never") != "never":
                    cmd = args.get("command") if isinstance(args, dict) else None
                    if not _gate(tool.confirm, cmd):
                        allow, reason = False, "Declined by the user; not run."
                decided.append((tc, name, args, tool, allow, reason))
            res["tool_calls"] += len(decided)

            def _run_one(item, buffered, states=None, idx=None):
                tc, name, args, tool, allow, reason = item
                if states is not None:
                    states[idx] = "running"
                buf = io.StringIO()
                if buffered and _STDOUT is not None:
                    _STDOUT.capture(buf)
                try:
                    if on_tool:
                        on_tool("call", tc, None)
                    if not allow:
                        out = reason
                    else:
                        try:
                            out = str(tool.run(args))
                        except Exception as e:
                            out = f"Error running {name}: {e}"
                    shown = on_tool("result", tc, out) if on_tool else None
                finally:
                    if buffered and _STDOUT is not None:
                        _STDOUT.release()
                    if states is not None:
                        states[idx] = "done"
                return tc, out, shown, buf.getvalue()

            if len(decided) <= 1:
                results = [_run_one(it, False) for it in decided]
            else:
                buffered = not quiet
                labels = [_call_label(nm, ar) for (tc, nm, ar, tool, allow, reason) in decided]
                states = ["pending"] * len(decided)
                # A live spinner naming the in-flight agents runs while their output is
                # buffered, so the UI shows what it's waiting on instead of dead air.
                live = buffered and _STDOUT is not None and sys.stdout.isatty()
                stop_ticker = threading.Event()
                ticker = None
                if live:
                    ticker = threading.Thread(target=_agents_ticker,
                                              args=(labels, states, stop_ticker), daemon=True)
                    ticker.start()
                try:
                    with concurrent.futures.ThreadPoolExecutor(max_workers=min(16, len(decided))) as ex:
                        futs = [ex.submit(_run_one, it, buffered, states, i)
                                for i, it in enumerate(decided)]
                        results = [f.result() for f in futs]   # submit order == tcs order
                finally:
                    if ticker is not None:
                        stop_ticker.set(); ticker.join(timeout=1.0)   # ticker self-clears its block

            for tc, out, shown, printed in results:
                if printed:
                    sys.stdout.write(printed); sys.stdout.flush()
                _note_saved(tc, out)
                messages.append({"role": "tool", "tool_call_id": tc["id"],
                                 "content": shown if shown is not None else out})
        else:
            res["stopped"] = "rounds"
    except KeyboardInterrupt:
        del messages[base_len:]; raise
    except Exception as e:
        del messages[base_len:]
        res["stopped"], res["error"] = "error", f"{type(e).__name__}: {e}"
    return res


# --- jobs: detached, goal-directed background work with a filesystem process table -------
# A job is a run_thread running in a DETACHED process (`input --job <id>`, start_new_session
# so it survives input exiting), writing its state to ~/.config/input/jobs/<id>/. The
# filesystem IS the shared process table — any input session reads meta.json for status /
# metrics and log.jsonl for progress; kill = signal the recorded pid; a hard block parks the
# job (state=blocked + need + saved history) and `/jobs answer` relaunches it to resume.
_JOBS_DIR = os.path.expanduser("~/.config/input/jobs")
_JOB_HANG_S = 180          # no tool activity this long while 'running' → flagged as maybe-hung
_JOB_MAX_ROUNDS = 80


def _job_dir(jid):
    return os.path.join(_JOBS_DIR, jid)


def _read_meta(jid):
    try:
        return json.load(open(os.path.join(_job_dir(jid), "meta.json")))
    except Exception:
        return None


def _write_meta(jid, **patch):
    d = _read_meta(jid) or {}
    d.update(patch); d["updated"] = time.time()
    os.makedirs(_job_dir(jid), exist_ok=True)
    p = os.path.join(_job_dir(jid), "meta.json")
    with open(p + ".tmp", "w") as f:
        json.dump(d, f, indent=2)
    os.replace(p + ".tmp", p)
    return d


def list_jobs(include_done=True):
    if not os.path.isdir(_JOBS_DIR):
        return []
    js = [m for m in (_read_meta(j) for j in os.listdir(_JOBS_DIR)) if m]
    if not include_done:
        js = [m for m in js if m.get("state") in ("queued", "running", "blocked")]
    return sorted(js, key=lambda m: m.get("created", 0))


def _pid_alive(pid):
    try:
        os.kill(int(pid), 0); return True
    except Exception:
        return False


def job_state(m):
    """Live state with hang/dead detection layered over the recorded state."""
    st = m.get("state")
    if st == "running":
        if m.get("pid") and not _pid_alive(m["pid"]):
            return "dead"                      # process gone but never wrote a terminal state
        if time.time() - (m.get("last_activity") or m.get("started") or 0) > _JOB_HANG_S:
            return "stalled"
    return st


def submit_job(kind, title, goal, cwd=None, model=None, plan_id=None):
    """Create a job dir + spec and launch the detached runner. Returns the job id."""
    jid = datetime.now().strftime("%H%M%S") + "-" + os.urandom(2).hex()
    os.makedirs(_job_dir(jid), exist_ok=True)
    _write_meta(jid, id=jid, kind=kind, title=title[:80], goal=goal, cwd=os.path.abspath(cwd or os.getcwd()),
                model=model or "saint", plan_id=plan_id, state="queued", created=time.time(),
                tokens_in=0, tokens_out=0, tool_calls=0, rounds=0, last_activity=time.time())
    out = open(os.path.join(_job_dir(jid), "runner.out"), "a")
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "--job", jid],
                     stdout=out, stderr=out, stdin=subprocess.DEVNULL, start_new_session=True)
    return jid


def _job_progress(m):
    """(done, total, pct) for a build job from the live MegaPlan plan, else (None,None,None)."""
    if m.get("kind") == "build" and m.get("plan_id"):
        r = megaplan_call("get", id=m["plan_id"])
        pr = (r or {}).get("progress") if isinstance(r, dict) else None
        if pr:
            return pr.get("done"), pr.get("total"), pr.get("pct")
    return None, None, None


def run_job(jid):
    """The detached runner (entry: `input --job <id>`). Runs the goal-directed thread,
    streaming metrics/log to the job dir; parks on block, saves result on done."""
    m = _read_meta(jid)
    if not m:
        return 2
    logp = os.path.join(_job_dir(jid), "log.jsonl")
    hp = os.path.join(_job_dir(jid), "history.json")

    def logline(kind, **kw):
        with open(logp, "a") as f:
            f.write(json.dumps({"t": time.time(), "kind": kind, **kw}) + "\n")

    load_user_tools(); load_mcp_tools(); apply_tools_state(); discover_skills(m["cwd"])
    sb = Sandbox(root=m["cwd"], allow=SANDBOX_DEV)
    tools = [t for t in TOOLS.values() if t.enabled] + sandbox_tools(sb, write=True)
    if m.get("kind") == "build" and m.get("plan_id"):
        system = stable_context() + "\n\n" + _BUILD_DIRECTIVE + f"\n\nBuilding MegaPlan: {m['plan_id']}"
        goal = f"Every task of MegaPlan {m['plan_id']} is marked complete (plan status done)."
        task = (f"Build MegaPlan '{m['plan_id']}'. Fetch it (megaplan get), then work its tasks to "
                "completion one at a time, marking each complete; when all are done you are finished.")
    else:
        system, goal, task = stable_context(), m["goal"], m["goal"]
    history = []
    if os.path.exists(hp):
        try:
            history = json.load(open(hp))
        except Exception:
            history = []
    # model: explicit pin from submit > (classify goal) hard→reasoning_seat, else saint-auto.
    # build jobs are inherently multi-step reasoning → always the capable seat.
    pin = m.get("model") if m.get("model") not in (None, "", "saint") else None
    seat = pin or (reasoning_seat() if m.get("kind") == "build" else agentic_seat(goal))
    mo, bo = _resolve_seat(seat) or SEATS.get("saint") or (MODEL, BASE)
    _write_meta(jid, state="running", started=m.get("started") or time.time(),
                pid=os.getpid(), last_activity=time.time())
    logline("start", goal=goal, model=mo)

    def on_tool(ev, tc, out):
        fn = tc.get("function") or {}
        if ev == "call":
            logline("tool_call", name=fn.get("name"), args=(fn.get("arguments") or "")[:400])
        else:
            logline("tool_result", name=fn.get("name"), out=(out or "")[:400])
            cur = _read_meta(jid) or {}
            _write_meta(jid, last_activity=time.time(), tool_calls=(cur.get("tool_calls") or 0) + 1)
        return None

    sysfull = system + "\n\n" + _GOAL_DIRECTIVE.format(goal=goal)
    res = run_thread(task, history=history, system=sysfull, model=mo, base=bo, tools=tools,
                     quiet=True, on_tool=on_tool, gate=False, terminate=goal_terminate(goal, 24),
                     max_rounds=_JOB_MAX_ROUNDS, session="job-" + jid)
    _write_meta(jid, tokens_in=res["tokens_in"], tokens_out=res["tokens_out"], rounds=res["rounds"])
    if res.get("blocked"):
        json.dump(res["history"], open(hp, "w"))
        _write_meta(jid, state="blocked", need=res["blocked"])
        logline("blocked", need=res["blocked"])
    elif res["error"]:
        _write_meta(jid, state="failed", error=res["error"], ended=time.time())
        logline("failed", error=res["error"])
    else:
        rp = os.path.join(_job_dir(jid), "result.md")
        open(rp, "w").write(res["text"] or "")
        _write_meta(jid, state="done", ended=time.time(), result_path=rp,
                    goal_met=bool(res.get("goal_met")), stopped=res["stopped"])
        logline("done", stopped=res["stopped"])
    return 0


def resume_job(jid, answer):
    """Append the user's answer to a blocked job's saved history and relaunch it."""
    m = _read_meta(jid)
    if not m or m.get("state") != "blocked":
        return False
    hp = os.path.join(_job_dir(jid), "history.json")
    try:
        hist = json.load(open(hp))
    except Exception:
        hist = []
    hist.append({"role": "user", "content": f"(Answer to your BLOCKED need — {m.get('need')!r}): {answer}"})
    json.dump(hist, open(hp, "w"))
    _write_meta(jid, state="queued", need=None)
    out = open(os.path.join(_job_dir(jid), "runner.out"), "a")
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "--job", jid],
                     stdout=out, stderr=out, stdin=subprocess.DEVNULL, start_new_session=True)
    return True


def _fmt_dur(s):
    s = int(s or 0)
    return f"{s}s" if s < 60 else f"{s // 60}m{s % 60:02d}s" if s < 3600 else f"{s // 3600}h{(s % 3600) // 60:02d}m"


_JOBS_SEEN = {}   # jid -> last state we notified about (for the prompt-time notifier)


def poll_jobs_notify():
    """Print a one-line notice when a background job newly finishes / blocks / fails."""
    for m in list_jobs():
        jid, st = m["id"], job_state(m)
        if _JOBS_SEEN.get(jid) == st:
            continue
        prev = _JOBS_SEEN.get(jid)
        _JOBS_SEEN[jid] = st
        if prev is None:                       # first sight (e.g. pre-existing) — don't shout
            continue
        if st == "blocked":
            notify_blocked(f"job {jid} · {m.get('title','')}", m.get("need", "?"))
        elif st == "done":
            gm = " ✔goal met" if m.get("goal_met") else ""
            print(f"\n{GREEN_BUILD}{BOLD}● job {jid} done{RESET}{DIM}{gm} — {m.get('title','')}  (/jobs show {jid}){RESET}")
        elif st in ("failed", "dead"):
            print(f"\n{RED_VIVID}● job {jid} {st}{RESET}{DIM} — {m.get('title','')}  (/jobs show {jid}){RESET}")


def _turn(history, thinks, user, stats, model=None, base=None):
    """One interactive REPL turn = run_thread with printing, memory recall/store, gating."""
    stats.turns += 1
    recalled = mem_recall(user)                    # ambient memory for this turn (best-effort)
    if recalled:
        n = sum(1 for l in recalled.splitlines() if l.startswith("- "))
        print(f"{DIM}⟐ memory: {n} recalled{RESET}")

    def on_tool(ev, tc, out):
        fn = tc.get("function") or {}
        if ev == "call":
            print(f"{DIM}⚙ {fn.get('name')}({_fmt_args(fn.get('arguments'))}){RESET}"); return None
        tool = TOOLS.get(fn.get("name"))
        full = bool(out) and getattr(tool, "display", "compact") == "full"
        if full:
            _print_full_result(out)                # e.g. list_files: show the whole ls -l
        else:
            print(f"{DIM}  → {_fmt_result(out)}{RESET}")
        # model gets the full text either way; for full-display tools, tell it the user
        # already saw it so it doesn't re-list the same content back
        return out + _SHOWN_NOTE if full else out

    global GOAL_BLOCKED
    if GOAL_BLOCKED:                               # the user's message answers the block → resume
        user = f"(Answer to your BLOCKED need — {GOAL_BLOCKED!r}): {user}"
        GOAL_BLOCKED = ""
    tools = [t for t in TOOLS.values() if t.enabled] if TOOLS_ON else None
    terminate = goal_terminate(GOAL, GOAL_MAX_NUDGES) if GOAL else None
    if GOAL and GOAL_SEAT and GOAL_SEAT in SEATS and (model, base) == (None, None):
        model, base = SEATS[GOAL_SEAT]         # hard goal → pin the loop to the capable seat
    try:
        res = run_thread(user, history=history, tools=tools, model=model, base=base, quiet=False,
                         stats=stats, thinks=thinks, volatile=recalled, on_tool=on_tool, gate=True,
                         terminate=terminate)
    except KeyboardInterrupt:
        print(f"{RESET}\n(interrupted)"); return
    if res["stopped"] == "rounds":
        print(f"{DIM}(stopped after {MAX_TOOL_ROUNDS} tool rounds){RESET}")
    if res.get("blocked"):
        notify_blocked("session goal", res["blocked"])
    elif res.get("goal_met"):
        print(f"{GREEN_BUILD}{BOLD}✔ GOAL MET{RESET}{DIM} — {GOAL[:80]}  (/goal off to clear){RESET}")
    elif res.get("goal_paused"):
        print(f"{DIM}(goal not met after {GOAL_MAX_NUDGES} continues — pausing; say 'continue' to push on, /goal off to drop it){RESET}")
    if res["error"]:
        print(f"[error: {res['error']}]")
    else:
        mem_store(user, res["text"])               # normal completion → persist the exchange


def repl():
    global SESSION, TOOLS_ON, PERM_MODE, PLAN_GOAL, PLAN_ID, BUILD_ID, GOAL, GOAL_SEAT, GOAL_BLOCKED
    _st = load_settings()
    TOOLS_ON = _st.get("tools", True)
    load_user_tools()
    load_mcp_tools()                                  # MCP server tools (disabled by default)
    apply_tools_state()                               # restore per-tool on/off from settings
    discover_skills()                                 # skills index (bodies load on trigger)
    history, thinks = [], []
    stats = Stats()

    def _enter_build(pid, kickoff=True):          # load a plan and drop into BUILD mode
        global PERM_MODE, PLAN_GOAL, PLAN_ID, BUILD_ID
        p = megaplan_call("get", id=pid)
        if isinstance(p, dict) and "error" in p:
            print(f"{DIM}megaplan: {p['error']}{RESET}"); return False
        if PERM_MODE == "plan":                   # leave authoring; keep gating otherwise
            PERM_MODE = "cautious"
        PLAN_GOAL, PLAN_ID, BUILD_ID = "", pid, pid
        plan_render(p)
        print(f"{DIM}● BUILD mode — executing {pid}   ({PERM_MODE}; Shift+Tab to change · "
              f"/build off to stop){RESET}")
        if kickoff:
            seed = (f"Build MegaPlan '{pid}'. Here is the plan:\n\n{p.get('body', '')}\n\n"
                    f"Start with the first actionable task (dependencies satisfied): do the work, "
                    f"then mark it complete via megaplan. Proceed.")
            _turn(history, thinks, seed, stats)
            print(_status_line(stats))
        return True

    def _offer_build():                           # after a save, offer the one-key handoff
        pid = _take_saved()
        if not pid or BUILD_ID:                   # nothing saved, or already building
            return
        try:
            ans = input(f"{DIM}▸ build {pid} now? [y/N]: {RESET}").strip().lower()
        except (EOFError, KeyboardInterrupt):
            ans = ""
        if ans in ("y", "yes"):
            _enter_build(pid)

    SESSION = "input-" + os.urandom(6).hex()
    print(f"input → {MODEL} @ {BASE}  (enter send · ctrl+enter one-shot · ^R routing hint · Shift+Tab cycles mode · "
          f"/models /seats /system /skill /context /tools /mcp /memory /mode /goal /plan /build /jobs /sidebar /location /think /clear · exit/^D quits · Esc aborts · ^C copies code)")
    print(f"{DIM}▸ {PERM_MODE} — {_mode_hint(PERM_MODE)}   (Shift+Tab: {' → '.join(MODES)}){RESET}")
    print(f"{DIM}  Fn one-shot: " + " · ".join(
        f"{k.upper()}→{v}" for k, v in sorted(seat_hotkeys().items(), key=lambda kv: int(kv[0][1:])))
        + f"  ·  Ctrl+Enter picker{RESET}")
    mem_status = mem_connect()
    if mem_status:
        print(f"{DIM}{mem_status}{RESET}")
    for _m in list_jobs():                     # don't shout about pre-existing jobs on startup
        _JOBS_SEEN[_m["id"]] = job_state(_m)
    while True:
        poll_jobs_notify()                     # surface background jobs that finished / blocked
        print()  # blank line before each prompt
        try:
            user, mode = read_line(_prompt())
        except KeyboardInterrupt:
            # ^C on the prompt: copy the last reply's code blocks (terminals that copy a
            # mouse selection on ^C never deliver this — so selection-copy still wins).
            last = next((m["content"] for m in reversed(history)
                         if m["role"] == "assistant" and m.get("content")), "")
            blocks = code_blocks(last)
            if blocks and copy_clip("\n\n".join(blocks)):
                print(f"\n(copied {len(blocks)} code block{'s' * (len(blocks) != 1)})")
            elif blocks:
                print("\n(no clipboard tool found)")
            else:
                print("\n(no code blocks — ^D or /quit to exit)")
            continue
        if user is None:                       # Ctrl-D
            break
        user = user.strip()
        if user and _rl:                       # every submitted line joins input history
            _safe(lambda: _rl.add_history(user))
        if mode == "pick":                     # Ctrl+Enter → one-shot to a chosen seat
            if not user:
                continue
            seat = choose_seat()
            if not seat:
                print("(cancelled)"); continue
            m, b = SEATS[seat]
            _turn(history, thinks, user, stats, model=m, base=b)
            print(f"{DIM}(one-shot via {seat} · active seat still {MODEL}){RESET}")
            print(_status_line(stats))
            continue
        if mode.startswith("seat:"):           # Fn hotkey → one-shot to a bound seat
            fk = mode.split(":", 1)[1]
            seat = seat_hotkeys().get(fk)
            if not seat or seat not in SEATS:
                print(f"{DIM}{fk.upper()}: no seat bound — set settings seat_hotkeys{RESET}"); continue
            if not user:
                print(f"{DIM}{fk.upper()} → {seat}: type a message first, then press it{RESET}"); continue
            m, b = SEATS[seat]
            _turn(history, thinks, user, stats, model=m, base=b)
            print(f"{DIM}(one-shot via {seat} · active seat still {MODEL}){RESET}")
            print(_status_line(stats))
            continue
        if mode == "cycle":                    # Shift+Tab → next permission mode
            PERM_MODE = MODES[(MODES.index(PERM_MODE) + 1) % len(MODES)]
            if PERM_MODE == "plan":            # authoring ≠ building; leaving build
                BUILD_ID = ""
            print(f"{DIM}▸ {PERM_MODE} — {_mode_hint(PERM_MODE)}{RESET}")
            if user and _rl:                   # don't lose text typed before the toggle
                _safe(lambda: _rl.add_history(user))
                print(f"{DIM}  (your text is in history — ↑ to recover){RESET}")
            continue
        if not user:                           # blank line → just re-prompt (Ctrl-D / /quit to exit)
            continue
        if user in ("/quit", "exit"):
            break
        if user == "/sidebar" or user.startswith("/sidebar ") or user == "/aside" or user.startswith("/aside "):
            arg = user.split(None, 1)[1].strip() if " " in user else ""
            if arg in ("merge", "done", "close", "drop", "cancel"):
                if not SIDEBARS:
                    print(f"{DIM}not in a sidebar{RESET}"); continue
                sb = SIDEBARS[-1]
                if arg in ("drop", "cancel"):
                    SIDEBARS.pop(); history[:] = sb["parent"]
                    print(f"{DIM}sidebar '{sb['label']}' dropped — main thread restored (nothing merged){RESET}")
                else:
                    print(f"{DIM}⟲ folding sidebar '{sb['label']}' back into the main thread…{RESET}")
                    summary = sidebar_summarize(history, MODEL, BASE) or "(no conclusion captured)"
                    SIDEBARS.pop(); history[:] = sb["parent"]
                    history.append({"role": "user",
                                    "content": f"[Sidebar '{sb['label']}' concluded — carrying back:] {summary}"})
                    history.append({"role": "assistant", "content": f"Noted the sidebar's conclusion: {summary}"})
                    print(f"{DIM}  ↩ merged: {summary[:200]}{RESET}")
            elif arg:
                SIDEBARS.append({"parent": list(history), "plen": len(history), "label": arg[:60]})
                history.append({"role": "user",
                                "content": f"[Entering a SIDEBAR about: {arg}] The main task is paused. "
                                "Explore this side thread; when we finish I'll fold the conclusions back."})
                history.append({"role": "assistant", "content": f"In a sidebar on '{arg}'. What would you like to explore?"})
                print(f"{DIM}● sidebar — {arg}  (branch of the main thread; /sidebar merge to fold conclusions back, /sidebar drop to discard){RESET}")
            else:
                if SIDEBARS:
