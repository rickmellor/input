def print_help(arg: str = "") -> None:
    """`/help` prints the grouped capability list; `/help <command>` prints one command's help."""
    arg = (arg or "").strip()
    if arg:                                            # command-specific
        cmd = arg if arg.startswith("/") else "/" + arg
        topic = _HELP_TOPICS.get(cmd)
        if topic:                                      # the fuller explanation
            print(f"{CODE_FG}{BOLD}{cmd}{RESET}\n{DIM}{topic}{RESET}"); return
        if cmd in _CMD_HINTS:                          # else the terse flag line
            print(f"  {CODE_FG}{cmd}{RESET}  {DIM}{_CMD_HINTS[cmd]}{RESET}"); return
        for _sec, rows in _HELP:
            for c, d in rows:
                if c == cmd:
                    print(f"  {CODE_FG}{cmd}{RESET}  {DIM}{d}{RESET}"); return
        print(f"{DIM}no help for {cmd!r} — /help lists everything{RESET}"); return
    print(f"{BOLD}input — capabilities{RESET}")
    for title, rows in _HELP:
        print(f"\n{CODE_FG}{title}{RESET}")
        for c, d in rows:
            print(f"  {c:<12}{DIM}{d}{RESET}")
    print(f"\n{DIM}  keys: Esc abort · ^C copy code · ^D or /quit exit{RESET}")
    print(f"{DIM}  /help <command> for a fuller explanation of one command{RESET}")


