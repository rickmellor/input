                      f"  /plan show [id]           print a plan (picker if no id)\n"
                      f"  /plan save                persist the current plan now\n"
                      f"  /build [id]               execute a ready plan task-by-task (picker if no id)\n"
                      f"  /plan close               leave plan mode\n"
                      f"  /plan rename [id] [title] rename a plan (picker + prompt if omitted)\n"
                      f"  /plan remove [id]         archive a plan (picker if no id){RESET}")
