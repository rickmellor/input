                if isinstance(p, dict) and "error" in p:
                    print(f"{DIM}megaplan: {p['error']}{RESET}"); continue
                if rerun:                              # detached runner can't prompt — reopen now
                    ok, msg = _reopen_plan(pid)
                    print(f"{DIM}↻ {msg if ok else 'reopen failed: ' + msg}{RESET}")
                    if not ok:
                        continue
                elif p.get("status") == "done":
                    print(f"{DIM}note: {pid} is complete — add 'rerun' to reopen its tasks first{RESET}")
                jid = submit_job("build", f"build {pid}", "", cwd=os.getcwd(), plan_id=pid,
                                 model=(toks[1] if len(toks) > 1 else "saint"))
                _JOBS_SEEN[jid] = "queued"
                print(f"{DIM}● job {jid} — building {pid} in the background · /jobs show {jid}{RESET}")
            elif sub == "run" and rest:
                jid = submit_job("goal", rest[:60], rest, cwd=os.getcwd())
                _JOBS_SEEN[jid] = "queued"
                print(f"{DIM}● job {jid} — {rest[:50]} · /jobs show {jid}{RESET}")
            elif sub == "review" and rest:      # ACO adversarial review as a background job
                tgt = rest.split()[0]
                goal = (f"Use the aco_review tool to run an adversarial review of {tgt!r}, then "
                        "synthesize per the aco-review skill (accepted/refuted findings, verdict, "
