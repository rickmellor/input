        p = d.get("user_profile") if isinstance(d, dict) else None
        _MEM_PROFILE = p if p and p != "None" else ""
    except Exception:
        _MEM_PROFILE = ""
    return f"memory on · {cfg['user']} @ {cfg['url']}" + ("" if _MEM_PROFILE else " · no profile yet")


def _mem_item(x):
    return x if isinstance(x, str) else (x.get("content") or x.get("text") or json.dumps(x))


def mem_recall(query):
    """Best-effort compact context block of relevant memories for this turn, or ''."""
    if not _MEM:
        return ""
    try:
        d = json.loads(_MEM.call("retrieve_memory", {"user_id": mem_config()["user"], "query": query}))
    except Exception:
        return ""
    lines = []
    for e in (d.get("short_term_history") or [])[-4:]:
        u, a = e.get("user_input", ""), (e.get("agent_response") or "")[:200]
        if u or a:
            lines.append(f"- earlier you and the user discussed: {u!r} → {a!r}")
    for k in (d.get("retrieved_user_knowledge") or [])[:5]:
        lines.append(f"- about the user: {_mem_item(k)[:200]}")
    for k in (d.get("retrieved_assistant_knowledge") or [])[:3]:
        lines.append(f"- established: {_mem_item(k)[:200]}")
    for pg in (d.get("retrieved_pages") or [])[:2]:
        lines.append(f"- from a past session: {_mem_item(pg)[:200]}")
    if not lines:
        return ""
    return ("Relevant memory from earlier sessions (use if helpful; don't mention it unless "
            "asked):\n" + "\n".join(lines))


def mem_store(user_input, agent_response):
    """Best-effort persist of one exchange; never raises into the chat loop."""
    if not _MEM or not agent_response:
        return
    try:
        _MEM.call("add_memory", {"user_id": mem_config()["user"],
                                 "user_input": user_input, "agent_response": agent_response})
    except Exception:
        pass


def memory_browse(query):
    """Inspect MemoryOS contents: profile + recent history + knowledge + pages for a query."""
    if not _MEM:
        print(f"{DIM}memory off — /memory on to connect{RESET}")
        return
    cfg = mem_config()
    try:
