    b"[11~": "f1", b"[12~": "f2", b"[13~": "f3", b"[14~": "f4",
    b"[15~": "f5", b"[17~": "f6", b"[18~": "f7", b"[19~": "f8",
    b"[20~": "f9", b"[21~": "f10", b"[23~": "f11", b"[24~": "f12",
}


def _default_hotkeys():
    """Bind F7..F12 to the non-router seats in cost-ascending rank order (SAINT's rank)."""
    ranked = sorted((n for n in SEATS if SEAT_META.get(n, {}).get("kind") != "router"),
                    key=lambda n: SEAT_META.get(n, {}).get("rank", 0))
    keys = ["f7", "f8", "f9", "f10", "f11", "f12"]
    return {keys[i]: n for i, n in enumerate(ranked[:len(keys)])}


def seat_hotkeys():
    hk = _default_hotkeys()
    hk.update(load_settings().get("seat_hotkeys") or {})
    return {k.lower(): v for k, v in hk.items()}


def _seat_short(n):
    """Short label for a seat in the routing hint: cloud tiers show their alias
    (haiku/sonnet/opus/fable); local/router keep their friendly name (coder/chat/saint)."""
    meta = SEAT_META.get(n, {})
    if meta.get("kind") == "cloud":
        al = meta.get("aliases") or []
        return al[0] if al else n
    return n


def _route_hint_lines():
    """Two dim lines reminding you how to route the staged text (Ctrl+R peek)."""
    hk = sorted(seat_hotkeys().items(), key=lambda kv: int(kv[0][1:]))
    fn = "   ".join(f"{k.upper()} {_seat_short(v)}" for k, v in hk)
    return [f"{DIM}  ↵ send  ·  Ctrl+↵ seat picker  ·  Fn = one-shot this text to a seat:{RESET}",
            f"{DIM}  {fn}{RESET}"]


