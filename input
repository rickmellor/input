# --- agent engine: Sandbox + run_thread -------------------------------------------
# run_thread() is THE agent loop: send messages (+tools) → execute tool calls → loop until
# a plain answer (or the termination hook / round cap / token budget stops it). The
# interactive REPL turn (_turn), sub-agents, /goal, and background jobs all call it; they
# differ only in context (history/system/cwd), tools, termination, and whether output is
# printed. Spawned threads get a Sandbox instead of the human-gated run_command.

# Allowlisted argv prefixes (no shell → `;`, `&&`, `|`, `$()` are inert literals).
SANDBOX_READONLY = (
    "git status", "git log", "git diff", "git show", "git blame", "git rev-parse",
    "git ls-files", "git ls-tree", "git cat-file", "git merge-base", "git describe", "git shortlog",
    "ls", "cat", "head", "tail", "wc", "stat", "file", "tree", "du", "basename", "dirname",
    "realpath", "readlink", "grep", "rg", "diff", "cmp", "sort", "uniq", "cut", "tr", "nl", "find",
    "which", "env", "pwd", "date", "echo",
)
# + build/test/edit tooling for jobs and sub-agents that are allowed to change things.
SANDBOX_DEV = SANDBOX_READONLY + (
    "python3", "python", "pip", "pip3", "pytest", "uv", "npm", "npx", "node", "pnpm", "yarn",
    "make", "cargo", "go", "rustc", "gcc", "cc", "clang", "ruff", "black", "mypy", "tsc",
    "git add", "git commit", "git checkout", "git switch", "git branch", "git stash", "git restore",
    "git fetch", "git pull", "git push", "git rm", "git mv", "git init", "git tag",
