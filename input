def _fmt_result(out):
    """Compact one-line view of a tool result (the model still gets the full text).
    Small results show inline (whitespace flattened); large ones collapse to a peek + a
    size summary, so a big `ls`/`cat` doesn't dump a wall of dim text that reads like
    stuck thinking."""
    out = (out or "").strip()
    if not out:
        return "(no output)"
    flat = " ".join(out.split())
    if len(flat) <= 120:
        return flat
    n = len(out.splitlines())
    return f"{flat[:80]}… · {n} line{'' if n == 1 else 's'}, {len(out)} chars"


# --- agent engine: Sandbox + run_thread -------------------------------------------
# run_thread() is THE agent loop: send messages (+tools) → execute tool calls → loop until
# a plain answer (or the termination hook / round cap / token budget stops it). The
# interactive REPL turn (_turn), sub-agents, /goal, and background jobs all call it; they
# differ only in context (history/system/cwd), tools, termination, and whether output is
# printed. Spawned threads get a Sandbox instead of the human-gated run_command.

# Allowlisted argv prefixes (no shell → `;`, `&&`, `|`, `$()` are inert literals).
SANDBOX_READONLY = (
    "git status", "git log", "git diff", "git show", "git blame", "git rev-parse",
    "git ls-files", "git ls-tree", "git cat-file", "git merge-base", "git describe", "git shortlog",
    "ls", "cat", "head", "tail", "wc", "stat", "file", "tree", "du", "basename", "dirname",
    "realpath", "readlink", "grep", "rg", "diff", "cmp", "sort", "uniq", "cut", "tr", "nl", "find",
    "which", "env", "pwd", "date", "echo",
)
# + build/test/edit tooling for jobs and sub-agents that are allowed to change things.
SANDBOX_DEV = SANDBOX_READONLY + (
    "python3", "python", "pip", "pip3", "pytest", "uv", "npm", "npx", "node", "pnpm", "yarn",
    "make", "cargo", "go", "rustc", "gcc", "cc", "clang", "ruff", "black", "mypy", "tsc",
    "git add", "git commit", "git checkout", "git switch", "git branch", "git stash", "git restore",
    "git fetch", "git pull", "git push", "git rm", "git mv", "git init", "git tag",
    "mkdir", "cp", "mv", "touch", "rm", "rmdir", "sed", "awk", "tar", "gzip", "curl", "wget",
    "chmod", "ln", "sh -c", "bash -c",
)


_SHELL_OPS = {"|", "||", "&&", ";", "&", "<", "<<", "<<<", ">", ">>", "|&", "&>", ">&"}


def _shell_op_in(argv):
    """First unquoted shell operator / substitution in argv, else None. The sandbox runs
    without a shell, so these are passed as LITERAL args — a pipe/redirect then 'succeeds'
    with the wrong result, a heredoc opens a file named '<<'. Catch it and say so."""
    for t in argv:
        if t in _SHELL_OPS or re.fullmatch(r"\d*(<{1,3}|>{1,2})&?\d*", t):
            return t
        if "$(" in t:
            return "$(…)"
        if "`" in t:
            return "`…`"
    return None


class Sandbox:
    """Bounded execution surface for one spawned thread (port of aco's Sandbox). `bash`
    runs WITHOUT a shell, argv-split, only if the argv prefix matches the allowlist, and
    never if it matches the catastrophic denylist; read/write/edit are confined to `root`.
    `unsafe_shell=True` is the explicit opt-out (full shell; denylist still applies)."""

    def __init__(self, root=None, allow=None, unsafe_shell=False, timeout_s=120, max_output=20000):
        self.root = os.path.realpath(root or os.getcwd())
        self.allow = list(allow if allow is not None else SANDBOX_READONLY)
        self.unsafe_shell, self.timeout_s, self.max_output = bool(unsafe_shell), timeout_s, max_output

    def _allowed(self, argv):
        for entry in self.allow:
            pre = entry.split()
            if argv[:len(pre)] == pre:
                return True
        return False

    def _clip(self, text):
        return text if len(text) <= self.max_output else text[:self.max_output] + "\n…[output truncated]"

    def _resolve(self, path):
        p = path if os.path.isabs(path) else os.path.join(self.root, path)
        p = os.path.realpath(p)
        return p if (p == self.root or p.startswith(self.root + os.sep)) else None

    def bash(self, command, cwd=None):
        command = (command or "").strip()
        if not command:
            return "exit=-1\n(bash refused: empty command)"
        if danger(command):
            return "exit=-1\n(bash refused: matches the catastrophic denylist)"
        workdir = self._resolve(os.path.expanduser(cwd)) if cwd else self.root
        if workdir is None:
            return "exit=-1\n(bash refused: cwd escapes the sandbox root)"
        if self.unsafe_shell:
            return self._spawn(command, workdir, True)
        try:
            argv = shlex.split(command)
        except ValueError as e:
            return f"exit=-1\n(bash refused: unparsable command: {e})"
        argv = [os.path.expanduser(t) if t.startswith("~") else t for t in argv]   # no shell → expand ~ ourselves
        op = _shell_op_in(argv)
        if op:
            return (f"exit=-1\n(bash refused: no shell here — the operator {op!r} is NOT "
                    "interpreted; it would be passed as a literal argument (a pipe/redirect "
                    "'succeeds' with the wrong result, a heredoc opens a file named '<<'). "
                    "Run ONE simple command per call: for inline code use a single invocation "
                    "like  python3 -c '…'  (not a heredoc), write to files with the write/edit "
                    "tools, and split pipelines across separate bash calls. To use real shell "
                    "syntax, wrap it explicitly:  bash -c '…'  (needs write access).)")
        if not argv or not self._allowed(argv):
            return ("exit=-1\n(bash refused: not on the sandbox allowlist)\n"
                    f"requested: {command}\nallowed prefixes include: {', '.join(self.allow[:10])} …\n"
                    "Report what you would have run and why; do not claim you ran it.")
        return self._spawn(argv, workdir, False)

    def _spawn(self, cmd, workdir, shell):
        try:
            p = subprocess.run(cmd, shell=shell, cwd=workdir, capture_output=True, text=True,
                               timeout=self.timeout_s, executable=SHELL if shell else None)
            out = ((p.stdout or "") + (p.stderr or "")).strip() or "(no output)"
            return f"exit={p.returncode}\n{self._clip(out)}"
        except subprocess.TimeoutExpired:
            return f"exit=-1\n(bash timed out after {self.timeout_s}s)"
        except FileNotFoundError:
            return "exit=-1\n(bash error: command not found)"
        except Exception as e:
            return f"exit=-1\n(bash error: {e})"

    def read(self, path):
        p = self._resolve(path)
        if p is None:
            return "(read refused: path escapes the sandbox root)"
        if not os.path.isfile(p):
            return f"(read error: not a file: {path})"
        try:
            return self._clip(open(p, encoding="utf-8", errors="replace").read())
        except Exception as e:
            return f"(read error: {e})"

    def write(self, path, content):
        p = self._resolve(path)
        if p is None:
            return "(write refused: path escapes the sandbox root)"
        try:
            os.makedirs(os.path.dirname(p), exist_ok=True)
            open(p, "w", encoding="utf-8").write(content or "")
            return f"wrote {len(content or '')} chars to {os.path.relpath(p, self.root)}"
        except Exception as e:
            return f"(write error: {e})"

    def edit(self, path, old, new, replace_all=False):
        p = self._resolve(path)
        if p is None:
            return "(edit refused: path escapes the sandbox root)"
        try:
            s = open(p, encoding="utf-8").read()
        except Exception as e:
            return f"(edit error: {e})"
        n = s.count(old or "")
        if not old or n == 0:
            return "(edit error: old_string not found — read the file and match exactly)"
        if n > 1 and not replace_all:
            return f"(edit error: old_string matches {n} places; pass replace_all or a longer unique string)"
        s = s.replace(old, new) if replace_all else s.replace(old, new, 1)
        open(p, "w", encoding="utf-8").write(s)
        return f"edited {os.path.relpath(p, self.root)} ({n if replace_all else 1} replacement)"

    def ls(self, path="."):
        p = self._resolve(path or ".")
        if p is None:
            return "(ls refused: path escapes the sandbox root)"
        try:
            return "\n".join(sorted(os.listdir(p))) or "(empty)"
        except Exception as e:
            return f"(ls error: {e})"


def sandbox_tools(sb, write=True):
    """Thread-local Tool objects bound to a Sandbox (NOT registered globally). The sandbox
    is the gate, so confirm='never'. write=False → read-only surface."""
    ts = [
        Tool("bash", "Run a command (no shell; allowlisted argv) inside the sandbox root. "
             "Returns exit code + combined output.",
             {"type": "object", "properties": {"command": {"type": "string"},
                                               "cwd": {"type": "string", "description": "subdir of the sandbox root"}},
              "required": ["command"]},
             lambda a: sb.bash(a.get("command", ""), a.get("cwd"))),
        Tool("read_file", "Read a file inside the sandbox root.",
             {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]},
             lambda a: sb.read(a.get("path", ""))),
        Tool("list_dir", "List a directory inside the sandbox root.",
             {"type": "object", "properties": {"path": {"type": "string"}}, "required": []},
             lambda a: sb.ls(a.get("path", "."))),
    ]
    if write:
        ts += [
            Tool("write_file", "Create or overwrite a file inside the sandbox root.",
                 {"type": "object", "properties": {"path": {"type": "string"}, "content": {"type": "string"}},
                  "required": ["path", "content"]},
                 lambda a: sb.write(a.get("path", ""), a.get("content", ""))),
            Tool("edit_file", "Replace an exact string in a file (must match once unless replace_all).",
                 {"type": "object", "properties": {"path": {"type": "string"}, "old_string": {"type": "string"},
                                                   "new_string": {"type": "string"}, "replace_all": {"type": "boolean"}},
                  "required": ["path", "old_string", "new_string"]},
                 lambda a: sb.edit(a.get("path", ""), a.get("old_string", ""), a.get("new_string", ""),
                                   bool(a.get("replace_all")))),
        ]
    return ts


class _NeedsApproval(Exception):
    """Raised in a DARK (job) run when a command's risk exceeds the autonomous tolerance:
    the job parks for `/jobs answer` approval instead of prompting (no terminal) or running."""
    def __init__(self, cmd, risk, reason=""):
        super().__init__(cmd)
        self.cmd, self.risk, self.reason = cmd, risk, reason


def run_thread(task, *, history=None, system=None, model=None, base=None, tools=None,
               max_rounds=MAX_TOOL_ROUNDS, quiet=True, stats=None, thinks=None, volatile=None,
               terminate=None, budget_tokens=None, on_tool=None, session=None, gate=True, dark=None,
               finalize_on_cap=False):
    """Run one agent thread. `task` is appended as the user message to `history` (a list,
    mutated in place; new list if None). `tools` = list of Tool objects (thread-local).
    `system` overrides the system prompt (e.g. system_prompt(cwd) + a brief). `terminate`
    = fn(text, res) -> (done, nudge): called when the model stops calling tools; if not done
    the nudge is sent as the next user message (goal-directed loops). `budget_tokens` caps
    total tokens. Returns a dict: text, history, rounds, tool_calls, tokens_in/out, stopped
    ∈ done|rounds|budget|error, error. Raises KeyboardInterrupt (after rolling back)."""
    messages = history if history is not None else []
    base_len = len(messages)
    messages.append({"role": "user", "content": task})
    toolmap = {t.name: t for t in (tools or [])}
    schemas = [t.schema() for t in toolmap.values()] or None
    res = {"text": "", "history": messages, "rounds": 0, "tool_calls": 0,
           "tokens_in": 0, "tokens_out": 0, "decode_s": 0.0, "stopped": "done", "error": None}
    _last_fp, _repeat = None, 0      # stall detector: identical tool-call rounds back-to-back
    try:
        for _ in range(max_rounds):
            text, tcs, usage = stream(messages, thinks, model=model, base=base, tools=schemas,
                                      volatile=volatile, system=system, quiet=quiet, session=session)
            res["rounds"] += 1
            res["tokens_in"] += usage["prompt"] or 0; res["tokens_out"] += usage["completion"] or 0
            if usage.get("rate"):          # decode seconds = completion / decode-rate (excl. prefill/TTFT)
                res["decode_s"] += (usage["completion"] or 0) / usage["rate"]
            if stats is not None:
                stats.record(usage["prompt"], usage["completion"], usage["rate"])
            res["text"] = text or res["text"]
            msg = {"role": "assistant", "content": text}
            if tcs:
                fp = tuple(sorted(((tc.get("function") or {}).get("name", ""),
                                   (tc.get("function") or {}).get("arguments", "")) for tc in tcs))
                _repeat = _repeat + 1 if fp == _last_fp else 0
                _last_fp = fp
                if _repeat >= 3:         # 4 identical rounds in a row = the model is looping
                    res["stopped"] = "stalled"
                    break
                msg["tool_calls"] = tcs
                if not (text or "").strip():
                    msg["content"] = None      # tool-call-only turn: send null, not "" — the
                                               # OpenAI-valid shape, so the Anthropic relay
                                               # doesn't pad an empty block with a visible
                                               # "[System: Empty message content sanitised]" line
            messages.append(msg)
            if budget_tokens and res["tokens_in"] + res["tokens_out"] > budget_tokens:
                res["stopped"] = "budget"; break
            if not tcs:                            # plain answer → done, unless the goal says otherwise
                if terminate is not None:
                    done, nudge = terminate(text, res)
                    if not done and nudge:
                        messages.append({"role": "user", "content": nudge}); continue
                break
            # Resolve confirmation gates first, on this thread — prompts can't run
            # concurrently. Then run the calls: one → inline (live output); several → a
            # thread pool, each call's output buffered and flushed in submit (== tcs) order
            # so parallel agents don't interleave. Per-MODEL limits live in spawn_agent.
            # FUTURE: an "observe" affordance to tail one parallel agent's live output (its
            # buffer is already isolated per-thread — surface it on demand instead of only
            # flushing at completion).
            decided = []
            for tc in tcs:
                fn = tc.get("function") or {}
                name = fn.get("name")
                try:
                    args = json.loads(fn.get("arguments") or "{}")
                except Exception:
                    args = {}
                tool = toolmap.get(name)
                allow, reason = True, None
                if tool is None:
                    allow, reason = False, f"Error: no such tool {name!r}"
                elif gate and not quiet and getattr(tool, "confirm", "never") != "never":
                    cmd = args.get("command") if isinstance(args, dict) else None
                    if not _gate(tool.confirm, cmd):
                        allow, reason = False, "Declined by the user; not run."
                elif dark and getattr(tool, "confirm", "never") != "never":   # autonomous job gate
                    cmd = args.get("command") if isinstance(args, dict) else None
                    if cmd and cmd != dark.get("approved"):       # a pre-approved cmd runs once
                        v = review(cmd)
                        # FAIL-CLOSED when dark: an unrateable command (rater down) parks for
                        # approval rather than auto-running — the denylist floor still hard-blocks.
                        if not v or _over_tolerance(v[0], dark.get("tol", "low")):
                            raise _NeedsApproval(cmd, v[0] if v else "unrated",
                                                 v[1] if v else "risk could not be rated (rater unavailable)")
                decided.append((tc, name, args, tool, allow, reason))
            res["tool_calls"] += len(decided)

            def _run_one(item, buffered, agents=None, idx=None):
                tc, name, args, tool, allow, reason = item
                slot = agents[idx] if agents is not None else None
                if slot is not None:
                    # spawn_agent starts QUEUED and flips to "running" when it clears its model
                    # semaphore; every other tool runs immediately, so mark it running now.
                    if name == "spawn_agent" and allow:
                        slot["state"] = "queued"
                    else:
                        slot["state"] = "running"; slot["start"] = time.monotonic()
                _AGENT_TLS.slot = slot          # spawn_agent reports 'running' via this on acquire
                buf = io.StringIO()
                if buffered and _STDOUT is not None:
                    _STDOUT.capture(buf)
                try:
                    if on_tool:
                        on_tool("call", tc, None)
                    if not allow:
                        out = reason
                    else:
                        try:
                            out = str(tool.run(args))
                        except Exception as e:
                            out = f"Error running {name}: {e}"
                    shown = on_tool("result", tc, out) if on_tool else None
                finally:
                    _AGENT_TLS.slot = None
                    if buffered and _STDOUT is not None:
                        _STDOUT.release()
                    if slot is not None:
                        slot["state"] = "done"
                        slot["dur"] = time.monotonic() - (slot["start"] or time.monotonic())
                return tc, out, shown, buf.getvalue()

            if len(decided) <= 1:
                results = [_run_one(it, False) for it in decided]
            else:
                buffered = not quiet
                agents = [{"label": _call_label(nm, ar), "state": "pending", "start": None, "dur": None}
                          for (tc, nm, ar, tool, allow, reason) in decided]
                # A live spinner naming the in-flight agents (with a running elapsed clock) shows
                # what the UI is waiting on while their output is buffered, instead of dead air.
                live = buffered and _STDOUT is not None and sys.stdout.isatty()
                stop_ticker = threading.Event()
                ticker = None
                if live:
                    ticker = threading.Thread(target=_agents_ticker,
                                              args=(agents, stop_ticker), daemon=True)
                    ticker.start()
                try:
                    with concurrent.futures.ThreadPoolExecutor(max_workers=min(16, len(decided))) as ex:
                        futs = [ex.submit(_run_one, it, buffered, agents, i)
                                for i, it in enumerate(decided)]
                        results = [f.result() for f in futs]   # submit order == tcs order
                finally:
                    if ticker is not None:
                        stop_ticker.set(); ticker.join(timeout=1.0)   # ticker self-clears its block

            for tc, out, shown, printed in results:
                if printed:
                    sys.stdout.write(printed); sys.stdout.flush()
                _note_saved(tc, out)
                messages.append({"role": "tool", "tool_call_id": tc["id"],
                                 "content": shown if shown is not None else out})
        else:
            res["stopped"] = "rounds"
        if res["stopped"] in ("rounds", "stalled") and finalize_on_cap and not (res["text"] or "").strip():
            # one last NO-TOOLS turn so a capped agent still hands back what it learned
            messages.append({"role": "user", "content":
                "Your tool budget is exhausted (or you were looping). Do not call tools. Write your final deliverable NOW "
                "from everything gathered so far: findings, evidence, what remains unknown."})
            try:
                ftext, _ftcs, fusage = stream(messages, thinks, model=model, base=base, tools=None,
                                              volatile=volatile, system=system, quiet=quiet, session=session)
                if ftext:
                    res["text"] = ftext
                    messages.append({"role": "assistant", "content": ftext})
                    if isinstance(fusage, dict):
                        res["tokens_in"] += int(fusage.get("prompt") or 0)
                        res["tokens_out"] += int(fusage.get("completion") or 0)
            except Exception as e:  # finalize is best-effort
                res["text"] = res["text"] or f"(finalize failed: {type(e).__name__}: {e})"
    except KeyboardInterrupt:
        del messages[base_len:]; raise
    except _NeedsApproval as na:                    # dark run hit an over-tolerance command
        if messages and messages[-1].get("role") == "assistant":
            messages.pop()                         # drop the un-run tool-call turn → clean resume
        res["stopped"] = "approval"
        res["needs_approval"] = {"cmd": na.cmd, "risk": na.risk, "reason": na.reason}
    except Exception as e:
        del messages[base_len:]
        res["stopped"], res["error"] = "error", f"{type(e).__name__}: {e}"
    return res


# --- jobs: detached, goal-directed background work with a filesystem process table -------
# A job is a run_thread running in a DETACHED process (`input --job <id>`, start_new_session
# so it survives input exiting), writing its state to ~/.config/input/jobs/<id>/. The
# filesystem IS the shared process table — any input session reads meta.json for status /
# metrics and log.jsonl for progress; kill = signal the recorded pid; a hard block parks the
# job (state=blocked + need + saved history) and `/jobs answer` relaunches it to resume.
_JOBS_DIR = os.path.expanduser("~/.config/input/jobs")
_JOB_HANG_S = 180          # idle this long BETWEEN tool calls while 'running' → maybe-hung
_JOB_TOOL_HANG_S = 1800     # a single tool call in flight this long (30m) → maybe-hung. Higher
                           # because tools like aco_review legitimately run for many minutes.
_JOB_MAX_ROUNDS = 400   # jobs have hang/idle detection; rounds are a runaway backstop, not a budget


def _job_dir(jid):
    return os.path.join(_JOBS_DIR, jid)


def _read_meta(jid):
    try:
        return json.load(open(os.path.join(_job_dir(jid), "meta.json")))
    except Exception:
        return None


_META_LOCK = threading.Lock()   # serialize meta writes: parallel tool dispatch fires on_tool
                                # from several threads, which raced on the shared meta.json.tmp


def _write_meta(jid, **patch):
    with _META_LOCK:                       # read-modify-write + tmp-rename must be atomic
        d = _read_meta(jid) or {}
        d.update(patch)
        d["id"] = jid                      # always stamp id + created so a meta can never end up
        d.setdefault("created", time.time())   # id-less even if the base was missing/corrupt
        d["updated"] = time.time()
        os.makedirs(_job_dir(jid), exist_ok=True)
        p = os.path.join(_job_dir(jid), "meta.json")
        tmp = p + f".tmp.{os.getpid()}.{threading.get_ident()}"   # unique tmp per writer too
        with open(tmp, "w") as f:
            json.dump(d, f, indent=2)
        os.replace(tmp, p)
        return d


def list_jobs(include_done=True):
    if not os.path.isdir(_JOBS_DIR):
        return []
    js = []
    for j in os.listdir(_JOBS_DIR):
        m = _read_meta(j)
        if not m:
            continue
        m.setdefault("id", j)          # backfill from the dir/file for partial/corrupt metas so
        if not m.get("created"):       # no downstream field access can crash the whole REPL
            try:
                m["created"] = os.path.getmtime(os.path.join(_JOBS_DIR, j, "meta.json"))
            except Exception:
                m["created"] = 0.0
        m.setdefault("state", "failed")
        js.append(m)
    if not include_done:
        js = [m for m in js if m.get("state") in ("queued", "running", "blocked")]
    return sorted(js, key=lambda m: m.get("created", 0))


def _pid_alive(pid):
    try:
        os.kill(int(pid), 0); return True
    except Exception:
        return False


def job_state(m):
    """Live state with hang/dead detection layered over the recorded state."""
    st = m.get("state")
    if st == "running":
        if m.get("pid") and not _pid_alive(m["pid"]):
            return "dead"                      # process gone but never wrote a terminal state
        if m.get("active_count", 0) > 0 or m.get("active_tool"):   # ≥1 tool in flight = WORKING
            if time.time() - (m.get("active_since") or 0) > _JOB_TOOL_HANG_S:
                return "stalled"               # …unless a call has run absurdly long (30m)
            return "running"
        if time.time() - (m.get("last_activity") or m.get("started") or 0) > _JOB_HANG_S:
            return "stalled"
    return st


def submit_job(kind, title, goal, cwd=None, model=None, plan_id=None):
    """Create a job dir + spec and launch the detached runner. Returns the job id."""
    jid = datetime.now().strftime("%H%M%S") + "-" + os.urandom(2).hex()
    os.makedirs(_job_dir(jid), exist_ok=True)
    _write_meta(jid, id=jid, kind=kind, title=title[:80], goal=goal, cwd=os.path.abspath(cwd or os.getcwd()),
                model=model or "saint", plan_id=plan_id, state="queued", created=time.time(),
                tokens_in=0, tokens_out=0, tool_calls=0, rounds=0, last_activity=time.time())
    out = open(os.path.join(_job_dir(jid), "runner.out"), "a")
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "--job", jid],
                     stdout=out, stderr=out, stdin=subprocess.DEVNULL, start_new_session=True)
    return jid


def _job_progress(m):
    """(done, total, pct) for a build job from the live MegaPlan plan, else (None,None,None)."""
    if m.get("kind") == "build" and m.get("plan_id"):
        r = megaplan_call("get", id=m["plan_id"])
        pr = (r or {}).get("progress") if isinstance(r, dict) else None
        if pr:
            return pr.get("done"), pr.get("total"), pr.get("pct")
    return None, None, None


def run_job(jid):
    """The detached runner (entry: `input --job <id>`). Runs the goal-directed thread,
    streaming metrics/log to the job dir; parks on block, saves result on done."""
    m = _read_meta(jid)
    if not m:
        return 2
    logp = os.path.join(_job_dir(jid), "log.jsonl")
    hp = os.path.join(_job_dir(jid), "history.json")

    def logline(kind, **kw):
        with open(logp, "a") as f:
            f.write(json.dumps({"t": time.time(), "kind": kind, **kw}) + "\n")

    load_user_tools(); load_mcp_tools(); apply_tools_state(); discover_skills(m["cwd"])
    sb = Sandbox(root=m["cwd"], allow=SANDBOX_DEV)
    tools = [t for t in TOOLS.values() if t.enabled] + sandbox_tools(sb, write=True)
    if m.get("kind") == "build" and m.get("plan_id"):
        system = stable_context() + "\n\n" + _BUILD_DIRECTIVE + f"\n\nBuilding MegaPlan: {m['plan_id']}"
        goal = f"Every task of MegaPlan {m['plan_id']} is marked complete (plan status done)."
        task = (f"Build MegaPlan '{m['plan_id']}'. Fetch it (megaplan get), then work its tasks to "
                "completion one at a time, marking each complete; when all are done you are finished.")
    else:
        system, goal, task = stable_context(), m["goal"], m["goal"]
    history = []
    if os.path.exists(hp):
        try:
            history = json.load(open(hp))
        except Exception:
            history = []
    # model: explicit pin from submit > (classify goal) hard→reasoning_seat, else saint-auto.
    # build jobs are inherently multi-step reasoning → always the capable seat.
    pin = m.get("model") if m.get("model") not in (None, "", "saint") else None
    seat = pin or (reasoning_seat() if m.get("kind") == "build" else agentic_seat(goal))
    mo, bo = _resolve_seat(seat) or SEATS.get("saint") or (MODEL, BASE)
    _write_meta(jid, state="running", started=m.get("started") or time.time(),
                pid=os.getpid(), last_activity=time.time(), active_count=0, active_tool=None)
    logline("start", goal=goal, model=mo)

    # In-flight counter: tools run CONCURRENTLY (parallel dispatch), so track how many are
    # in flight — the job is 'working' while any are, even if a fast one finished first. A
    # single active_tool field would clear on the first result and mislabel a long call stalled.
    _inflight = {"n": 0, "since": 0.0, "calls": (m.get("tool_calls") or 0)}
    _inflight_lock = threading.Lock()

    def on_tool(ev, tc, out):
        fn = tc.get("function") or {}
        if ev == "call":
            logline("tool_call", name=fn.get("name"), args=(fn.get("arguments") or "")[:400])
            with _inflight_lock:
                _inflight["n"] += 1
                if _inflight["n"] == 1:
                    _inflight["since"] = time.time()
                n, since = _inflight["n"], _inflight["since"]
            _write_meta(jid, last_activity=time.time(), active_tool=fn.get("name"),
                        active_since=since, active_count=n)
        else:
            logline("tool_result", name=fn.get("name"), out=(out or "")[:400])
            with _inflight_lock:
                _inflight["n"] = max(0, _inflight["n"] - 1); _inflight["calls"] += 1
                n, calls = _inflight["n"], _inflight["calls"]
            _write_meta(jid, last_activity=time.time(), active_count=n, tool_calls=calls,
                        active_tool=None if n == 0 else fn.get("name"))
        return None

    sysfull = system + "\n\n" + _GOAL_DIRECTIVE.format(goal=goal)
    # Dark gate: a command over the autonomous risk tolerance parks the job for /jobs answer.
    dark = {"tol": gate_tolerance(dark=True), "approved": m.get("approved_cmd")}
    res = run_thread(task, history=history, system=sysfull, model=mo, base=bo, tools=tools,
                     quiet=True, on_tool=on_tool, gate=False, dark=dark,
                     terminate=goal_terminate(goal, 24),
                     max_rounds=_JOB_MAX_ROUNDS, session="job-" + jid)
    _write_meta(jid, tokens_in=res["tokens_in"], tokens_out=res["tokens_out"], rounds=res["rounds"])
    if res.get("needs_approval"):                  # over-tolerance command → park for approval
        na = res["needs_approval"]
        need = (f"approve command (risk {na['risk']}): {na['cmd']}"
                + (f"  — {na['reason']}" if na.get("reason") else ""))
        json.dump(res["history"], open(hp, "w"))
        _write_meta(jid, state="blocked", need=need, active_tool=None, active_count=0,
                    pending_cmd=na["cmd"], approved_cmd=None)   # consume any prior one-time approval
        logline("blocked_approval", cmd=na["cmd"], risk=na["risk"])
    elif res.get("blocked"):
        json.dump(res["history"], open(hp, "w"))
        _write_meta(jid, state="blocked", need=res["blocked"])
        logline("blocked", need=res["blocked"])
    elif res["error"]:
        _write_meta(jid, state="failed", error=res["error"], ended=time.time())
        logline("failed", error=res["error"])
    else:
        rp = os.path.join(_job_dir(jid), "result.md")
        open(rp, "w").write(res["text"] or "")
        _write_meta(jid, state="done", ended=time.time(), result_path=rp,
                    goal_met=bool(res.get("goal_met")), stopped=res["stopped"])
        logline("done", stopped=res["stopped"])
    return 0


def resume_job(jid, answer):
    """Append the user's answer to a blocked job's saved history and relaunch it."""
    m = _read_meta(jid)
    if not m or m.get("state") != "blocked":
        return False
    hp = os.path.join(_job_dir(jid), "history.json")
    try:
        hist = json.load(open(hp))
    except Exception:
        hist = []
    pending = m.get("pending_cmd")
    if pending is not None:                         # this was a tool-approval block (yes/no)
        approve = (answer or "").strip().lower() in (
            "y", "yes", "yep", "yeah", "approve", "approved", "ok", "okay", "allow", "run", "proceed")
        if approve:
            _write_meta(jid, approved_cmd=pending, pending_cmd=None)
            hist.append({"role": "user", "content":
                         f"APPROVED by the operator: you may run `{pending}`. Re-issue that command "
                         "now and continue toward the goal."})
        else:
            _write_meta(jid, approved_cmd=None, pending_cmd=None)
            hist.append({"role": "user", "content":
                         f"DECLINED by the operator: do NOT run `{pending}`. Find another approach; "
                         "if you genuinely cannot proceed, end your reply with `BLOCKED: <need>`."})
    else:                                           # a goal-level BLOCKED the model raised itself
        hist.append({"role": "user",
                     "content": f"(Answer to your BLOCKED need — {m.get('need')!r}): {answer}"})
    json.dump(hist, open(hp, "w"))
    _write_meta(jid, state="queued", need=None)
    out = open(os.path.join(_job_dir(jid), "runner.out"), "a")
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "--job", jid],
                     stdout=out, stderr=out, stdin=subprocess.DEVNULL, start_new_session=True)
    return True


def _fmt_dur(s):
    s = int(s or 0)
    return f"{s}s" if s < 60 else f"{s // 60}m{s % 60:02d}s" if s < 3600 else f"{s // 3600}h{(s % 3600) // 60:02d}m"


_JOBS_SEEN = {}   # jid -> last state we notified about (for the prompt-time notifier)


def poll_jobs_notify():
    """Print a one-line notice when a background job newly finishes / blocks / fails."""
    for m in list_jobs():
        jid, st = m["id"], job_state(m)
        if _JOBS_SEEN.get(jid) == st:
            continue
        prev = _JOBS_SEEN.get(jid)
        _JOBS_SEEN[jid] = st
        if prev is None:                       # first sight (e.g. pre-existing) — don't shout
            continue
        if st == "blocked":
            notify_blocked(f"job {jid} · {m.get('title','')}", m.get("need", "?"))
        elif st == "done":
            gm = " ✔goal met" if m.get("goal_met") else ""
            print(f"\n{GREEN_BUILD}{BOLD}● job {jid} done{RESET}{DIM}{gm} — {m.get('title','')}  (/jobs show {jid}){RESET}")
        elif st in ("failed", "dead"):
            print(f"\n{RED_VIVID}● job {jid} {st}{RESET}{DIM} — {m.get('title','')}  (/jobs show {jid}){RESET}")


# ---------------------------------------------------------------------------------------------
# Session persistence — the conversation thread survives exit/restart.
#   snapshot: ~/.config/input/sessions/<SESSION>.json (after every turn, on /goal changes, at exit)
#   resume:   `input --resume [id|last]`, `input --sessions`, in-REPL /sessions [list|resume <id>|save]
_SESSIONS_DIR = os.path.expanduser("~/.config/input/sessions")
_SESS = {"history": None, "thinks": None, "title": "", "started": None}
RESUME_ID = None           # set from argv (--resume)


def _session_path(sid):
    return os.path.join(_SESSIONS_DIR, sid + ".json")


def _session_title(h):
    for m in h or []:
        if m.get("role") == "user" and isinstance(m.get("content"), str) and m["content"].strip():
            t = " ".join(m["content"].split())
            return t[:90]
    return ""


def _session_save(history=None, thinks=None):
    """Snapshot the live thread + mode/goal/sidebars. Cheap (one JSON write); never raises."""
    h = history if history is not None else _SESS.get("history")
    if not SESSION or h is None:
        return
    try:
        os.makedirs(_SESSIONS_DIR, exist_ok=True)
        _SESS["title"] = _SESS.get("title") or _session_title(h)
        snap = {"version": 1, "session": SESSION, "title": _SESS["title"],
                "started": _SESS.get("started") or time.time(), "updated": time.time(),
                "cwd": os.getcwd(), "model": MODEL, "base": BASE, "seat": active_name(),
                "perm_mode": PERM_MODE, "goal": GOAL, "goal_seat": GOAL_SEAT, "goal_blocked": GOAL_BLOCKED,
                "plan_goal": PLAN_GOAL, "plan_id": PLAN_ID, "build_id": BUILD_ID, "plan_task": PLAN_TASK,
                "history": h, "thinks": (thinks if thinks is not None else _SESS.get("thinks")) or [],
                "sidebars": SIDEBARS, "sb_under": _SB_UNDER, "sb_paused": _SB_PAUSED, "sb_seq": _SB_SEQ,
                "loaded_skills": sorted(LOADED_SKILLS) if LOADED_SKILLS else []}
        tmp = _session_path(SESSION) + ".tmp"
        with open(tmp, "w") as f:
            json.dump(snap, f, default=str)
        os.replace(tmp, _session_path(SESSION))
        with open(os.path.join(_SESSIONS_DIR, "last"), "w") as f:
            f.write(SESSION)
        _session_prune()
    except Exception as e:   # persistence is best-effort; never break the turn
        _SESS["last_error"] = f"{type(e).__name__}: {e}"


def _session_prune(keep=60):
    try:
        files = sorted((f for f in os.listdir(_SESSIONS_DIR) if f.endswith(".json")),
                       key=lambda f: os.path.getmtime(os.path.join(_SESSIONS_DIR, f)), reverse=True)
        for f in files[keep:]:
            os.remove(os.path.join(_SESSIONS_DIR, f))
    except Exception:
        pass


def _session_list(limit=20):
    out = []
    try:
        for f in os.listdir(_SESSIONS_DIR):
            if not f.endswith(".json"):
                continue
            try:
                with open(os.path.join(_SESSIONS_DIR, f)) as fh:
                    d = json.load(fh)
                out.append({"session": d.get("session", f[:-5]), "title": d.get("title", ""),
                            "updated": d.get("updated", 0), "turns": sum(1 for m in d.get("history", []) if m.get("role") == "user"),
                            "goal": d.get("goal", ""), "cwd": d.get("cwd", ""), "seat": d.get("seat", "")})
            except Exception:
                continue
    except FileNotFoundError:
        return []
    out.sort(key=lambda x: x["updated"], reverse=True)
    return out[:limit]


def _session_load(sid):
    """'last' → pointer file; else exact id or unique prefix (with or without the 'input-' prefix)."""
    try:
        if sid in ("", "last"):
            with open(os.path.join(_SESSIONS_DIR, "last")) as f:
                sid = f.read().strip()
        if not os.path.exists(_session_path(sid)):
            cands = [f[:-5] for f in os.listdir(_SESSIONS_DIR) if f.endswith(".json")
                     and (f[:-5].startswith(sid) or f[:-5].startswith("input-" + sid))]
            if len(cands) != 1:
                return None
            sid = cands[0]
        with open(_session_path(sid)) as f:
            return json.load(f)
    except Exception:
        return None


def _session_restore(snap, history, thinks):
    """Load a snapshot INTO the live REPL state (lists mutated in place; globals re-set)."""
    global SESSION, MODEL, BASE, PERM_MODE, GOAL, GOAL_SEAT, GOAL_BLOCKED, PLAN_GOAL, PLAN_ID, BUILD_ID, PLAN_TASK, _SB_SEQ
    history[:] = snap.get("history") or []
    thinks[:] = snap.get("thinks") or []
    SIDEBARS[:] = snap.get("sidebars") or []
    _SB_UNDER[:] = snap.get("sb_under") or []
    _SB_PAUSED[:] = snap.get("sb_paused") or []
    _SB_SEQ = int(snap.get("sb_seq") or 0)
    SESSION = snap.get("session") or SESSION          # same id → Astoria working memory + SAINT affinity continue
    PERM_MODE = snap.get("perm_mode") or PERM_MODE
    GOAL, GOAL_SEAT, GOAL_BLOCKED = snap.get("goal", ""), snap.get("goal_seat", ""), snap.get("goal_blocked", "")
    PLAN_GOAL, PLAN_ID, BUILD_ID = snap.get("plan_goal", ""), snap.get("plan_id", ""), snap.get("build_id", "")
    PLAN_TASK = snap.get("plan_task", "") if PLAN_ID else ""
    seat = snap.get("seat")
    if seat in SEATS:
        MODEL, BASE = SEATS[seat]
    elif snap.get("model") and snap.get("base"):
        MODEL, BASE = snap["model"], snap["base"]
    cwd = snap.get("cwd")
    if cwd and os.path.isdir(cwd):
        try:
            os.chdir(cwd)
        except OSError:
            pass
    _SESS["title"], _SESS["started"] = snap.get("title", ""), snap.get("started") or time.time()
    _SESS["history"], _SESS["thinks"] = history, thinks
    turns = sum(1 for m in history if m.get("role") == "user")
    last_user = next((m["content"] for m in reversed(history) if m.get("role") == "user" and isinstance(m.get("content"), str)), "")
    age = time.time() - float(snap.get("updated") or time.time())
    print(f"{DIM}↺ resumed {SESSION} — {turns} turn(s), last active {_fmt_dur(age)} ago · seat {active_name()} · cwd {os.getcwd()}")
    if _SESS["title"]:
        print(f"  ⌁ {_SESS['title'][:100]}")
    if last_user:
        print(f"  last prompt: {' '.join(last_user.split())[:110]}")
    if GOAL:
        print(f"  ● goal restored (say 'continue' to resume it · /goal off to drop): {GOAL[:100]}")
    if _SB_PAUSED or SIDEBARS:
        print(f"  sidebars: {len(SIDEBARS)} active · {len(_SB_PAUSED)} parked")
    print(f"  (tool outputs in the restored thread may be stale; re-check anything that matters){RESET}")


def _sessions_command(arg, history, thinks):
    arg = (arg or "").strip()
    if not arg or arg == "list":
        rows = _session_list()
        if not rows:
            print("(no saved sessions)"); return
        for r in rows:
            mark = "●" if r["session"] == SESSION else " "
            age = _fmt_dur(time.time() - float(r["updated"] or time.time()))
            g = f"  [goal: {r['goal'][:40]}]" if r.get("goal") else ""
            print(f"{mark} {r['session']}  {age:>7} ago  {r['turns']:>3}t  {r['seat'] or '':<8} {r['title'][:70]}{g}")
        print(f"{DIM}/sessions resume <id|last> · /sessions save · input --resume [id]{RESET}")
        return
    if arg.startswith("resume"):
        sid = arg[6:].strip() or "last"
        snap = _session_load(sid)
        if not snap:
            print(f"no such session: {sid!r} (/sessions to list)"); return
        if snap.get("session") == SESSION:
            print("that is the current session"); return
        if any(m.get("role") == "user" for m in history):
            _session_save(history, thinks)           # don't lose the current thread
            print(f"{DIM}(current session saved as {SESSION}){RESET}")
        _session_restore(snap, history, thinks)
        return
    if arg == "save":
        _session_save(history, thinks)
        print(f"saved → {_session_path(SESSION)}" + (f"  (error: {_SESS['last_error']})" if _SESS.get("last_error") else ""))
        return
    print("usage: /sessions [list] · /sessions resume <id|last> · /sessions save")


def _turn(history, thinks, user, stats, model=None, base=None, no_tools=False, max_rounds=None):
    """One interactive REPL turn = run_thread with printing, memory recall/store, gating.
    no_tools=True → a pure conversational reply (no tool schemas offered); max_rounds caps the
    agent loop for this turn (default GOAL_MAX_ROUNDS). Used by orientation turns like
    /megaplan load that must inform, not act."""
    stats.turns += 1
    recalled = mem_recall(user)                    # ambient memory for this turn (best-effort)
    if recalled:
        n = sum(1 for l in recalled.splitlines() if l.startswith("- "))
        print(f"{DIM}⟐ memory: {n} recalled{RESET}")

    seg_sig = []                                   # tool-call signatures for the CURRENT segment
    def on_tool(ev, tc, out):
        fn = tc.get("function") or {}
        if ev == "call":
            seg_sig.append(f"{fn.get('name')}::{(fn.get('arguments') or '')[:200]}")
            print(f"{DIM}⚙ {fn.get('name')}({_fmt_args(fn.get('arguments'))}){RESET}"); return None
        tool = TOOLS.get(fn.get("name"))
        full = bool(out) and getattr(tool, "display", "compact") == "full"
        if full:
            _print_full_result(out)                # e.g. list_files: show the whole ls -l
        else:
            print(f"{DIM}  → {_fmt_result(out)}{RESET}")
        # model gets the full text either way; for full-display tools, tell it the user
        # already saw it so it doesn't re-list the same content back
        return out + _SHOWN_NOTE if full else out

    global GOAL, GOAL_SEAT, GOAL_BLOCKED
    if GOAL_BLOCKED:                               # the user's message answers the block → resume
        if _looks_like_abandon(user):             # …unless it's "stop here" → clear, don't re-loop
            cleared = GOAL
            GOAL, GOAL_SEAT, GOAL_BLOCKED = "", "", ""
            print(f"{YEL}◌ goal abandoned{RESET}{DIM} — {cleared[:80]}  "
                  f"(/goal <criteria> to set a new one){RESET}")
            return
        user = f"(Answer to your BLOCKED need — {GOAL_BLOCKED!r}): {user}"
        GOAL_BLOCKED = ""
    tools = None if no_tools else ([t for t in TOOLS.values() if t.enabled] if TOOLS_ON else None)
    if GOAL and GOAL_SEAT and GOAL_SEAT in SEATS and (model, base) == (None, None):
        model, base = SEATS[GOAL_SEAT]         # hard goal → pin the loop to the capable seat
    maxr = max_rounds or GOAL_MAX_ROUNDS   # generous per-segment budget for goals AND plain turns
    try:
        # A goal runs open-ended: keep going as long as it makes PROGRESS. Each segment is one
        # run_thread call; between segments we check whether new tool work happened. Continue
        # forever while progress continues; abort only when it STALLS (GOAL_STALL_LIMIT segments
        # with no new work) — so a genuine 10k-step goal completes, a spinning one doesn't hang.
        nxt, last_sig, stalls, seg, total_rounds = user, None, 0, 0, 0
        while True:
            seg_sig.clear()
            terminate = goal_terminate(GOAL, GOAL_MAX_NUDGES) if GOAL else None
            res = run_thread(nxt, history=history, tools=tools, model=model, base=base, quiet=False,
                             stats=stats, thinks=thinks, volatile=recalled, on_tool=on_tool, gate=True,
                             terminate=terminate, max_rounds=maxr)
            total_rounds += res["rounds"]
            # Finished (model gave its answer) or blocked/errored → stop. Keep going only when it
            # hit the round cap MID-work — for goals AND plain turns — while still progressing.
            if (res["error"] or res.get("goal_met") or res.get("blocked")
                    or res.get("needs_approval") or res["stopped"] != "rounds"):
                break
            sig = tuple(seg_sig)                   # what this segment actually did
            if sig and sig != last_sig:            # new tool work happened → real progress
                stalls, last_sig = 0, sig
            else:                                  # empty or an exact repeat of last segment
                stalls += 1
                last_sig = sig
            if stalls >= GOAL_STALL_LIMIT:
                res["goal_stalled"] = True; break
            seg += 1
            if seg >= GOAL_HARD_MAX_SEGMENTS:      # runaway backstop, far beyond any real goal
                res["goal_stalled"] = True; break
            print(f"{DIM}  ↻ {'goal ' if GOAL else ''}working — {total_rounds} rounds so far, "
                  f"still progressing; continuing…{RESET}")
            nxt = (("You have not signalled completion. Keep working toward the goal. When the exit "
                    "criteria are genuinely met end with `GOAL MET: <evidence>`; if hard-blocked, "
                    "`BLOCKED: <need>`.") if GOAL else
                   "Continue with the task until it is fully done, then give your final answer.")
            recalled = None                        # don't re-recall memory on continuations
    except KeyboardInterrupt:
        tail = " goal still set; 'continue' resumes, /goal off clears" if GOAL else " 'continue' resumes"
        print(f"{RESET}\n(interrupted —{tail})"); return
    if res.get("blocked"):
        notify_blocked("session goal", res["blocked"])
    elif res.get("goal_met"):
        print(f"{GREEN_BUILD}{BOLD}✔ GOAL MET{RESET}{DIM} — {GOAL[:80]}  (goal cleared){RESET}")
        GOAL, GOAL_SEAT, GOAL_BLOCKED = "", "", ""   # met → exit goal mode; prompt returns to normal
    elif res.get("goal_stalled"):
        what = "goal stalled" if GOAL else "paused"
        print(f"{YEL}◑ {what}{RESET}{DIM} — no new progress over {GOAL_STALL_LIMIT} segments "
              f"({total_rounds} rounds total). Say 'continue' to retry"
              f"{' · /goal off to stop' if GOAL else ''}.{RESET}")
    elif GOAL and (res["stopped"] == "rounds" or res.get("goal_paused")):
        print(f"{YEL}◐ goal paused{RESET}{DIM} — say 'continue' to push on · /goal off to stop.{RESET}")
    elif res["stopped"] == "rounds":
        print(f"{DIM}(paused after {total_rounds} rounds — say 'continue' to keep going){RESET}")
    if res["error"]:
        print(f"[error: {res['error']}]")
    else:
        mem_store(user, res["text"])               # normal completion → persist the exchange
    _session_save(history, thinks)                 # snapshot the thread (resume survives exit/crash)


def repl():
    global SESSION, TOOLS_ON, PERM_MODE, PLAN_GOAL, PLAN_ID, BUILD_ID, PLAN_TASK, GOAL, GOAL_SEAT, GOAL_BLOCKED
    _st = load_settings()
    TOOLS_ON = _st.get("tools", True)
    load_user_tools()
    load_mcp_tools()                                  # MCP server tools (disabled by default)
    apply_tools_state()                               # restore per-tool on/off from settings
    discover_skills()                                 # skills index (bodies load on trigger)
    history, thinks = [], []
    stats = Stats()
    _SESS["history"], _SESS["thinks"], _SESS["started"] = history, thinks, time.time()
    __import__("atexit").register(lambda: _safe(lambda: _session_save()))   # last-chance snapshot on exit (atexit is imported later in this function → would be a local)

    def _enter_build(pid, kickoff=True, rerun=False):   # load a plan and drop into BUILD mode
        global PERM_MODE, PLAN_GOAL, PLAN_ID, BUILD_ID, PLAN_TASK
        p = megaplan_call("get", id=pid)
        if isinstance(p, dict) and "error" in p:
            print(f"{DIM}megaplan: {p['error']}{RESET}"); return False
        if p.get("status") == "done" and not rerun:   # completed → nothing to build unless re-run
            ans = input(f"{DIM}▸ '{pid}' is complete. Reopen all tasks and run it again? [y/N]: {RESET}").strip().lower()
            if ans in ("y", "yes"):
                rerun = True
            else:
                print(f"{DIM}(already done — /build {pid} rerun to force a re-run){RESET}"); return False
        if rerun:
            ok, msg = _reopen_plan(pid)
            print(f"{DIM}↻ {msg if ok else 'reopen failed: ' + msg}{RESET}")
            if not ok:
                return False
            p = megaplan_call("get", id=pid)          # refresh after reopening
        if PERM_MODE == "plan":                   # leave authoring; keep gating otherwise
            PERM_MODE = "cautious"
        PLAN_GOAL, PLAN_ID, BUILD_ID = (p.get("title", "") if isinstance(p, dict) else ""), pid, pid
        plan_render(p)
        t = _task_of(p, PLAN_TASK) if PLAN_TASK else None
        if PLAN_TASK and t is None:
            print(f"{DIM}(focused task {PLAN_TASK} not in this plan — building the whole plan){RESET}")
            PLAN_TASK = ""
        scope = f" · ONLY task {PLAN_TASK} (/work off to clear the focus)" if t else ""
        print(f"{DIM}● BUILD mode — executing {pid}{scope}   ({PERM_MODE}; Shift+Tab to change · "
              f"/build off to stop){RESET}")
        if kickoff:
            if t:
                seed = (f"Build MegaPlan '{pid}' — ONLY task {PLAN_TASK}: "
                        f"{' '.join(str(t.get('text') or '').split())}\n\nFor context, the plan:\n\n"
                        f"{p.get('body', '')}\n\nDo the work for task {PLAN_TASK}, mark it complete via "
                        f"megaplan(action=\"complete\", id=\"{pid}\", task_id=\"{PLAN_TASK}\"), then STOP "
                        f"and report — do not start other tasks.")
            else:
                seed = (f"Build MegaPlan '{pid}'. Here is the plan:\n\n{p.get('body', '')}\n\n"
                        f"Start with the first actionable task (dependencies satisfied): do the work, "
                        f"then mark it complete via megaplan. Proceed.")
            _turn(history, thinks, seed, stats)
            print(_status_line(stats))
        return True

    def _plan_task_cmd(verb, rest):
        """Task-level interaction with the LOADED plan: work/focus · complete · uncomplete ·
        block/unblock · add. No task id → arrow-pick (Tab hands '/<verb> tN ' back to edit)."""
        global PLAN_TASK, _PREFILL
        verb = {"focus": "work", "done": "complete", "undone": "uncomplete", "reopen": "uncomplete"}.get(verb, verb)
        words = rest.split()
        if verb == "work" and words and words[0].lower() in ("off", "none", "clear"):
            PLAN_TASK = ""; print(f"{DIM}task focus cleared{RESET}"); return
        if not PLAN_ID:
            print(f"{DIM}no plan loaded — /megaplan load [id] first{RESET}"); return
        p = megaplan_call("get", id=PLAN_ID)
        if not isinstance(p, dict) or "error" in p:
            print(f"{DIM}megaplan: {p.get('error') if isinstance(p, dict) else p}{RESET}"); return
        if verb == "add":
            text = rest.strip()
            if not text:
                print(f"{DIM}usage: /megaplan add <task text> [2h]{RESET}"); return
            est = None
            m = re.search(r"\s*\(?(?:est:?\s*)?(\d+(?:\.\d+)?)\s*h\)?\s*$", text)
            if m:
                est, text = float(m.group(1)), text[: m.start()].rstrip()
            r = megaplan_call("add_task", id=PLAN_ID, text=text, est_hours=est)
            if isinstance(r, dict) and "error" in r:
                print(f"{DIM}megaplan: {r['error']}{RESET}"); return
            new = (r.get("tasks") or [{}])[-1]
            print(f"{DIM}added{RESET} {_task_line(new)}")
            return
        # resolve the task id: explicit tN, else picker (filtered by what makes sense)
        tid = words[0] if words and re.fullmatch(r"t\d+", words[0].lower()) else ""
        flags = [w.lower() for w in (words[1:] if tid else words)]
        if not tid:
            only = {"complete": "open", "uncomplete": "done"}.get(verb)
            pick = task_pick(p, verb, only=only, editable=True)
            if isinstance(pick, tuple) and pick[0] == "edit":
                _PREFILL = f"/{verb} {pick[1]} "; return
            tid = pick
            if not tid:
                return
        t = _task_of(p, tid)
        if t is None:
            print(f"{DIM}no task {tid} in {PLAN_ID}{RESET}"); return
        if verb == "complete":
            r = megaplan_call("complete", id=PLAN_ID, task_id=tid)
        elif verb == "uncomplete":
            r = megaplan_call("update_task", id=PLAN_ID, task_id=tid, done=False)
            if isinstance(r, dict) and r.get("status") == "done":     # plan was auto-closed → reopen it
                r = megaplan_call("update", id=PLAN_ID, status="active")
        elif verb in ("block", "unblock"):
            r = megaplan_call("update_task", id=PLAN_ID, task_id=tid, blocked=(verb == "block"))
        elif verb == "work":
            PLAN_TASK = tid
            print(f"{BLUE_ELECTRIC}▸ focus{RESET} {_task_line(t)}")
            if any(f in ("go", "build", "run", "do") for f in flags):
                _enter_build(PLAN_ID)                    # build ONLY this task (scoped by PLAN_TASK)
                return
            print(f"{DIM}  (/work {tid} go or /build to execute just this task · /work off to clear){RESET}")
            seed = (f"Focus on task {tid} of MegaPlan '{p.get('title', PLAN_ID)}' ({PLAN_ID}):\n\n"
                    f"{' '.join(str(t.get('text') or '').split())}\n\nIn a few lines: what does this task "
                    f"entail, what does it depend on / unblock, and what concrete first step would you take? "
                    f"Plain prose only — no tools on this reply, no action blocks. Then STOP and wait for "
                    f"my direction; don't start executing anything until I say go.")
            _turn(history, thinks, seed, stats, no_tools=True, max_rounds=1)
            print(_status_line(stats))
            return
        else:
            print(f"{DIM}unknown task verb {verb}{RESET}"); return
        if isinstance(r, dict) and "error" in r:
            print(f"{DIM}megaplan: {r['error']}{RESET}"); return
        t2 = _task_of(r, tid) or t
        pr = r.get("progress") or {}
        print(f"{_task_line(t2)}   {DIM}{pr.get('done', 0)}/{pr.get('total', 0)} · plan {r.get('status')}{RESET}")
        if verb == "complete" and PLAN_TASK == tid:
            PLAN_TASK = ""                               # focus done → clear

    def _offer_build():                           # after a save, offer the one-key handoff
        pid = _take_saved()
        if not pid or BUILD_ID:                   # nothing saved, or already building
            return
        try:
