def read_line(prompt):
    """cbreak line reader: returns (text, mode). mode 'send' on Enter, 'pick' on
    Ctrl+Enter (terminals that send LF), None text with 'eof' on Ctrl-D. Falls back
    to input() off-TTY. Up/down walk readline history; basic cursor editing."""
    if not sys.stdin.isatty():
        try:
            return input(prompt), "send"
        except EOFError:
            return None, "eof"
    import select, termios
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    new = termios.tcgetattr(fd)
    new[3] &= ~(termios.ICANON | termios.ECHO)             # lflag: no line-buffer/echo (ISIG stays)
    new[0] &= ~(termios.ICRNL | termios.INLCR | termios.IGNCR)  # keep CR (Enter) and NL (Ctrl+Enter) distinct
    new[6][termios.VMIN], new[6][termios.VTIME] = 1, 0
    buf, pos = [], 0
    hlen = _rl.get_current_history_length() if _rl else 0
    hidx, saved = hlen, ""
    crow = 0                                   # cursor's row offset from the line's start row

    def redraw():
        # Wrapping-aware: the prompt+buffer may span several terminal rows. Go up to the
        # block's start, clear to end of screen, rewrite, then reposition the cursor —
        # otherwise a line past the screen width cascades one copy per keystroke.
        nonlocal crow
        w = max(1, shutil.get_terminal_size((80, 24)).columns)
        plen = _vlen(prompt)
        if crow:
            sys.stdout.write(f"\033[{crow}A")
        sys.stdout.write("\r\033[J" + prompt + "".join(buf))
        total = plen + len(buf)
        endrow = (total - 1) // w if total else 0
        if pos == len(buf):                    # cursor already at the natural end
            crow = endrow
        else:                                  # editing mid-line: move back to `pos`
            tgt = plen + pos
            trow, tcol = divmod(tgt, w)
            sys.stdout.write("\r")             # col 0 of the bottom row (clears pending wrap)
            if endrow - trow > 0:
                sys.stdout.write(f"\033[{endrow - trow}A")
            if tcol:
                sys.stdout.write(f"\033[{tcol}C")
            crow = trow
        sys.stdout.flush()

    def load(item):
        nonlocal buf, pos
        buf, pos = list(item), len(item); redraw()

    try:
        termios.tcsetattr(fd, termios.TCSANOW, new)
        redraw()
        while True:
            ch = os.read(fd, 1)
            if ch in (b"\r", b"\n"):
                # Descend past the whole wrapped block before the newline: crow can lag
                # the true bottom row (wrap math drift / a resize mid-entry), and a bare
                # \r\n from a too-high row leaves the next output (the ⟐ memory notice,
                # routing) printed on top of the still-visible prompt.
                w = max(1, shutil.get_terminal_size((80, 24)).columns)
                endrow = (_vlen(prompt) + len(buf) - 1) // w if (buf or prompt) else 0
                if endrow > crow:
                    sys.stdout.write(f"\033[{endrow - crow}B")
                sys.stdout.write("\r\n")
                return "".join(buf), ("send" if ch == b"\r" else "pick")
            if ch == b"\x04":                          # Ctrl-D
                if not buf:
                    sys.stdout.write("\r\n"); return None, "eof"
            elif ch in (b"\x7f", b"\x08"):             # backspace
                if pos > 0:
                    del buf[pos - 1]; pos -= 1; redraw()
            elif ch == b"\x01":                        # Ctrl-A home
                pos = 0; redraw()
            elif ch == b"\x05":                        # Ctrl-E end
                pos = len(buf); redraw()
            elif ch == b"\x15":                        # Ctrl-U kill to start
                del buf[:pos]; pos = 0; redraw()
            elif ch == b"\x0b":                        # Ctrl-K kill to end
                del buf[pos:]; redraw()
            elif ch == b"\x12":                        # Ctrl+R (route) → peek routing shortcuts
                if buf:                                # only when there's staged text to route
                    sys.stdout.write("\r\n")
                    for ln in _route_hint_lines():
                        sys.stdout.write(ln + "\r\n")
                    crow = 0
                    redraw()
            elif ch == b"\x1b":                        # escape sequences
                if select.select([fd], [], [], 0.05)[0]:
                    intro = os.read(fd, 1)             # '[' (CSI) or 'O' (SS3)
                    seq = intro
                    if intro in (b"[", b"O"):          # read to the final byte (a letter or '~')
                        while len(seq) < 16:
                            c = os.read(fd, 1)
                            if not c:
                                break
                            seq += c
                            if c.isalpha() or c == b"~":
                                break
                    if seq == b"[A" and _rl and hidx > 0:
                        if hidx == hlen:
                            saved = "".join(buf)
                        hidx -= 1; load(_rl.get_history_item(hidx + 1) or "")
                    elif seq == b"[B" and _rl and hidx < hlen:
                        hidx += 1; load(saved if hidx == hlen else (_rl.get_history_item(hidx + 1) or ""))
                    elif seq == b"[C" and pos < len(buf):
                        pos += 1; redraw()
                    elif seq == b"[D" and pos > 0:
                        pos -= 1; redraw()
                    elif seq in (b"[H", b"OH"):
                        pos = 0; redraw()
                    elif seq in (b"[F", b"OF"):
                        pos = len(buf); redraw()
                    elif seq == b"[Z":                 # Shift+Tab → cycle permission mode
                        sys.stdout.write("\r\n"); return "".join(buf), "cycle"
                    else:                              # F-keys (plain or Ctrl/Alt+Fn) → one-shot seat
                        fk = _FKEY_SEQ.get(re.sub(rb";\d+", b"", seq))
                        if fk:
                            sys.stdout.write("\r\n"); return "".join(buf), "seat:" + fk
            elif ch >= b"\x20":                        # printable (+ utf-8 continuation)
                b0 = ch[0]
                extra = 0 if b0 < 0x80 else (1 if b0 < 0xE0 else (2 if b0 < 0xF0 else 3))
                if extra:
                    ch += os.read(fd, extra)
                try:
                    for cc in ch.decode():
                        buf.insert(pos, cc); pos += 1
                    redraw()
                except Exception:
                    pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def code_blocks(text):
    blocks, cur, in_code = [], [], False
    for line in (text or "").split("\n"):
        if line.lstrip().startswith("```"):
            if in_code:
                blocks.append("\n".join(cur)); cur, in_code = [], False
            else:
                in_code = True
        elif in_code:
            cur.append(line)
    if in_code and cur:
        blocks.append("\n".join(cur))
    return blocks


