def _is_saint(base):
    return base == SEATS["saint"][1]   # saint/cloud-* seats share the one SAINT base (:4000)


def clean_cmd(text):
    lines = [l for l in text.strip().splitlines() if not l.strip().startswith("```")]
    return "\n".join(lines).strip()


def review(cmd):
    """Ask gemma to risk-rate a command. Returns (risk, reason) or None if unavailable."""
    model, base = SEATS["gemma"]
    sysmsg = ("You are a shell-command safety reviewer. Rate the RISK of running the command. "
              'Reply ONLY compact JSON: {"risk":"none|low|medium|high|critical","reason":"short"}. '
              "high/critical = data loss, overwrite, exfiltration, system damage, irreversible.")
    try:
        raw = _post(model, base, [{"role": "system", "content": sysmsg},
                                  {"role": "user", "content": cmd}], think=False, max_tokens=200)
        m = re.search(r"\{.*\}", raw, re.S)
        v = json.loads(m.group(0))
        return v.get("risk", "unknown"), v.get("reason", "")
    except Exception:
        return None


def run(cmd, capture=False):
    if not capture:
        return subprocess.run(cmd, shell=True, executable=SHELL).returncode, ""
    p = subprocess.run(cmd, shell=True, executable=SHELL, capture_output=True, text=True)
    out = (p.stdout or "") + (p.stderr or "")
    sys.stdout.write(out)
    sys.stdout.flush()
    return p.returncode, out


def copy_clip(text):
    # Prefer a local clipboard tool only when there's a local display; otherwise (e.g.
    # over SSH) use OSC 52, which the terminal emulator puts on *your* clipboard.
    if os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"):
        for tool in (["wl-copy"], ["xclip", "-selection", "clipboard"], ["xsel", "-ib"]):
            if shutil.which(tool[0]):
                subprocess.run(tool, input=text.encode(), check=False)
                return True
    import base64
    seq = "\033]52;c;" + base64.b64encode(text.encode()).decode() + "\a"
    if os.environ.get("TMUX"):                       # tmux passthrough wrapper
        seq = "\033Ptmux;\033" + seq + "\033\\"
    sys.stdout.write(seq); sys.stdout.flush()
    return True


def _cmd_sys():
    ctx = os.environ.get("INPUT_CTX", "").strip()
    ctx = f" Recent shell history:\n{ctx}\n" if ctx else ""
    return (f"You generate shell commands for {platform.system()} / {SHELL} / cwd {os.getcwd()}. "
            f"{ground_text()}{ctx}"
            "Output ONLY the command — no markdown, no backticks, no explanation.")


def generate(task):
    return clean_cmd(complete([{"role": "system", "content": _cmd_sys()},
                               {"role": "user", "content": task}], max_tokens=1024))


# --- one-shot command mode (-e / -x) --------------------------------------------
def shell_mode(task, auto=False):
    messages = [{"role": "system", "content": _cmd_sys()}, {"role": "user", "content": task}]
    cmd = clean_cmd(complete(messages, max_tokens=1024))
    messages.append({"role": "assistant", "content": cmd})
    if auto:
        d = danger(cmd)
        print(f"{BOLD}{cmd}{RESET}", file=sys.stderr)
        if d:
            print(f"{RED}BLOCKED: catastrophic pattern — refusing to auto-run.{RESET}", file=sys.stderr)
            return 1
        return run(cmd)[0]
    while True:
        print(f"{BOLD}{cmd}{RESET}")
        if danger(cmd):
            print(f"{RED}⚠ matches a catastrophic pattern — review carefully.{RESET}")
        try:
            choice = input("> execute | revise | describe | copy | quit: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            return 130
        if choice in ("e", "execute"):
            return run(cmd)[0]
        if choice in ("r", "revise"):
            fb = input("revision: ").strip()
            messages.append({"role": "user", "content": f"Revise: {fb}. Output only the command."})
            cmd = clean_cmd(complete(messages, max_tokens=1024))
            messages.append({"role": "assistant", "content": cmd})
        elif choice in ("d", "describe"):
            print(DIM + complete(messages + [{"role": "user", "content":
                  "Explain what this does, plain text, brief."}], max_tokens=512) + RESET)
        elif choice in ("c", "copy"):
            print("(copied)" if copy_clip(cmd) else "(no clipboard tool)")
        elif choice in ("q", "quit"):
            return 0


# --- goal agent (! / !!) --------------------------------------------------------
def goal_mode(task, auto=False):
    goal_sys = (f"Accomplish a shell goal step by step on {platform.system()} / {SHELL} / cwd {os.getcwd()}. "
                f"{ground_text()} "
                "Each turn output EITHER the single next command (no markdown/explanation) "
                "OR a line 'DONE: <summary>' when the goal is met. Commands must be non-interactive. "
                "You are shown each command's exit code and output.")
    ctx = os.environ.get("INPUT_CTX", "").strip()
    first = f"Goal: {task}" + (f"\n\nRecent shell history:\n{ctx}" if ctx else "")
    messages = [{"role": "system", "content": goal_sys}, {"role": "user", "content": first}]
    for step in range(1, MAX_AUTO_STEPS + 1):
        out = clean_cmd(complete(messages, max_tokens=1024))
        if out.upper().startswith("DONE"):
            print(f"{DIM}✓ {out[4:].lstrip(': ').strip() or 'done'}{RESET}")
            return 0
        cmd = out
        messages.append({"role": "assistant", "content": cmd})
        print(f"{BOLD}[{step}/{MAX_AUTO_STEPS}] {cmd}{RESET}")
        d = danger(cmd)
        proceed = False
        if d:
            print(f"{RED}⚠ catastrophic pattern — manual confirmation required.{RESET}")
        elif auto:
            v = review(cmd)
            if v and v[0] in ("none", "low"):
                print(f"{DIM}gemma: {v[0]} risk — auto-proceeding{RESET}")
                proceed = True
            elif v:
                print(f"{YEL}gemma: {v[0]} risk — {v[1]}{RESET}")
            else:
                print(f"{YEL}gemma review unavailable — confirm manually{RESET}")
        if not proceed:
            try:
                ans = input("> run this? [y]es/[s]kip/[q]uit: ").strip().lower()
            except (EOFError, KeyboardInterrupt):
                return 130
            if ans in ("q", "quit"):
                return 0
            if ans in ("s", "skip", "n", "no"):
                messages.append({"role": "user", "content": "Skipped by user. Propose an alternative or DONE."})
                continue
        rc, o = run(cmd, capture=True)
        messages.append({"role": "user", "content": f"exit={rc}\noutput:\n{o[:1500]}"})
    print(f"{YEL}reached {MAX_AUTO_STEPS}-step cap.{RESET}")
    return 0


# --- chat REPL ------------------------------------------------------------------
def _inline(s):
    """Render inline markdown: `code`, **bold**, *italic*, ~~strike~~."""
    s = re.sub(r"`([^`]+)`", lambda m: f"{CODE_FG}{m.group(1)}{RESET}", s)  # code first (protects)
    s = re.sub(r"\*\*([^*]+)\*\*|__([^_]+)__",
               lambda m: f"{BOLD}{m.group(1) or m.group(2)}{RESET}", s)
    s = re.sub(r"~~([^~]+)~~", lambda m: f"\033[9m{m.group(1)}{RESET}", s)
    s = re.sub(r"(?<![\*\w])\*([^*\s][^*]*?)\*(?!\w)", lambda m: f"{ITAL}{m.group(1)}{RESET}", s)
    s = re.sub(r"(?<![_\w])_([^_\s][^_]*?)_(?!\w)", lambda m: f"{ITAL}{m.group(1)}{RESET}", s)
    return s


def _vlen(s):
    """Visible width: characters minus ANSI SGR escapes (for cursor math)."""
    return len(re.sub(r"\033\[[0-9;]*m", "", s))


def _prose(line):
    """Format one non-code line of markdown for the terminal."""
    h = re.match(r"^(#{1,6})\s+(.*)", line)
    if h:
        return f"{BOLD}{ULINE}{_inline(h.group(2))}{RESET}"
    b = re.match(r"^(\s*)[-*+]\s+(.*)", line)
    if b:
        return f"{b.group(1)}{DIM}•{RESET} {_inline(b.group(2))}"
    return _inline(line)


class MDRender:
    """Line-buffered streaming renderer: prose formatted; ```fenced``` blocks stream
    plain (top border + gutter, live) then redraw boxed + line-numbered on close, so a
    long code generation shows progress instead of a frozen gap while it buffers."""
    def __init__(self):
        self.tty = sys.stdout.isatty()
        self.buf, self.in_code, self.lang, self.code = "", False, "", []
        self.plain_rows = 0                   # terminal rows drawn for the in-progress block

    def _cols(self):
        return shutil.get_terminal_size((80, 24)).columns

    def feed(self, text):
        if not self.tty:                      # piped: keep it raw
            sys.stdout.write(text); sys.stdout.flush(); return
        self.buf += text
        while "\n" in self.buf:
            line, self.buf = self.buf.split("\n", 1)
            self._line(line)

    def _line(self, line):
        if line.lstrip().startswith("```"):
            if not self.in_code:
                self.in_code, self.lang, self.code = True, line.lstrip()[3:].strip(), []
                self._open()
            else:
                self._flush(); self.in_code = False
            return
        if self.in_code:
            self.code.append(line); self._stream_code(line)
        else:
            print(_prose(line))

    def _open(self):
        """Provisional top border so a streaming code block is visible immediately."""
        lang = self.lang or "code"
        inner = max(10, min(self._cols(), 80) - 2)
        sys.stdout.write(f"{DIM}┌─ {lang} " + "─" * max(0, inner - len(lang) - 3) + f"{RESET}\n")
        sys.stdout.flush()
        self.plain_rows = 1

    def _stream_code(self, cl):
        """Print one code line live, plain (no number — count isn't known yet)."""
        sys.stdout.write(f"{DIM}│{RESET} {cl}\n"); sys.stdout.flush()
        self.plain_rows += max(1, math.ceil(len("│ " + cl) / self._cols()))

    def _flush(self):
        rows, self.plain_rows = self.plain_rows, 0
        inner = max(10, min(self._cols(), 80) - 2)
        height = shutil.get_terminal_size((80, 24)).lines
        if rows and rows < height - 1:        # safe to erase the plain stream and redraw
            sys.stdout.write(f"\033[{rows}A\r\033[J")
            lang = self.lang or "code"
            numw = max(2, len(str(len(self.code))))
            print(f"{DIM}┌─ {lang} " + "─" * max(0, inner - len(lang) - 3) + RESET)
            for i, cl in enumerate(self.code, 1):
                print(f"{DIM}{str(i).rjust(numw)} │{RESET} {cl}")
            print(f"{DIM}└" + "─" * inner + RESET)
        else:                                 # taller than the viewport — keep the plain
            print(f"{DIM}└" + "─" * inner + RESET)  # stream, just close the box (no numbers)

    def finalize(self):
        if not self.tty:
            return
        if self.buf:
            if self.buf.lstrip().startswith("```"):   # trailing close fence, no newline
                self.buf = ""
            elif self.in_code:
                self.code.append(self.buf); self._stream_code(self.buf); self.buf = ""
            else:
                print(_prose(self.buf), end=""); self.buf = ""
        if self.in_code:
            self._flush(); self.in_code = False


def _collapse_think(think_buf, t0):
    """Erase the live-streamed thinking block and leave a one-line summary."""
    n = len("".join(think_buf))
    summary = f"{DIM}▸ thought {time.monotonic() - t0:.1f}s, {n} chars · /think to expand{RESET}"
    if not sys.stdout.isatty():           # piped: can't erase — just newline off the thinking
        sys.stdout.write(f"{RESET}\n{summary}\n")
        return
    width = shutil.get_terminal_size((80, 24)).columns
    visible = "[think] " + "".join(think_buf)
    rows = sum(max(1, math.ceil(len(l) / width)) for l in visible.split("\n"))
    sys.stdout.write(RESET)
    if rows > 1:
        sys.stdout.write(f"\033[{rows - 1}A")  # up to the block's first row
    sys.stdout.write(f"\r\033[J{summary}\n")   # wipe region, drop the summary


# --- MCP client + MemoryOS ambient memory ----------------------------------------
# Minimal streamable-HTTP MCP client (JSON-RPC: initialize → tools/list → tools/call).
# MemoryOS is a shared, network memory service (not app-specific); input is one client of
# it. Used AMBIENTLY: recall relevant memories before each turn (injected as per-turn
# volatile context, cache-safe via the SAINT sentinel) and store each exchange after; the
# user profile (stable) rides in the system prompt. The same client will serve other MCP
# servers (e.g. Brave web search) later.
class MCPClient:
    def __init__(self, url, timeout=6):
        self.url, self.timeout = url, timeout
        self.sid, self.tools = None, []

    def _rpc(self, method, params=None, notify=False):
        p = {"jsonrpc": "2.0", "method": method}
        if not notify:
            p["id"] = os.urandom(8).hex()
        if params is not None:
            p["params"] = params
        h = {"Content-Type": "application/json", "Accept": "application/json, text/event-stream"}
        if self.sid:
            h["Mcp-Session-Id"] = self.sid
        req = urllib.request.Request(self.url, json.dumps(p).encode(), h)
        r = urllib.request.urlopen(req, timeout=self.timeout)
        self.sid = r.headers.get("Mcp-Session-Id") or self.sid
        if notify:
            return None
        body = r.read().decode()
        if "text/event-stream" in r.headers.get("Content-Type", ""):
            out = None
            for ln in body.splitlines():
                if ln.startswith("data: "):
                    o = json.loads(ln[6:])
                    if "result" in o or "error" in o:
                        out = o
            return out
        return json.loads(body)

    def connect(self):
        init = self._rpc("initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                                        "clientInfo": {"name": "input", "version": "2.1"}})
        if not init or "result" not in init:
            raise RuntimeError("initialize failed")
        self._rpc("notifications/initialized", notify=True)
        self.tools = (self._rpc("tools/list", {}) or {}).get("result", {}).get("tools", [])
        return self

    def call(self, name, arguments):
        res = self._rpc("tools/call", {"name": name, "arguments": arguments})
        if not res or "result" not in res:
            raise RuntimeError((res or {}).get("error", "call failed"))
        return "\n".join(c.get("text", "") for c in res["result"].get("content", [])
                         if c.get("type") == "text")


_MCP_CLIENTS = {}      # url -> connected MCPClient (shared pool)


def mcp_servers():
    """Configured MCP servers as {name, url, source}. source 'added' = input settings.json
    (mcp_servers); 'discovered' = scanned from ~/.claude.json. HTTP servers only (the
    client speaks streamable HTTP). Added take precedence over discovered on url clash."""
    seen, out = set(), []
    for s in load_settings().get("mcp_servers", []):
        if s.get("url") and s["url"] not in seen:
            out.append({"name": s.get("name") or s["url"], "url": s["url"], "source": "added"})
            seen.add(s["url"])
    try:
        d = json.load(open(os.path.expanduser("~/.claude.json")))
        for name, cfg in (d.get("mcpServers") or {}).items():
            u = cfg.get("url")
            if u and cfg.get("type", "http") == "http" and u not in seen:
                out.append({"name": name, "url": u, "source": "discovered"})
                seen.add(u)
    except Exception:
        pass
    return out


def mcp_client(url, timeout=5):
    """Get/create a pooled MCP client for url (raises on connect failure)."""
    c = _MCP_CLIENTS.get(url)
    if c is None:
        c = MCPClient(url, timeout=timeout).connect()
        _MCP_CLIENTS[url] = c
    return c


def register_mcp_server(s):
    """Connect one server and register its tools DISABLED by default. Returns tool count."""
    client = mcp_client(s["url"])
    n = 0
    for tdef in client.tools:
        tname = tdef["name"]
        if tname in TOOLS:                        # avoid clobbering a built-in / other server
            tname = f"{s['name']}_{tname}"
        def _run(args, _c=client, _t=tdef["name"]):
            return _c.call(_t, args)
        register(Tool(tname, tdef.get("description", ""),
                      tdef.get("inputSchema") or {"type": "object", "properties": {}},
                      _run, source=f"mcp:{s['name']}·{s['source']}", default_enabled=False))
        n += 1
    return n


def load_mcp_tools():
    """Auto-register tools from every configured MCP server (disabled by default)."""
    for s in mcp_servers():
        try:
            register_mcp_server(s)
        except Exception as e:
            print(f"{DIM}(mcp {s['name']} unreachable: {e}){RESET}")


