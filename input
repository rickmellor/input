    profile = prof.get("user_profile") if isinstance(prof, dict) else None
    print(f"{BOLD}{ULINE}MemoryOS · {cfg['user']}{RESET}  {DIM}(query: {query}){RESET}")
    print(f"{DIM}profile:{RESET} " + (profile if profile and profile != "None"
                                      else f"{DIM}(none yet — builds as extraction runs){RESET}"))
    hist = d.get("short_term_history") or []
