def _plan_tag(pid=None, width=28):
    """Short plan label for the prompt: the plan title (or id), ellipsized — so you can see
    WHICH plan is loaded/being built at a glance ('plan▸NOVA Stack >')."""
    name = PLAN_GOAL or PLAN_ID or pid or ""
