                cur = os.environ.get("INPUT_LOCATION") or st.get("location")
                env = " (from $INPUT_LOCATION)" if os.environ.get("INPUT_LOCATION") else ""
                print(f"location: {cur}{env}" if cur else
                      "(no location set — /location <city, state zip>, or /location clear)")
            continue
        if user == "/clear":
            history.clear(); thinks.clear()
            SESSION = "input-" + os.urandom(6).hex()   # fresh conversation → fresh affinity
            print("(history cleared)"); continue
        _turn(history, thinks, user, stats)
        print(_status_line(stats))


# --- arg parsing ----------------------------------------------------------------
argv = sys.argv[1:]
MODE, task_words = None, None
for flag in ("-e", "-x", "--goal", "--auto", "--gen"):
    if flag in argv:
        i = argv.index(flag)
        MODE, task_words, argv = flag, argv[i + 1:], argv[:i]
        break

if argv and argv[0] in SEATS:
    MODEL, BASE = SEATS[argv[0]]
elif argv:
    MODEL, BASE = argv[0], (argv[1] if len(argv) > 1 else "http://127.0.0.1:8002/v1")
elif MODE in ("-e", "-x", "--goal", "--auto", "--gen"):
    MODEL, BASE = SEATS["coder"]     # command/goal work → coder seat
else:
    MODEL, BASE = SEATS[load_default_seat() or "gemma"]   # chat → saved default (else gemma)


def _task():
    t = " ".join(task_words)
    if t:
        return t
    if MODE == "--gen":
        sys.exit("usage: input --gen <buffer text>")
    try:
        return input("task: ").strip()
    except (EOFError, KeyboardInterrupt):
        sys.exit(130)


if MODE == "--gen":
    sys.stdout.write(generate(_task()))
elif MODE in ("-e", "-x"):
    sys.exit(shell_mode(_task(), auto=(MODE == "-x")))
elif MODE in ("--goal", "--auto"):
    sys.exit(goal_mode(_task(), auto=(MODE == "--auto")))
else:
    repl()
