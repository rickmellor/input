# The chat system prompt is a user-editable template at ~/.config/input/system.md.
# {{tokens}} substitute fresh at send time; unknown {{tokens}} and literal braces in the
# body are left untouched. Absent/empty file → "{{stable}}".
#
# CACHING: SAINT breakpoints the FIRST system message (saint/backends.py); a system
# prefix that changes every turn invalidates the whole cached prefix (system + history)
# once a chat crosses cache.prompt_cache_min_chars — and also defeats local prefix reuse
# (vLLM APC / llama.cpp). So the default {{stable}} carries only session-stable grounding
# (date at day resolution + location) — no minute clock. {{time}}/{{datetime}} are
# available for users who want a live clock in the prompt, at that cache cost. Live
# minute-time on demand is a job for the get_current_time tool (v2.1), not the prefix.
# Shell/goal modes keep the full-resolution ground_text() (single-shot, no cache to protect).
_SYSTEM_TMPL = os.path.expanduser("~/.config/input/system.md")


def stable_context():
    """Session-stable grounding for the system prefix — no minute clock, so SAINT's
    system breakpoint and local prefix reuse stay warm across turns."""
    s = "Today is " + datetime.now().astimezone().strftime("%A, %Y-%m-%d") + "."
    loc = os.environ.get("INPUT_LOCATION") or load_settings().get("location")
    if loc:
        s += f" You are assisting a user located in {loc}."
    return s


def _tokens():
    now = datetime.now().astimezone()
    loc = os.environ.get("INPUT_LOCATION") or load_settings().get("location") or ""
    return {"stable": stable_context(), "grounding": ground_text(),
            "datetime": now.strftime("%A, %Y-%m-%d %H:%M %Z (%z)"),
            "date": now.strftime("%A, %Y-%m-%d"), "time": now.strftime("%H:%M %Z"),
            "tz": now.strftime("%Z"), "location": loc,
            "cwd": os.getcwd(), "os": platform.system(), "shell": SHELL}


