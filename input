def _inline(s):
    """Render inline markdown: `code`, **bold**, *italic*, ~~strike~~."""
    s = re.sub(r"`([^`]+)`", lambda m: f"{CODE_FG}{m.group(1)}{RESET}", s)  # code first (protects)
    s = re.sub(r"\*\*([^*]+)\*\*|__([^_]+)__",
               lambda m: f"{BOLD}{m.group(1) or m.group(2)}{RESET}", s)
    s = re.sub(r"~~([^~]+)~~", lambda m: f"\033[9m{m.group(1)}{RESET}", s)
    s = re.sub(r"(?<![\*\w])\*([^*\s][^*]*?)\*(?!\w)", lambda m: f"{ITAL}{m.group(1)}{RESET}", s)
    s = re.sub(r"(?<![_\w])_([^_\s][^_]*?)_(?!\w)", lambda m: f"{ITAL}{m.group(1)}{RESET}", s)
    return s


def _vlen(s):
    """Visible width: characters minus ANSI SGR escapes (for cursor math)."""
    return len(re.sub(r"\033\[[0-9;]*m", "", s))


def _prose(line):
    """Format one non-code line of markdown for the terminal."""
    h = re.match(r"^(#{1,6})\s+(.*)", line)
    if h:
        return f"{BOLD}{ULINE}{_inline(h.group(2))}{RESET}"
    b = re.match(r"^(\s*)[-*+]\s+(.*)", line)
    if b:
        return f"{b.group(1)}{DIM}•{RESET} {_inline(b.group(2))}"
    return _inline(line)


class MDRender:
    """Line-buffered streaming renderer: prose formatted; ```fenced``` blocks stream
    plain (top border + gutter, live) then redraw boxed + line-numbered on close, so a
    long code generation shows progress instead of a frozen gap while it buffers."""
    def __init__(self):
        self.tty = sys.stdout.isatty()
        self.buf, self.in_code, self.lang, self.code = "", False, "", []
        self.plain_rows = 0                   # terminal rows drawn for the in-progress block

    def _cols(self):
        return shutil.get_terminal_size((80, 24)).columns

    def feed(self, text):
        if not self.tty:                      # piped: keep it raw
            sys.stdout.write(text); sys.stdout.flush(); return
        self.buf += text
        while "\n" in self.buf:
            line, self.buf = self.buf.split("\n", 1)
            self._line(line)

    def _line(self, line):
        if line.lstrip().startswith("```"):
            if not self.in_code:
                self.in_code, self.lang, self.code = True, line.lstrip()[3:].strip(), []
                self._open()
            else:
                self._flush(); self.in_code = False
            return
        if self.in_code:
            self.code.append(line); self._stream_code(line)
        else:
            print(_prose(line))

    def _open(self):
        """Provisional top border so a streaming code block is visible immediately."""
        lang = self.lang or "code"
        inner = max(10, min(self._cols(), 80) - 2)
        sys.stdout.write(f"{DIM}┌─ {lang} " + "─" * max(0, inner - len(lang) - 3) + f"{RESET}\n")
        sys.stdout.flush()
        self.plain_rows = 1

    def _stream_code(self, cl):
        """Print one code line live, plain (no number — count isn't known yet)."""
        sys.stdout.write(f"{DIM}│{RESET} {cl}\n"); sys.stdout.flush()
        self.plain_rows += max(1, math.ceil(len("│ " + cl) / self._cols()))

    def _flush(self):
        rows, self.plain_rows = self.plain_rows, 0
        inner = max(10, min(self._cols(), 80) - 2)
        height = shutil.get_terminal_size((80, 24)).lines
        if rows and rows < height - 1:        # safe to erase the plain stream and redraw
            sys.stdout.write(f"\033[{rows}A\r\033[J")
            lang = self.lang or "code"
            numw = max(2, len(str(len(self.code))))
            print(f"{DIM}┌─ {lang} " + "─" * max(0, inner - len(lang) - 3) + RESET)
            for i, cl in enumerate(self.code, 1):
                print(f"{DIM}{str(i).rjust(numw)} │{RESET} {cl}")
            print(f"{DIM}└" + "─" * inner + RESET)
        else:                                 # taller than the viewport — keep the plain
            print(f"{DIM}└" + "─" * inner + RESET)  # stream, just close the box (no numbers)

    def finalize(self):
        if not self.tty:
            return
        if self.buf:
            if self.buf.lstrip().startswith("```"):   # trailing close fence, no newline
                self.buf = ""
            elif self.in_code:
                self.code.append(self.buf); self._stream_code(self.buf); self.buf = ""
            else:
                print(_prose(self.buf), end=""); self.buf = ""
        if self.in_code:
            self._flush(); self.in_code = False


def _collapse_think(think_buf, t0):
    """Erase the live-streamed thinking block and leave a one-line summary."""
    n = len("".join(think_buf))
    summary = f"{DIM}▸ thought {time.monotonic() - t0:.1f}s, {n} chars · /think to expand{RESET}"
    if not sys.stdout.isatty():           # piped: can't erase — just newline off the thinking
        sys.stdout.write(f"{RESET}\n{summary}\n")
        return
    width = shutil.get_terminal_size((80, 24)).columns
    visible = "[think] " + "".join(think_buf)
    rows = sum(max(1, math.ceil(len(l) / width)) for l in visible.split("\n"))
    sys.stdout.write(RESET)
    if rows > 1:
        sys.stdout.write(f"\033[{rows - 1}A")  # up to the block's first row
    sys.stdout.write(f"\r\033[J{summary}\n")   # wipe region, drop the summary


# --- MCP client + MemoryOS ambient memory ----------------------------------------
# Minimal streamable-HTTP MCP client (JSON-RPC: initialize → tools/list → tools/call).
# MemoryOS is a shared, network memory service (not app-specific); input is one client of
# it. Used AMBIENTLY: recall relevant memories before each turn (injected as per-turn
# volatile context, cache-safe via the SAINT sentinel) and store each exchange after; the
# user profile (stable) rides in the system prompt. The same client will serve other MCP
# servers (e.g. Brave web search) later.
class MCPClient:
    def __init__(self, url, timeout=6):
        self.url, self.timeout = url, timeout
        self.sid, self.tools = None, []

    def _rpc(self, method, params=None, notify=False):
        p = {"jsonrpc": "2.0", "method": method}
        if not notify:
            p["id"] = os.urandom(8).hex()
        if params is not None:
            p["params"] = params
        h = {"Content-Type": "application/json", "Accept": "application/json, text/event-stream"}
        if self.sid:
            h["Mcp-Session-Id"] = self.sid
        req = urllib.request.Request(self.url, json.dumps(p).encode(), h)
        r = urllib.request.urlopen(req, timeout=self.timeout)
        self.sid = r.headers.get("Mcp-Session-Id") or self.sid
        if notify:
            return None
        body = r.read().decode()
        if "text/event-stream" in r.headers.get("Content-Type", ""):
            out = None
            for ln in body.splitlines():
                if ln.startswith("data: "):
                    o = json.loads(ln[6:])
                    if "result" in o or "error" in o:
                        out = o
            return out
        return json.loads(body)

    def connect(self):
        init = self._rpc("initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                                        "clientInfo": {"name": "input", "version": "2.1"}})
        if not init or "result" not in init:
            raise RuntimeError("initialize failed")
        self._rpc("notifications/initialized", notify=True)
        self.tools = (self._rpc("tools/list", {}) or {}).get("result", {}).get("tools", [])
        return self

    def call(self, name, arguments):
        try:
            res = self._rpc("tools/call", {"name": name, "arguments": arguments})
        except urllib.error.HTTPError as e:
            # 404/400 with a session id = the server forgot our session (it restarted / expired it):
            # re-initialize transparently and retry once instead of failing every call until /mcp reconnect.
            if e.code in (400, 404) and self.sid:
                self.sid = None
                self.connect()
                res = self._rpc("tools/call", {"name": name, "arguments": arguments})
            else:
                raise
        if not res or "result" not in res:
            raise RuntimeError((res or {}).get("error", "call failed"))
        return "\n".join(c.get("text", "") for c in res["result"].get("content", [])
                         if c.get("type") == "text")


class StdioMCPClient:
    """MCP over stdio: spawn the server process and speak newline-delimited JSON-RPC on its
    stdin/stdout (the MCP stdio transport; what `claude mcp add <name> -- <cmd>` registers
    and what most local servers, e.g. aco's `python -m aco.mcp`, implement). Same
    connect()/call()/tools surface as the HTTP client."""

    def __init__(self, command, cwd=None, env=None, timeout=600):
        self.command = list(command)
        self.cwd = os.path.expanduser(cwd) if cwd else None
        self.env = {**os.environ, **{k: str(v) for k, v in (env or {}).items()}}
        self.timeout, self.tools, self.proc = timeout, [], None
        self._lock = threading.Lock()

    def _start(self):
        if self.proc is None or self.proc.poll() is not None:
            self.proc = subprocess.Popen(self.command, cwd=self.cwd, env=self.env,
                                         stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                         stderr=subprocess.DEVNULL, text=True, bufsize=1)

    def _rpc(self, method, params=None, notify=False):
        self._start()
        p = {"jsonrpc": "2.0", "method": method}
        if not notify:
            p["id"] = os.urandom(8).hex()
        if params is not None:
            p["params"] = params
        with self._lock:
            self.proc.stdin.write(json.dumps(p) + "\n"); self.proc.stdin.flush()
            if notify:
                return None
            deadline = time.time() + self.timeout
            while time.time() < deadline:
                line = self.proc.stdout.readline()
                if not line:
                    raise RuntimeError(f"mcp server exited: {self.command[0]}")
                try:
                    o = json.loads(line)
                except Exception:
                    continue                       # non-protocol chatter on stdout
                if o.get("id") == p["id"]:
                    return o
            raise RuntimeError("mcp stdio timeout")

    def connect(self):
        init = self._rpc("initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                                        "clientInfo": {"name": "input", "version": "2.1"}})
        if not init or "result" not in init:
            raise RuntimeError("initialize failed")
        self._rpc("notifications/initialized", notify=True)
        self.tools = (self._rpc("tools/list", {}) or {}).get("result", {}).get("tools", [])
        return self

    def call(self, name, arguments):
        res = self._rpc("tools/call", {"name": name, "arguments": arguments})
        if not res or "result" not in res:
            raise RuntimeError((res or {}).get("error", "call failed"))
        return "\n".join(c.get("text", "") for c in res["result"].get("content", [])
                         if c.get("type") == "text")


def _server_key(s):
    """Pool key for a server entry: its url (http) or its command line (stdio)."""
    return s.get("url") or " ".join(s.get("command") or [])


_MCP_CLIENTS = {}      # server key -> connected client (shared pool)


def _norm_url(u):
    return (u or "").rstrip("/")


def mcp_claims():
    """MCP servers consumed directly by an input subsystem, so their tools must NOT be
    re-exposed to the model. Maps normalized url -> owner label. Extend as subsystems grow;
    today the ambient memory layer claims the Astoria MCP server (memory_url) — the model
    gets the small built-in `memory` tool instead of the full MCP surface."""
    claims = {}
    cfg = mem_config()
    if cfg["enabled"]:
        claims[_norm_url(cfg["url"])] = "ambient memory"
    return claims


def mcp_suppression(s, tool=None):
    """Why this MCP server (or one server:tool) is kept out of the model tool set, or ''.
    Whole-server: claimed by a subsystem, or excluded by name/url via `mcp_exclude`.
    Per-tool: excluded via a `server:tool` entry. Matchers in `mcp_exclude` are any of
    '<server>', '<url>', or '<server>:<tool>'."""
    claim = mcp_claims().get(_norm_url(s.get("url", "")))
    if claim:
        return f"claimed by {claim}"
    ex = load_settings().get("mcp_exclude") or []
    keys = {s["name"], _norm_url(_server_key(s))}
    if tool is not None:
        keys.add(f"{s['name']}:{tool}")
    return "excluded" if keys & set(ex) else ""


def mcp_servers():
    """Configured MCP servers as {name, url, source}. source 'added' = input settings.json
    (mcp_servers); 'discovered' = scanned from ~/.claude.json. HTTP servers only (the
    client speaks streamable HTTP). Added take precedence over discovered on url clash."""
    seen, out = set(), []

    def _add(name, cfg, source):
        e = {"name": name, "source": source}
        if cfg.get("url"):
            e["url"] = cfg["url"]
        elif cfg.get("command"):                  # stdio: command (+args), optional cwd/env
            cmd = cfg["command"]
            cmd = [cmd] if isinstance(cmd, str) else list(cmd)
            e["command"] = cmd + [str(a) for a in (cfg.get("args") or [])]
            if cfg.get("cwd"):
                e["cwd"] = cfg["cwd"]
            if cfg.get("env"):
                e["env"] = dict(cfg["env"])
        else:
            return
        k = _server_key(e)
        if k in seen:
            return
        seen.add(k); out.append(e)

    for s in load_settings().get("mcp_servers", []):
        _add(s.get("name") or _server_key(s), s, "added")
    try:
        d = json.load(open(os.path.expanduser("~/.claude.json")))
        for name, cfg in (d.get("mcpServers") or {}).items():
            t = cfg.get("type") or ("stdio" if cfg.get("command") else "http")
            if t in ("http", "stdio"):
                _add(name, cfg, "discovered")
    except Exception:
        pass
    return out


def mcp_client(server, timeout=5):
    """Get/create a pooled MCP client for a server entry (dict with url | command) or a
    bare http url string (raises on connect failure)."""
    s = {"url": server} if isinstance(server, str) else server
    key = _server_key(s)
    c = _MCP_CLIENTS.get(key)
    if c is None:
        if s.get("url"):
            c = MCPClient(s["url"], timeout=timeout).connect()
        else:
            c = StdioMCPClient(s["command"], cwd=s.get("cwd"), env=s.get("env")).connect()
        _MCP_CLIENTS[key] = c
    return c


def register_mcp_server(s):
    """Connect one server and register its non-suppressed tools DISABLED by default.
    Returns the count registered (0 if the whole server is claimed/excluded). Individual
    tools matched by an `mcp_exclude` `server:tool` entry are skipped."""
    if mcp_suppression(s):                         # whole server claimed or excluded
        return 0
    client = mcp_client(s)
    n = 0
    for tdef in client.tools:
        tname = tdef["name"]
        if mcp_suppression(s, tname):              # per-tool exclusion
            continue
        rname = f"{s['name']}_{tname}" if tname in TOOLS else tname   # avoid clobbering
        def _run(args, _c=client, _t=tname):
            return _c.call(_t, args)
        register(Tool(rname, tdef.get("description", ""),
                      tdef.get("inputSchema") or {"type": "object", "properties": {}},
                      _run, source=f"mcp:{s['name']}·{s['source']}", default_enabled=False))
        n += 1
    return n


def load_mcp_tools():
    """Auto-register tools from every configured MCP server (disabled by default). Servers
    claimed by a subsystem, or hidden via `mcp_exclude`, are skipped (see `mcp_suppression`;
    `/mcp` shows the reason)."""
    for s in mcp_servers():
        if mcp_suppression(s):
            continue
        try:
            register_mcp_server(s)
        except Exception as e:
            print(f"{DIM}(mcp {s['name']} unreachable: {e}){RESET}")


def apply_tools_state():
    """Set each tool's enabled flag from settings `tools_state` (else its default)."""
    st = load_settings()
    state = dict(st.get("tools_state", {}))
    for n in st.get("tools_disabled", []):        # migrate legacy list → state
        state.setdefault(n, False)
    for n, t in TOOLS.items():
        t.enabled = state.get(n, t.default_enabled)


def reload_mcp_tools():
    """Rebuild the MCP-sourced tool set after a claim / `mcp_exclude` change."""
    for n in [n for n, t in list(TOOLS.items()) if t.source.startswith("mcp:")]:
        del TOOLS[n]
    load_mcp_tools()
    apply_tools_state()


# ---- MegaPlan client: direct tool calls for the /megaplan management commands --------

def _megaplan_url():
    for s in mcp_servers():
        if s.get("name") == "megaplan":
            return s["url"]
    return None


def megaplan_call(action, **args):
    """Call the `megaplan` MCP tool directly (deterministic; no model round-trip).
    Returns the parsed dict/list, or {"error": ...}."""
    url = _megaplan_url()
    if not url:
        return {"error": "no megaplan server configured — /mcp add megaplan <url>"}
    try:
        out = mcp_client(url).call(
            "megaplan", {"action": action, **{k: v for k, v in args.items() if v not in (None, "")}})
        d = json.loads(out) if isinstance(out, str) and out.strip() else (out or {})
        return d.get("result", d) if isinstance(d, dict) and set(d) == {"result"} else d
    except Exception as e:
        return {"error": str(e)}


def _reopen_plan(pid):
    """Reopen a completed plan for a re-run: mark every done task not-done and set the plan
    status back to active. Returns (ok, message)."""
    p = megaplan_call("get", id=pid)
    if isinstance(p, dict) and "error" in p:
        return False, p["error"]
    n = 0
    for t in p.get("tasks") or []:
        if t.get("done"):
            r = megaplan_call("update_task", id=pid, task_id=t["id"], done=False)
            if isinstance(r, dict) and "error" in r:
                return False, f"task {t.get('id')}: {r['error']}"
            n += 1
    r = megaplan_call("update", id=pid, status="active")
    if isinstance(r, dict) and "error" in r:
        return False, r["error"]
    return True, f"reopened {n} task(s), status → active"


_PRIO_MARK = {"critical": "‼", "high": "↑", "medium": "·", "low": "↓"}


def plan_browse(_arg=""):
    """Print all plans as a compact table (a direct `list` call)."""
    rows = megaplan_call("list")
    if isinstance(rows, dict) and "error" in rows:
        print(f"{DIM}megaplan: {rows['error']}{RESET}"); return
    if not rows:
        print(f"{DIM}no plans yet — /megaplan <goal> to start one{RESET}"); return
    for p in rows:
        pr = p.get("progress") or {}
        pct = f"{pr.get('pct', 0):>3}%" if pr.get("total") else "  —"
        mark = _PRIO_MARK.get(p.get("priority"), "·")
        print(f"{DIM}  {mark} {p['id']:<34} {p.get('status', ''):<8} {pct}  {p.get('title', '')}{RESET}")


def plan_pick(verb="select", editable=False):
    """Show the plan list and arrow-select one. Returns the chosen plan id, or None
    (empty store / cancel / error). When editable, Tab returns ('edit', id) so the caller
    can hand the command line back pre-filled. Off-TTY, falls back to _pick's numbered prompt."""
    rows = megaplan_call("list")
    if isinstance(rows, dict) and "error" in rows:
        print(f"{DIM}megaplan: {rows['error']}{RESET}"); return None
    if not rows:
        print(f"{DIM}no plans yet — /megaplan <goal> to start one{RESET}"); return None
    labels = []
    for p in rows:
        pr = p.get("progress") or {}
        pct = f"{pr.get('pct', 0):>3}%" if pr.get("total") else "  —"
        mark = _PRIO_MARK.get(p.get("priority"), "·")
        labels.append(f"{mark} {p.get('status', ''):<8} {pct}  {p.get('title', '')}"
                      f"  {DIM}[{p['id']}]{RESET}")
    hint = f"↑/↓ or j/k · enter {verb}" + (" · tab edit on command line" if editable else "") + " · q cancel"
    res = _pick(labels, 0, hint=hint, allow_edit=editable)
    if not res:
        return None
    pid = rows[res[0]]["id"]
    return ("edit", pid) if res[1] == "edit" else pid


def task_pick(p, verb="select", only=None, editable=False):
    """Arrow-pick one task of plan dict `p` (only=None|"open"|"done" filters). Returns the task id,
    ('edit', tid) on Tab when editable, or None. Cursor starts on the first open task."""
    tasks = [t for t in (p.get("tasks") or [])
             if only is None or (only == "done") == bool(t.get("done"))]
    if not tasks:
        print(f"{DIM}no {only + ' ' if only else ''}tasks in {p.get('id')}{RESET}"); return None
    idw = max(len(str(t.get("id") or "")) for t in tasks)
    labels = []
    for t in tasks:
        mark = f"{GREEN_BUILD}✔{RESET}" if t.get("done") else (f"{RED_VIVID}⊘{RESET}" if t.get("blocked") else "○")
        text = " ".join(str(t.get("text") or "").split())
        est = f" ({t['est_hours']:g}h)" if t.get("est_hours") else ""
        lab = f"{mark} {DIM}{str(t.get('id')):<{idw}}{RESET}  {text}{est}"
        labels.append(f"{DIM}{lab}{RESET}" if t.get("done") else lab)
    start = next((i for i, t in enumerate(tasks) if not t.get("done")), 0)
    hint = f"↑/↓ or j/k · enter {verb}" + (" · tab edit on command line" if editable else "") + " · q cancel"
    res = _pick(labels, start, hint=hint, allow_edit=editable)
    if not res:
        return None
    tid = str(tasks[res[0]]["id"])
    return ("edit", tid) if res[1] == "edit" else tid


def _task_of(p, tid):
    return next((t for t in (p.get("tasks") or []) if str(t.get("id")) == str(tid)), None)


def _task_line(t, width=100):
    text = " ".join(str(t.get("text") or "").split())
    est = f" ({t['est_hours']:g}h)" if t.get("est_hours") else ""
    mark = f"{GREEN_BUILD}✔{RESET}" if t.get("done") else (f"{RED_VIVID}⊘{RESET}" if t.get("blocked") else "○")
    s = f"{mark} {DIM}{t.get('id')}{RESET}  {text}{est}"
    return s


def _plan_body_sections(body):
    """Split a plan body's markdown into (heading, lines) sections, dropping the H1 title and
    the whole '## Tasks' checklist subtree (rendered structurally elsewhere) plus any stray
    checklist lines / task-id comments."""
    secs, head, buf, skip_lvl = [], "", [], 0
    for ln in (body or "").splitlines():
        m = re.match(r"^(#{1,6})\s+(.*)$", ln)
        if m:
            lvl, text = len(m.group(1)), m.group(2).strip()
            if skip_lvl and lvl > skip_lvl:           # sub-heading inside the Tasks subtree
                continue
            skip_lvl = 0
            if head or buf:
                secs.append((head, buf))
            head, buf = text, []
            if lvl == 1:                              # H1 = the title (already in the header)
                head = ""
            if text.lower() in ("tasks", "task"):
                skip_lvl, head = lvl, ""
                buf = None
            continue
        if buf is None:                               # inside Tasks → drop
            continue
        if re.match(r"^\s*[-*+]\s+\[[ xX]\]\s", ln):    # stray checklist line
            continue
        buf.append(re.sub(r"<!--.*?-->", "", ln).rstrip())
    if buf and (head or buf):
        secs.append((head, buf))
    return [(h, b) for h, b in secs if b is not None and (h or "".join(b).strip())]


def plan_render(p, full=False, body_lines=18):
    """Pretty-print one plan (from a `get`/`review` result): header rule, status line,
    progress bar, the task list with stable ids (✔ done / ○ open / ⊘ blocked, wrapped with a
    hanging indent), then the non-task body sections (capped unless full=True)."""
    import shutil, textwrap
    if isinstance(p, dict) and "plan" in p:              # a review payload
        p = p["plan"]
    if not isinstance(p, dict) or "error" in p:
        msg = p.get("error", "not found") if isinstance(p, dict) else p
        print(f"{DIM}megaplan: {msg}{RESET}"); return
    cols = max(60, min(shutil.get_terminal_size((100, 24)).columns, 120))
    pr = p.get("progress") or {}
    done, total = int(pr.get("done", 0) or 0), int(pr.get("total", 0) or 0)
    pct = pr.get("pct", pr.get("percent"))
    if pct is None:
        pct = round(100 * done / total) if total else 0
    status = str(p.get("status") or "")
    scol = {"done": GREEN_BUILD, "active": BLUE_ELECTRIC, "blocked": RED_VIVID,
            "archived": DIM, "backlog": DIM}.get(status, "")
    pcol = {"critical": RED_VIVID, "high": YEL}.get(str(p.get("priority") or ""), "")
    title = p.get("title") or "(untitled)"
    pid = p.get("id") or ""
    # ── header rule: ━━ Title ━━━━━━━━  [id]
    rule = max(0, cols - len(title) - len(pid) - 8)
    print(f"{BLUE_ELECTRIC}━━ {BOLD}{title}{RESET}{BLUE_ELECTRIC} {'━' * rule}{RESET}  {DIM}[{pid}]{RESET}")
    meta = [f"{scol}{status}{RESET}", f"{pcol}{p.get('priority')}{RESET}"]
    if p.get("tags"):
        meta.append(f"{DIM}tags: {', '.join(map(str, p['tags']))}{RESET}")
    if p.get("depends_on"):
        meta.append(f"{DIM}deps: {', '.join(map(str, p['depends_on']))}{RESET}")
    tm = p.get("time") or {}
    if tm.get("est_hours") or tm.get("spent_hours"):
        meta.append(f"{DIM}time: {tm.get('spent_hours') or 0:g}h / est {tm.get('est_hours') or 0:g}h{RESET}")
    if p.get("updated"):
        meta.append(f"{DIM}updated {str(p['updated'])[:16].replace('T', ' ')}{RESET}")
    print(f"   " + f"{DIM} · {RESET}".join(meta))
    # ── progress bar
    tasks = p.get("tasks") or []
    open_est = sum(float(t.get("est_hours") or 0) for t in tasks if not t.get("done"))
    barw = 30
    fill = round(barw * pct / 100) if total else 0
    bar = f"{GREEN_BUILD}{'█' * fill}{RESET}{DIM}{'░' * (barw - fill)}{RESET}"
    est_txt = f"   {DIM}{open_est:g}h est open{RESET}" if open_est else ""
    print(f"   {bar}  {done}/{total} tasks ({pct}%){est_txt}")
    # ── tasks: "   ✔ t12  text … (12h) @blocked" with hanging indent
    if tasks:
        print()
        idw = max((len(str(t.get("id") or "")) for t in tasks), default=2)
        for t in tasks:
            tid = str(t.get("id") or "")
            if t.get("done"):
                mark, col = "✔", GREEN_BUILD
            elif t.get("blocked"):
                mark, col = "⊘", RED_VIVID
            else:
                mark, col = "○", CODE_FG
            text = " ".join(str(t.get("text") or "").split())
            tail = ""
            if t.get("est_hours"):
                tail += f" ({t['est_hours']:g}h)"
            if t.get("spent_hours"):
                tail += f" [{t['spent_hours']:g}h spent]"
            if t.get("blocked"):
                tail += " @blocked"
            if t.get("depends"):
                tail += f" ← {t['depends']}"
            lead = f"   {col}{mark}{RESET} {DIM}{tid:<{idw}}{RESET}  "
            indent = " " * (3 + 1 + 1 + idw + 2)
            body_col = DIM if t.get("done") else ""
            lines = textwrap.wrap(text + (f"{tail}" if tail else ""), width=max(30, cols - len(indent))) or [""]
            print(f"{lead}{body_col}{lines[0]}{RESET}")
            for ln in lines[1:]:
                print(f"{indent}{body_col}{ln}{RESET}")
    # ── body: non-task sections, wrapped; capped unless full
    secs = _plan_body_sections(p.get("body", ""))
    if secs:
        out = []
        for head, blines in secs:
            if head:
                out.append(f"{BOLD}{head}{RESET}")
            out.extend(_md_wrap(blines, cols - 3))
            out.append("")
        out = [ln for i, ln in enumerate(out) if ln or (i and out[i - 1])]   # collapse blank runs
        while out and not out[-1]:
            out.pop()
        while out and not out[0]:
            out.pop(0)
        shown = out if full or len(out) <= body_lines else out[:body_lines]
        print()
        for ln in shown:
            print(f"   {DIM}{ln}{RESET}" if not ln.startswith(BOLD) else f"   {ln}")
        if shown is not out:
            print(f"   {DIM}… {len(out) - len(shown)} more lines — /megaplan show {pid} full{RESET}")


def _md_wrap(lines, width):
    """Light markdown → terminal lines: paragraphs re-flowed, list items re-flowed with a
    hanging indent (hard-wrapped continuation lines rejoin their item), code/table/quote
    lines kept verbatim, blank lines collapsed to one. **bold** → bold."""
    import textwrap
    out, para, item = [], [], None          # item = (indent_str, [words]) for an open list item

    def emph(t):
        return re.sub(r"\*\*(.+?)\*\*", lambda m: f"{BOLD}{m.group(1)}{RESET}{DIM}", t)

    def flush():
        nonlocal item
        if para:
            out.extend(textwrap.wrap(emph(" ".join(para)), width=width) or [""]); para.clear()
        if item:
            ind, words = item
            out.extend(textwrap.wrap(emph(" ".join(words)), width=width,
                                     subsequent_indent=ind) or [""])
            item = None
    for ln in lines:
        st = ln.strip()
        if not st:
            flush()
            if out and out[-1] != "":
                out.append("")
            continue
        m = re.match(r"^([-*+]|\d+[.)])\s+", st)
        if m:                                         # new list item
            flush()
            item = (" " * len(m.group(0)), [st])
            continue
        if st.startswith(("```", "|", ">")) or ln.startswith("    "):
            flush(); out.append(ln.rstrip()[:width]); continue
        if item is not None:                          # continuation of the open list item
            item[1].append(st)
        else:
            para.append(st)
    flush()
    return out


# --- ambient memory (Astoria on the NAS) -------------------------------------------------
# The ambient layer talks to Astoria's REST surface directly (deterministic, no model
# round-trip): GET /health + /profile on connect, POST /recall before each turn (the server
# pre-renders the `context` block we inject verbatim), POST /capture after each exchange.
# memory_url stays the MCP url (…/mcp/) so mcp_claims() keeps hiding the astoria MCP tools
# from the model while ambient memory is on; the REST base is derived by stripping /mcp/.
_MEM = None            # last /health dict while connected (truthy = on), or None
_MEM_PROFILE = ""      # cached profile narrative (stable → system prompt)
_MEM_FAILS = 0         # consecutive recall/capture failures; trips the layer off at _MEM_TRIP
_MEM_TRIP = 3


def mem_config():
    st = load_settings()
    url = st.get("memory_url", "http://192.168.1.134:8933/mcp/")
    rest = st.get("memory_rest") or re.sub(r"/mcp/?$", "", url.rstrip("/") + "/")
    return {"enabled": st.get("memory", True),
            "url": url,                                    # MCP url (claimed → tools hidden)
            "rest": rest.rstrip("/"),                      # REST base, e.g. http://host:8933
            "user": st.get("memory_user", "rick"),
            "budget": int(st.get("memory_budget", 600)),   # recall max_tokens per turn
            "source": st.get("memory_source", "input"),    # fact `source` / client name
            "token": st.get("memory_token", "")}


def _mem_rest(method, path, body=None, timeout=4):
    """One Astoria REST call (urllib, like megaplan_call but plain HTTP). Returns the parsed
    JSON; raises on transport/HTTP failure (HTTP errors carry the server's {"error"} text)."""
    cfg = mem_config()
    data = json.dumps(body).encode() if body is not None else None
    hdr = {"Accept": "application/json", "X-Astoria-Client": cfg["source"]}
    if data is not None:
        hdr["Content-Type"] = "application/json"
    if cfg["token"]:
        hdr["Authorization"] = "Bearer " + cfg["token"]
    req = urllib.request.Request(cfg["rest"] + path, data=data, headers=hdr, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            raw = r.read()
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read()).get("error") or str(e)
        except Exception:
            msg = str(e)
        raise RuntimeError(f"{e.code}: {msg}") from None
    return json.loads(raw) if raw.strip() else {}


def _mem_try(method, path, body=None, timeout=6):
    """_mem_rest that never raises: returns the result or {"error": ...} (for /memory cmds)."""
    try:
        return _mem_rest(method, path, body, timeout)
    except Exception as e:
        return {"error": str(e)}


def _mem_q(**kw):
    """?k=v query string from the non-empty kwargs."""
    q = {k: v for k, v in kw.items() if v not in (None, "")}
    return ("?" + urllib.parse.urlencode(q)) if q else ""


def mem_connect():
    """Connect Astoria if enabled+reachable (GET /health); cache the profile narrative.
    Returns a status string."""
    global _MEM, _MEM_PROFILE, _MEM_FAILS
    _MEM, _MEM_PROFILE, _MEM_FAILS, cfg = None, "", 0, mem_config()
    if not cfg["enabled"]:
        return "memory off"
    try:
        h = _mem_rest("GET", "/health")
        if not isinstance(h, dict) or h.get("status") not in (None, "ok"):
            raise RuntimeError(f"status {h.get('status') if isinstance(h, dict) else h!r}")
        _MEM = h or {"status": "ok"}
    except Exception as e:
        return f"memory unreachable ({e}) — off this session"
    try:
        p = _mem_rest("GET", "/profile" + _mem_q(user_id=cfg["user"]))
        _MEM_PROFILE = (p.get("narrative") or "").strip() if isinstance(p, dict) else ""
    except Exception:
        _MEM_PROFILE = ""
    return f"memory on · {cfg['user']} @ {cfg['rest']}" + _mem_health_str(_MEM) + \
        ("" if _MEM_PROFILE else " · no profile yet")


def _mem_health_str(h):
    """' · tei ok · llm down (cognify queued)' from a /health dict ('' if it has no detail)."""
    if not isinstance(h, dict):
        return ""
    bits = []
    tei = h.get("tei")
    if isinstance(tei, dict):
        bits.append("tei ok" if tei.get("ok") else "tei down (bm25 only)")
    llm = h.get("llm")
    if isinstance(llm, dict):
        up = bool(llm.get("saint")) or bool(llm.get("fallback"))
        bits.append("llm ok" if up else "llm down (cognify queued)")
    q = h.get("queue")
    if isinstance(q, dict) and (q.get("pending") or q.get("dead")):
        bits.append(f"queue {q.get('pending', 0)} pending" + (f"/{q['dead']} dead" if q.get("dead") else ""))
    return "".join(" · " + b for b in bits)


def _mem_trip(e):
    """Count a failed ambient call; after _MEM_TRIP in a row, drop the layer (one line, no spam)."""
    global _MEM, _MEM_FAILS
    _MEM_FAILS += 1
    if _MEM and _MEM_FAILS >= _MEM_TRIP:
        _MEM = None
        print(f"{DIM}⟐ memory: unreachable ({e}) — off until /memory on{RESET}")


def mem_recall(query):
    """Best-effort compact context block of relevant memories for this turn, or ''.
    Astoria pre-renders the block (`context`); we inject it verbatim."""
    global _MEM_FAILS
    if not _MEM:
        return ""
    cfg = mem_config()
    try:
        d = _mem_rest("POST", "/recall", {
            "user_id": cfg["user"], "query": query, "session_id": SESSION,
            "max_tokens": cfg["budget"], "limit": 8,
            "layers": ["profile", "semantic", "procedural", "episodic"]})
    except Exception as e:
        _mem_trip(e)
        return ""
    _MEM_FAILS = 0
    ctx = d.get("context") if isinstance(d, dict) else None
    return ctx.strip() if isinstance(ctx, str) and ctx.strip() else ""


def mem_store(user_input, agent_response):
    """Best-effort persist of one exchange (kind=turn; the server gates, detects explicit
    corrections, and queues cognify); never raises into the chat loop."""
    global _MEM_FAILS
    if not _MEM or not agent_response:
        return
    cfg = mem_config()
    try:
        d = _mem_rest("POST", "/capture", {
            "user_id": cfg["user"], "kind": "turn", "user_input": user_input,
            "agent_response": agent_response, "source": cfg["source"], "session_id": SESSION})
    except Exception as e:
        _mem_trip(e)
        return
    _MEM_FAILS = 0
    det = d.get("detector") if isinstance(d, dict) else None
    if isinstance(det, dict) and det.get("op"):
        print(f"{DIM}⟐ memory: {det['op']} {det.get('subject', '')} {det.get('predicate', '')}"
              f" → {det.get('value') or '∅'}{RESET}")
        return
    # The regex detector missed, but the text smells like a correction/forget → ask Astoria's LLM
    # target-resolver WHICH fact is meant (one LLM call); execution stays deterministic. Unambiguous
    # plans apply immediately; ambiguous ones are held for `/memory apply` (or `/memory discard`).
    if _mem_correction_hint(user_input):
        _mem_resolve_and_maybe_apply(user_input)


_MEM_HINT_RE = re.compile(r"\b(actually|correction|i meant|instead|no longer|not .{0,40}? ?anymore|forget (about|the|that|my)|"
                          r"delete (the|that|my)|remove (the|that|my)|i (now|moved|switched|changed))\b", re.I)
_MEM_PENDING_PLAN = None


def _mem_correction_hint(text):
    return bool(text) and len(text) >= 8 and bool(_MEM_HINT_RE.search(text))


def _mem_plan_lines(plan):
    out = [f"{plan.get('intent', '?')} — {plan.get('explanation', '')} (conf {plan.get('confidence', 0):.2f})"]
    for t in plan.get("targets") or []:
        out.append(f"  target {str(t.get('id', ''))[:8]} {t.get('subject', '')} {t.get('predicate', '')}: {str(t.get('value', ''))[:70]}")
    nf = plan.get("new_fact")
    if nf:
        out.append(f"  new    {nf.get('subject', '')} {nf.get('predicate', '')}: {str(nf.get('value', ''))[:70]}")
    return out


def _mem_resolve_and_maybe_apply(text):
    global _MEM_PENDING_PLAN
    cfg = mem_config()
    try:
        plan = _mem_rest("POST", "/resolve", {"user_id": cfg["user"], "text": text}, timeout=20)
    except Exception:
        return                                     # LLM down / 503: cognify will catch it later
    if not isinstance(plan, dict) or plan.get("intent") in (None, "none") or plan.get("error"):
        return
    if not plan.get("requires_confirmation"):
        try:
            res = _mem_rest("POST", "/resolve/apply", {"user_id": cfg["user"], "plan": plan}, timeout=20)
        except Exception as e:
            print(f"{DIM}⟐ memory: resolve-apply failed ({e}){RESET}")
            return
        ch = res.get("changed") if isinstance(res, dict) else None
        print(f"{DIM}⟐ memory: {plan.get('intent')} applied — {plan.get('explanation', '')}"
              f"{' · ' + str(len(ch)) + ' fact(s)' if isinstance(ch, list) else ''}{RESET}")
        return
    _MEM_PENDING_PLAN = plan
    print(f"{DIM}⟐ memory: proposed " + "\n   ".join(_mem_plan_lines(plan)) + f"\n   → /memory apply  or  /memory discard{RESET}")


def _mem_apply_pending(arg):
    global _MEM_PENDING_PLAN
    if arg == "discard":
        _MEM_PENDING_PLAN = None
        print("memory: pending plan discarded"); return
    if not _MEM_PENDING_PLAN:
        print("memory: nothing pending"); return
    cfg = mem_config()
    try:
        res = _mem_rest("POST", "/resolve/apply", {"user_id": cfg["user"], "plan": _MEM_PENDING_PLAN}, timeout=20)
    except Exception as e:
        print(f"memory: apply failed: {e}"); return
    _MEM_PENDING_PLAN = None
    print(f"memory: applied {res.get('intent')} — changed {len(res.get('changed') or [])} fact(s)" if isinstance(res, dict) else f"memory: {res}")


def _fact_line(f, ids=True):
    """One compact fact row: `id8 subject predicate: value  [layer · conf · status]`."""
    if not isinstance(f, dict):
        return str(f)
    fid = (str(f.get("id") or ""))[:8]
    conf = f.get("confidence")
    tail = [f.get("layer") or "", f"{conf:.2f}" if isinstance(conf, (int, float)) else "",
            f.get("status") if f.get("status") not in (None, "active") else "",
            f"from {f['valid_from'][:10]}" if f.get("valid_from") else "",
            f"until {f['valid_to'][:10]}" if f.get("valid_to") else "",
            "belief" if f.get("is_belief") else ""]
    tail = " · ".join(t for t in tail if t)
    head = f"{DIM}{fid}{RESET} " if ids and fid else ""
    return (f"{head}{f.get('subject', '')} {f.get('predicate', '')}: {f.get('value', '')}"
            + (f"  {DIM}[{tail}]{RESET}" if tail else ""))


def memory_browse(query):
    """Inspect Astoria for a query: profile narrative, then recalled items grouped by layer
    (short ids + confidence) and the session's working turns."""
    if not _MEM:
        print(f"{DIM}memory off — /memory on to connect{RESET}")
        return
    cfg = mem_config()
    d = _mem_try("POST", "/recall", {
        "user_id": cfg["user"], "query": query, "session_id": SESSION, "include_profile": True,
        "max_tokens": 2000, "limit": 16,
        "layers": ["profile", "semantic", "procedural", "episodic"]})
    if "error" in d:
        print(f"{DIM}memory query failed: {d['error']}{RESET}")
        return
    print(f"{BOLD}{ULINE}Astoria · {cfg['user']}{RESET}  {DIM}(query: {query}){RESET}")
    prof = d.get("profile") or {}
    narrative = (prof.get("narrative") or _MEM_PROFILE or "").strip() if isinstance(prof, dict) else ""
    print(f"{DIM}profile:{RESET} " + (narrative if narrative
                                      else f"{DIM}(none yet — derives as facts accumulate){RESET}"))
    items = d.get("items") or []
    by = {}
    for it in items:
        by.setdefault(it.get("layer") or "other", []).append(it)
    for layer in ("profile", "semantic", "procedural", "episodic", "other"):
        rows = by.get(layer)
        if not rows:
            continue
        print(f"\n{DIM}{layer} ({len(rows)}):{RESET}")
        for it in rows:
            if it.get("kind") == "episode" or not it.get("predicate"):
                when = (it.get("occurred_at") or "")[:10]
                print(f"  {DIM}{(str(it.get('id') or ''))[:8]}{RESET} {DIM}{when}{RESET} "
                      f"{(it.get('text') or '')[:140]}")
            else:
                print("  " + _fact_line(it))
    work = d.get("working") or []
    if work:
        print(f"\n{DIM}this session ({len(work)}):{RESET}")
        for w in work[-4:]:
            print(f"  {DIM}·{RESET} {(w.get('user_input') or '')[:70]} {DIM}→ {(w.get('agent_response') or '')[:60]}{RESET}")
    if not items and not work:
        print(f"{DIM}(no matching memories){RESET}")
    h = d.get("health")
    if isinstance(h, dict) and h.get("degraded"):
        print(f"{DIM}(degraded: TEI down — lexical recall only){RESET}")


def _mem_parse_triple(arg):
    """'<subject> <predicate…> = <value>' → (subject, predicate, value); multi-word predicates
    join with '_' (favorite beer → favorite_beer). value '' when there's no '='."""
    left, _, value = arg.partition("=")
    toks = left.split()
    if len(toks) < 2:
        return None
    return toks[0], "_".join(toks[1:]), value.strip()


def _print_facts(rows, empty="(none)"):
    if isinstance(rows, dict) and "error" in rows:
        print(f"{DIM}memory: {rows['error']}{RESET}"); return
    if not rows:
        print(f"{DIM}{empty}{RESET}"); return
    for f in rows:
        print("  " + _fact_line(f))


def memory_command(arg):
    """The deterministic /memory subcommands beyond on|off|user|browse (all plain REST)."""
    if arg in ("apply", "discard"):
        return _mem_apply_pending(arg)
    cfg = mem_config(); uid = cfg["user"]
    verb, _, rest = arg.partition(" ")
    rest = rest.strip()
    if verb == "health":
        h = _mem_try("GET", "/health")
        if "error" in h:
            print(f"{DIM}memory: {h['error']}{RESET}"); return
        print(f"{DIM}{cfg['rest']} · status {h.get('status')}{_mem_health_str(h)}"
              f"{' · v' + str(h['version']) if h.get('version') else ''}{RESET}")
        return
    if verb == "profile":
        p = _mem_try("GET", "/profile" + _mem_q(user_id=uid))
        if "error" in p:
            print(f"{DIM}memory: {p['error']}{RESET}"); return
        print(f"{BOLD}profile · {uid}{RESET}" + (f"  {DIM}v{p['version']}{RESET}" if p.get("version") else ""))
        print((p.get("narrative") or "").strip() or f"{DIM}(no narrative yet){RESET}")
        if p.get("facts"):
            print(f"{DIM}facts ({len(p['facts'])}):{RESET}")
            _print_facts(p["facts"])
        return
    if verb == "facts":
        q = {"user_id": uid, "limit": 50}
        if rest.startswith("/"):
            q["q"] = rest[1:].strip()
        elif rest:
            q["subject"] = rest
        _print_facts(_mem_try("GET", "/facts" + _mem_q(**q)), "(no facts)")
        return
    if verb == "staging":
        _print_facts(_mem_try("GET", "/facts" + _mem_q(user_id=uid, status="staging", limit=50)),
                     "(nothing staged)")
        return
    if verb in ("correct", "remember"):
        t = _mem_parse_triple(rest)
        if not t or not t[2]:
            print(f"{DIM}usage: /memory {verb} <subject> <predicate> = <value>{RESET}"); return
        path = "/correct" if verb == "correct" else "/facts"
        r = _mem_try("POST", path, {"user_id": uid, "subject": t[0], "predicate": t[1], "value": t[2]})
        if "error" in r:
            print(f"{DIM}memory: {r['error']}{RESET}"); return
        print(f"{DIM}{r.get('action', verb)}:{RESET} " + _fact_line(r.get("fact") or {}))
        if r.get("superseded"):
            print(f"{DIM}  superseded {len(r['superseded'])}: {', '.join(str(s)[:8] for s in r['superseded'])}{RESET}")
        return
    if verb == "retract":
        t = _mem_parse_triple(rest) if "=" in rest else None
        if not t:
            toks = rest.split()
            if len(toks) < 2:
                print(f"{DIM}usage: /memory retract <subject> <predicate> [value]{RESET}"); return
            t = (toks[0], toks[1], " ".join(toks[2:]))
        body = {"user_id": uid, "subject": t[0], "predicate": t[1]}
        if t[2]:
            body["value"] = t[2]
        r = _mem_try("POST", "/retract", body)
        if "error" in r:
            print(f"{DIM}memory: {r['error']}{RESET}"); return
        ids = r.get("retracted") or []
        print(f"{DIM}retracted {len(ids)}: {', '.join(str(i)[:8] for i in ids) or '—'}{RESET}")
        return
    if verb == "forget":
        toks = rest.split()
        if not toks:
            print(f"{DIM}usage: /memory forget <id|query> [hard]{RESET}"); return
        mode = "hard" if toks[-1] == "hard" and len(toks) > 1 else "soft"
        target = " ".join(toks[:-1] if mode == "hard" else toks)
        body = {"user_id": uid, "mode": mode}
        body["fact_id" if re.fullmatch(r"[0-9a-fA-F-]{8,}", target) else "query"] = target
        r = _mem_try("POST", "/forget", body)
        if "error" in r:
            print(f"{DIM}memory: {r['error']}{RESET}"); return
        gone = r.get("forgotten") or []
        print(f"{DIM}forgot ({mode}) {len(gone)}:{RESET}")
        for g in gone:
            print("  " + (_fact_line(g) if isinstance(g, dict) else str(g)[:8]))
        return
    if verb == "approve":
        if not rest:
            print(f"{DIM}usage: /memory approve <id>{RESET}"); return
        r = _mem_try("POST", "/approve", {"user_id": uid, "fact_id": rest})
        if "error" in r:
            print(f"{DIM}memory: {r['error']}{RESET}"); return
        print(f"{DIM}approved:{RESET} " + _fact_line(r.get("fact") or r))
        return
    if verb == "history":
        toks = rest.split()
        if len(toks) < 2:
            print(f"{DIM}usage: /memory history <subject> <predicate>{RESET}"); return
        _print_facts(_mem_try("GET", "/history" + _mem_q(user_id=uid, subject=toks[0], predicate="_".join(toks[1:]))),
                     "(no history)")
        return
    if verb == "as-of":
        toks = rest.split()
        if not toks:
            print(f"{DIM}usage: /memory as-of <date> [subject predicate]{RESET}"); return
        body = {"user_id": uid, "at": toks[0]}
        if len(toks) >= 2:
            body["subject"] = toks[1]
        if len(toks) >= 3:
            body["predicate"] = "_".join(toks[2:])
        _print_facts(_mem_try("POST", "/as_of", body), f"(nothing believed as of {toks[0]})")
        return
    if verb == "why":
        if not rest:
            print(f"{DIM}usage: /memory why <id>{RESET}"); return
        f = _mem_try("GET", f"/facts/{rest}" + _mem_q(user_id=uid))
        if "error" in f:
            print(f"{DIM}memory: {f['error']}{RESET}"); return
        print("  " + _fact_line(f))
        for k in ("source", "source_kind", "confidence", "source_trust", "asserted_at", "valid_from",
                  "valid_to", "origin_episode", "evidence", "tags", "status"):
            if f.get(k) not in (None, "", [], {}):
                print(f"  {DIM}{k:<15}{RESET} {f[k]}")
        if f.get("subject") and f.get("predicate"):
            chain = _mem_try("GET", "/history" + _mem_q(user_id=uid, subject=f["subject"], predicate=f["predicate"]))
            if isinstance(chain, list) and len(chain) > 1:
                print(f"  {DIM}chain ({len(chain)}, newest first):{RESET}")
                for c in chain:
                    mark = "▸" if str(c.get("id")) == str(f.get("id")) else "·"
                    print(f"    {DIM}{mark}{RESET} " + _fact_line(c))
        return
    print(f"{DIM}/memory: unknown subcommand {verb!r} — /help /memory{RESET}")


def _tool_memory(args):
    """The model-facing `memory` tool: the few explicit memory ops (the ambient recall/capture
    loop runs anyway; this is for persisting a user's explicit correction or looking
    something up on purpose). Plain REST — the astoria MCP server stays claimed/hidden."""
    a = args or {}
    act = (a.get("action") or "").strip().lower()
    cfg = mem_config()
    if not cfg["enabled"]:
        return "Error: ambient memory is off (/memory on)"
    uid, sub, pred, val = cfg["user"], (a.get("subject") or "").strip(), (a.get("predicate") or "").strip(), a.get("value")
    val = str(val).strip() if val is not None else ""
    try:
        if act == "recall":
            d = _mem_rest("POST", "/recall", {"user_id": uid, "query": a.get("query") or "", "session_id": SESSION,
                                              "max_tokens": 800, "limit": 10})
            return d.get("context") or "No matching memories."
        if act in ("remember", "correct"):
            if not (sub and pred and val):
                return "Error: remember/correct need subject, predicate, value"
            d = _mem_rest("POST", "/correct" if act == "correct" else "/facts",
                          {"user_id": uid, "subject": sub, "predicate": pred, "value": val})
            f = d.get("fact") or {}
            return (f"{d.get('action', act)}: {f.get('subject')} {f.get('predicate')} = {f.get('value')}"
                    + (f" (superseded {len(d['superseded'])})" if d.get("superseded") else ""))
        if act == "retract":
            if not (sub and pred):
                return "Error: retract needs subject and predicate (value optional)"
            body = {"user_id": uid, "subject": sub, "predicate": pred}
            if val:
                body["value"] = val
            d = _mem_rest("POST", "/retract", body)
            return f"retracted {len(d.get('retracted') or [])} fact(s)"
        if act == "forget":
            body = {"user_id": uid, "mode": "hard" if (a.get("mode") == "hard") else "soft"}
            if a.get("fact_id"):
                body["fact_id"] = a["fact_id"]
            elif a.get("query"):
                body["query"] = a["query"]
            else:
                return "Error: forget needs fact_id or query"
            d = _mem_rest("POST", "/forget", body)
            return f"forgot {len(d.get('forgotten') or [])} fact(s)"
        if act == "facts":
            rows = _mem_rest("GET", "/facts" + _mem_q(user_id=uid, subject=sub, predicate=pred, q=a.get("query"), limit=30))
            return "\n".join(f"{str(f.get('id'))[:8]} {f.get('subject')} {f.get('predicate')}: {f.get('value')} "
                             f"[{f.get('layer')} · {f.get('confidence')}]" for f in rows) or "No facts."
        if act == "history":
            if not (sub and pred):
                return "Error: history needs subject and predicate"
            rows = _mem_rest("GET", "/history" + _mem_q(user_id=uid, subject=sub, predicate=pred))
            return "\n".join(f"{str(f.get('id'))[:8]} {f.get('value')} [{f.get('status')} · from {f.get('valid_from')} "
                             f"to {f.get('valid_to') or 'now'}]" for f in rows) or "No history."
        return f"Error: unknown action {act!r}"
    except Exception as e:
        return f"Error: memory service: {e}"


