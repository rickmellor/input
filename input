def system_prompt(cwd=None):
    """Render the template: substitute known {{tokens}}, leave the rest verbatim; then the
    instruction layer (AGENTS.md stack for cwd + skills index + loaded skills); then any
    mode directive. All session-stable → cache-safe prefix."""
    toks = _tokens()
    s = re.sub(r"\{\{(\w+)\}\}", lambda m: toks.get(m.group(1), m.group(0)),
               load_system_template()).strip()
    il = instruction_layer(cwd)
    if il:
        s = (s + "\n\n" + il) if s else il
    if PERM_MODE == "plan":
        d = _PLAN_DIRECTIVE + (f"\n\nThis session's planning target: {PLAN_GOAL}" if PLAN_GOAL else "")
        s = (s + "\n\n" + d) if s else d
    if BUILD_ID:                              # building (mutually exclusive with plan mode)
        b = _BUILD_DIRECTIVE + f"\n\nBuilding MegaPlan: {BUILD_ID}"
        if PLAN_TASK and PLAN_ID == BUILD_ID:
            b += (f"\n\nSCOPE: work ONLY task {PLAN_TASK} of this plan. When it is done (marked "
                  f"complete), stop and report — do NOT continue to other tasks.")
        s = (s + "\n\n" + b) if s else b
    if GOAL:                                  # exit-criteria contract (stable → cache-safe)
        g = _GOAL_DIRECTIVE.format(goal=GOAL)
        if GOAL_SEAT:                         # goal pinned to the strong/expensive seat → delegate
            g += "\n\n" + _GOAL_DELEGATE
        s = (s + "\n\n" + g) if s else g
    return s


def chat_system():
    """Fresh chat system message from the template, or None if it renders empty."""
    s = system_prompt()
    return {"role": "system", "content": s} if s else None


# --- tool framework --------------------------------------------------------------
# A Tool = name + description + JSON-Schema parameters + run(args:dict) -> str. Built-ins
# register below; user tools auto-load from ~/.config/input/tools/*.py (each file defines
# TOOL, a dict, or TOOLS, a list of them). MCP tools will register the same way later.
# Tools ride the OpenAI tools/tool_calls protocol, which every seat accepts (local + SAINT).
_TOOLS_DIR = os.path.expanduser("~/.config/input/tools")
TOOLS = {}            # name -> Tool
TOOLS_ON = True       # set from settings at REPL start; /tools toggles + persists
MAX_TOOL_ROUNDS = 8   # cap the call→result→call loop so a stuck model can't spin forever
SUBAGENT_MAX_ROUNDS = 200  # sub-agents do real multi-step work; stall detection + budget_tokens are the real guards


class Tool:
    def __init__(self, name, description, parameters, run, source="built-in",
                 confirm="never", display="compact", default_enabled=True):
        self.name, self.description = name, description
        self.parameters, self.run, self.source = parameters, run, source
        self.default_enabled = default_enabled   # MCP tools default OFF; built-ins/user ON
        self.enabled = default_enabled           # per-tool on/off; /tools menu, settings tools_state
        self.confirm = confirm        # gate policy: "never" | "review" | "always" (see _gate)
        self.display = display        # result view: "compact" (one line) | "full" (whole output)

    def schema(self):
        return {"type": "function", "function": {
            "name": self.name, "description": self.description, "parameters": self.parameters}}


def register(tool):
    TOOLS[tool.name] = tool
    return tool


def active_tools():
    """Enabled tool schemas to send with a chat request, or None when off/none enabled."""
    if not TOOLS_ON:
        return None
    return [t.schema() for t in TOOLS.values() if t.enabled] or None


def run_tool_call(tc):
    """Execute one OpenAI tool_call dict; always returns a string (the tool result)."""
    fn = tc.get("function") or {}
    name = fn.get("name")
    try:
        args = json.loads(fn.get("arguments") or "{}")
    except Exception:
        args = {}
    tool = TOOLS.get(name)
    if tool is None:
        return f"Error: no such tool {name!r}"
    try:
        return str(tool.run(args))
    except Exception as e:
        return f"Error running {name}: {e}"


def _confirm():
    try:
        return input("  run? [y]es/[N]o: ").strip().lower() in ("y", "yes")
    except (EOFError, KeyboardInterrupt):
        return False


# --- risk gate policy: how much risk auto-runs before review kicks in ------------------
# gemma rates each command none<low<medium<high<critical. `gate` tolerance = the highest
# level that auto-runs; anything ABOVE it is gated — a confirm prompt in a live turn, a
# block-for-/jobs-answer in a dark job. The catastrophic denylist is a separate hard floor.
_RISK_RANK = {"none": 0, "low": 1, "medium": 2, "high": 3, "critical": 4}
_RISK_LEVELS = ("none", "low", "medium", "high", "critical")


def gate_tolerance(dark=False):
    """The configured auto-run tolerance for live turns (default 'low') or dark jobs."""
    g = load_settings().get("gate") or {}
    lvl = str(g.get("autonomous" if dark else "interactive", "low")).lower()
    return lvl if lvl in _RISK_RANK else "low"


def _over_tolerance(risk, tol):
    """True when a rated risk exceeds the tolerance (unknown/unrated treated as medium)."""
    return _RISK_RANK.get(risk, 2) > _RISK_RANK.get(tol, 1)


def _gate_reviewer(cmd):
    """Unrestricted mode: a reviewer model gates and YOU are never prompted. Only the
    catastrophic denylist and `critical` risk are blocked; everything else (high and below)
    auto-runs. If the reviewer is unreachable, auto-run (the unrestricted contract) — the
    denylist still hard-blocks."""
    if cmd and danger(cmd):
        print(f"{RED}  ⚠ reviewer: catastrophic pattern — blocked{RESET}")
        return False
    if cmd:
        v = review(cmd)
        if v and v[0] == "critical":
            print(f"{RED}  reviewer: critical risk — blocked ({v[1]}){RESET}")
            return False
        print(f"{DIM}  reviewer: {v[0] + ' risk' if v else 'unrated'} — auto-run{RESET}")
    return True


def _gate(policy, cmd):
    """Risk gate for a tool call; prints notes, prompts as needed. Returns True to proceed.
    In `unrestricted` mode a reviewer model decides (no prompts). Otherwise (cautious/plan)
    'review' rates a shell command via gemma (auto-run none/low, YOU confirm the rest); the
    catastrophic denylist always prompts; 'always' confirms every call."""
    if PERM_MODE == "unrestricted":
        return _gate_reviewer(cmd)
    if cmd and danger(cmd):
        print(f"{RED}  ⚠ matches a catastrophic pattern — review carefully{RESET}")
        return _confirm()
    if policy == "review" and cmd:
        v = review(cmd)
        tol = gate_tolerance(dark=False)
        if v and not _over_tolerance(v[0], tol):
            print(f"{DIM}  gemma: {v[0]} risk (≤ {tol}) — auto-run{RESET}")
            return True
        if v:
            print(f"{YEL}  gemma: {v[0]} risk (> {tol}) — {v[1]}{RESET}")
        else:
            print(f"{YEL}  gemma review unavailable — confirm{RESET}")
        return _confirm()
    return _confirm()   # "always", or "review" with no command to rate


def execute_tool(tc):
    """Gate (per the tool's confirm policy) then run one tool call."""
    fn = tc.get("function") or {}
    tool = TOOLS.get(fn.get("name"))
    if tool is not None and getattr(tool, "confirm", "never") != "never":
        try:
            args = json.loads(fn.get("arguments") or "{}")
        except Exception:
            args = {}
        cmd = args.get("command") if isinstance(args, dict) else None
        if not _gate(tool.confirm, cmd):
            return "Declined by the user; not run."
    out = run_tool_call(tc)
    _note_saved(tc, out)
    return out


_JUST_SAVED = ""   # plan id from the most recent successful megaplan save/update this turn


def _note_saved(tc, out):
    """If this call created/updated a plan, remember its id so the REPL can offer to build."""
    global _JUST_SAVED
    fn = tc.get("function") or {}
    if fn.get("name") != "megaplan":
        return
    try:
        args = json.loads(fn.get("arguments") or "{}")
        if (args.get("action") or "").lower() not in ("save", "update"):
            return
        d = json.loads(out) if isinstance(out, str) else out
    except Exception:
        return
    if isinstance(d, dict) and d.get("id") and "error" not in d:
        _JUST_SAVED = d["id"]


def _take_saved():
    global _JUST_SAVED
    v, _JUST_SAVED = _JUST_SAVED, ""
    return v


def load_user_tools():
    import glob, importlib.util
    for path in sorted(glob.glob(os.path.join(_TOOLS_DIR, "*.py"))):
        try:
            spec = importlib.util.spec_from_file_location(
                "input_tool_" + os.path.basename(path)[:-3], path)
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            defs = getattr(mod, "TOOLS", None)
            if defs is None and hasattr(mod, "TOOL"):
                defs = [mod.TOOL]
            for d in defs or []:
                register(Tool(d["name"], d["description"],
                              d.get("parameters", {"type": "object", "properties": {}}),
                              d["run"], source=os.path.basename(path),
                              confirm=d.get("confirm", "never"),
                              display=d.get("display", "compact")))
        except Exception as e:
            print(f"{DIM}(tool load failed: {os.path.basename(path)}: {e}){RESET}")


