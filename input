# --- seats: discovered live from SAINT /status; everything routes through SAINT (:4000) ----
# input carries no static model list — SAINT is the source of truth. It maps out the whole
# fleet (johnny-resolved local seats for the running profile + auto-configured cloud tiers,
# each with context window + price + cost rank); input reflects exactly that.
SAINT_BASE = "http://127.0.0.1:4000/v1"
SAINT_STATUS_URL = "http://127.0.0.1:4000/status"

# Fallback used ONLY when SAINT /status is unreachable — direct-to-johnny locals + the
# router id, so input still works if SAINT is down.
_STATIC_SEATS = {
    "saint": ("saint-auto", SAINT_BASE),
    "chat":  ("gemma-4-26B-A4B-it-FP8-Dynamic", "http://127.0.0.1:8002/v1"),
    "coder": ("qwen-27b-coder",                 "http://127.0.0.1:8003/v1"),
}
SEATS: dict = {}        # name -> (model_id, base_url)
SEAT_META: dict = {}    # name -> {kind, context, price_in, price_out, rank, state, aliases}


def _seat_name(choice):
    """Friendly seat name from a /status choice."""
    kind, backend = choice.get("kind"), choice.get("backend", "")
    if kind == "router":
        return "saint"
    if kind == "local":
        return choice.get("role") or backend.removeprefix("local-") or backend
    return backend          # cloud-* keep their tier name (cloud-small … cloud-flagship)


def discover_seats(timeout=2.5):
    """Populate SEATS + SEAT_META from SAINT /status. Returns True on success; on failure
    the caller keeps the static fallback."""
    try:
        with urllib.request.urlopen(SAINT_STATUS_URL, timeout=timeout) as r:
            data = json.loads(r.read())
    except Exception:
        return False
    seats, meta = {}, {}
    for c in data.get("choices", []):
        name = _seat_name(c)
        seats[name] = (c.get("id"), SAINT_BASE)     # route every seat through SAINT
        meta[name] = {k: c.get(k) for k in
                      ("kind", "context", "price_in", "price_out", "rank", "state",
                       "aliases", "elec_per_mtok", "tok_s")}
    if not seats:
        return False
    SEATS.clear(); SEATS.update(seats)
    SEAT_META.clear(); SEAT_META.update(meta)
    return True


if not discover_seats():
    SEATS.update(_STATIC_SEATS)


def _pick_seat(*names):
    """First of `names` present in SEATS, else the lowest-rank (cheapest) seat, else None."""
    for n in names:
        if n in SEATS:
            return n
    return min(SEATS, key=lambda n: SEAT_META.get(n, {}).get("rank", 0)) if SEATS else None


