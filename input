                jid = submit_job("goal", f"aco review {tgt}", goal, cwd=os.getcwd())
                _JOBS_SEEN[jid] = "queued"
                print(f"{DIM}● job {jid} — ACO review of {tgt} in the background · /jobs show {jid}{RESET}")
            elif sub == "load" and rest:        # pull a job's task + result into THIS session
                jid = rest.split()[0]
