def _id_ctx(text):
    """If the command line is positioned at an <id> argument, return (prefix, partial, ids):
    prefix = text before the id being typed, partial = what's typed of it, ids = matching
    candidates. Else None. Drives Tab-cycle and the Ctrl+Enter id picker in read_line."""
    ends_space = text.endswith(" ")
    toks = text.split()
    if not toks:
        return None
    cmd = toks[0].lower()
    if cmd == "/jobs":
        if len(toks) < 2 or toks[1].lower() not in (
                "show", "log", "tail", "status", "stop", "answer", "load", "rm", "delete", "del"):
            return None
        id_pos, src = 2, (lambda: [str(m.get("id")) for m in list_jobs()])
    elif cmd == "/build":
        id_pos, src = 1, (lambda: [str(p.get("id")) for p in (megaplan_call("list") or [])
                                   if isinstance(p, dict) and p.get("id")])
    elif cmd == "/sidebar" and len(toks) >= 2 and toks[1].lower() == "resume":
        id_pos, src = 2, (lambda: [str(f["id"]) for f in _SB_PAUSED])   # Tab-cycle paused sidebar ids
    else:
        return None
    if len(toks) == id_pos and ends_space:              # cursor at a fresh id slot
        prefix, partial = text, ""
    elif len(toks) == id_pos + 1 and not ends_space:    # mid-typing the id
        prefix, partial = " ".join(toks[:id_pos]) + " ", toks[id_pos]
    else:
        return None
    try:
        ids = [i for i in src() if i.startswith(partial)]
    except Exception:
        return None
    return prefix, partial, ids


_TA_BUF = bytearray()   # type-ahead drained at read_line entry; its newlines SEND (not pick), and
                        # leftover (multiple queued lines) persists across calls so nothing is lost.


def read_line(prompt, preset=""):
    """cbreak line reader: returns (text, mode). mode 'send' on Enter, 'pick' on
    Ctrl+Enter (terminals that send LF), None text with 'eof' on Ctrl-D. Falls back
    to input() off-TTY. Up/down walk readline history; basic cursor editing.
    `preset` pre-fills the buffer (cursor at end) so a command can be handed back editable."""
    if not sys.stdin.isatty():
        try:
            return input(prompt), "send"
        except EOFError:
            return None, "eof"
    import select, termios
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    new = termios.tcgetattr(fd)
    new[3] &= ~(termios.ICANON | termios.ECHO)             # lflag: no line-buffer/echo (ISIG stays)
    new[0] &= ~(termios.ICRNL | termios.INLCR | termios.IGNCR)  # keep CR (Enter) and NL (Ctrl+Enter) distinct
    new[6][termios.VMIN], new[6][termios.VTIME] = 1, 0
    buf, pos = list(preset), len(preset)
    hlen = _rl.get_current_history_length() if _rl else 0
    hidx, saved = hlen, ""
    crow = 0                                   # cursor's row offset from the line's start row
    tabs = {"ids": [], "idx": -1, "prefix": "", "last": None}   # Tab-cycle state for id fields

    def redraw():
        # Wrapping-aware: the prompt+buffer may span several terminal rows. Go up to the
        # block's start, clear to end of screen, rewrite, then reposition the cursor —
        # otherwise a line past the screen width cascades one copy per keystroke.
        # The buffer may also hold literal newlines (a bracketed paste), so rows come from
        # walking the text, not from dividing its length by the width.
        nonlocal crow
        w = max(1, shutil.get_terminal_size((80, 24)).columns)
        plen = _vlen(prompt)

        def rowcol(idx):
            """(row, col) the cursor sits at with `idx` buffer chars written after the prompt."""
            row, col = 0, plen
            for cc in buf[:idx]:
                if cc == "\n":
                    row, col = row + 1, 0
                else:
                    col += 1
                    if col == w:
                        row, col = row + 1, 0
            return row, col

        if crow:
            sys.stdout.write(f"\033[{crow}A")
        # raw mode: a bare \n drops a row without returning to col 0
        sys.stdout.write("\r\033[J" + prompt + "".join(buf).replace("\n", "\r\n"))
        endrow, endcol = rowcol(len(buf))
        if endcol == 0 and (buf or plen) and not (buf and buf[-1] == "\n"):
            endrow -= 1                        # exact-fit row: the terminal holds a pending wrap
        if pos == len(buf):                    # cursor already at the natural end
            crow = endrow
        else:                                  # editing mid-buffer: move back to `pos`
            trow, tcol = rowcol(pos)
            sys.stdout.write("\r")             # col 0 of the bottom row (clears pending wrap)
            if endrow - trow > 0:
                sys.stdout.write(f"\033[{endrow - trow}A")
            if tcol:
                sys.stdout.write(f"\033[{tcol}C")
            crow = trow
        sys.stdout.flush()

    def load(item):
        nonlocal buf, pos
        buf, pos = list(item), len(item); redraw()

    try:
        termios.tcsetattr(fd, termios.TCSANOW, new)
        # Bracketed paste: without it the terminal sends a pasted block as raw bytes, and the
        # CR between its lines is indistinguishable from Enter — so a multi-line paste submits
        # its FIRST LINE and the rest is lost. With it on, the block arrives wrapped in
        # \033[200~ … \033[201~ and lands in the buffer whole, newlines included.
        sys.stdout.write("\033[?2004h")
        sys.stdout.flush()
        # Pull any type-ahead entered during the prior (cooked-mode) output. A buffered Enter
        # arrives as '\n', which the loop would misread as Ctrl+Enter → seat/id picker; mark
        # these bytes (from_ta) so their newlines SEND. Leftover persists in _TA_BUF so multiple
        # queued lines aren't dropped.
        try:
            import fcntl
            _fl = fcntl.fcntl(fd, fcntl.F_GETFL)
            fcntl.fcntl(fd, fcntl.F_SETFL, _fl | os.O_NONBLOCK)
            try:
                _extra = os.read(fd, 4096)
                if _extra:
                    _TA_BUF.extend(_extra)
            except (BlockingIOError, OSError):
                pass
            finally:
                fcntl.fcntl(fd, fcntl.F_SETFL, _fl)
        except Exception:
            pass
        redraw()
        while True:
            if _TA_BUF:
                ch, from_ta = bytes([_TA_BUF.pop(0)]), True
            else:
                ch, from_ta = os.read(fd, 1), False
            if ch in (b"\r", b"\n"):
                # Ctrl+Enter (live LF) while positioned at an <id> arg → arrow-pick an id, keep
                # editing. A type-ahead '\n' (from_ta) is a buffered Enter, so skip the picker.
                if ch == b"\n" and not from_ta:
                    ctx = _id_ctx("".join(buf))
                    if ctx and ctx[2]:
                        prefix, _partial, ids = ctx
                        sys.stdout.write("\r\n")
                        res = _pick(ids, 0, hint="↑/↓ or j/k · enter drop id in · q cancel")
                        if res:
                            buf[:] = list(prefix + ids[res[0]]); pos = len(buf)
                        crow = 0; redraw(); continue
                # Descend past the whole wrapped block before the newline: crow can lag
                # the true bottom row (wrap math drift / a resize mid-entry), and a bare
                # \r\n from a too-high row leaves the next output (the ⟐ memory notice,
                # routing) printed on top of the still-visible prompt.
                w = max(1, shutil.get_terminal_size((80, 24)).columns)
                endrow = (_vlen(prompt) + len(buf) - 1) // w if (buf or prompt) else 0
                if endrow > crow:
                    sys.stdout.write(f"\033[{endrow - crow}B")
                sys.stdout.write("\r\n")
                return "".join(buf), ("send" if (ch == b"\r" or from_ta) else "pick")
            if ch == b"\t":                            # Tab → cycle valid ids at an <id> arg
                cur = "".join(buf)
                if tabs["ids"] and cur == tabs["last"]:            # continue an established cycle
                    tabs["idx"] = (tabs["idx"] + 1) % len(tabs["ids"])
                else:
                    ctx = _id_ctx(cur)
                    if not (ctx and ctx[2]):
                        tabs.update(ids=[], idx=-1, last=None); continue
                    tabs.update(prefix=ctx[0], ids=ctx[2], idx=0)
                newbuf = tabs["prefix"] + tabs["ids"][tabs["idx"]]
                tabs["last"] = newbuf
                buf[:], pos = list(newbuf), len(newbuf); redraw()
            elif ch == b"\x04":                        # Ctrl-D
                if not buf:
                    sys.stdout.write("\r\n"); return None, "eof"
            elif ch in (b"\x7f", b"\x08"):             # backspace
                if pos > 0:
                    del buf[pos - 1]; pos -= 1; redraw()
            elif ch == b"\x01":                        # Ctrl-A home
                pos = 0; redraw()
            elif ch == b"\x05":                        # Ctrl-E end
                pos = len(buf); redraw()
            elif ch == b"\x15":                        # Ctrl-U kill to start
                del buf[:pos]; pos = 0; redraw()
            elif ch == b"\x0b":                        # Ctrl-K kill to end
                del buf[pos:]; redraw()
            elif ch == b"\x12":                        # Ctrl+R → peek shortcuts: command help for
                if buf:                                # a slash command, else how to route the text
                    sys.stdout.write("\r\n")
                    lines = (_command_hint_lines(buf) if "".join(buf).lstrip().startswith("/")
                             else _route_hint_lines())
                    for ln in lines:
                        sys.stdout.write(ln + "\r\n")
                    crow = 0
                    redraw()
            elif ch == b"\x1b":                        # escape sequences
                if select.select([fd], [], [], 0.05)[0]:
                    intro = os.read(fd, 1)             # '[' (CSI) or 'O' (SS3)
                    seq = intro
                    if intro in (b"[", b"O"):          # read to the final byte (a letter or '~')
                        while len(seq) < 16:
                            c = os.read(fd, 1)
                            if not c:
                                break
                            seq += c
                            if c.isalpha() or c == b"~":
                                break
                    if seq == b"[200~":            # bracketed paste — take it verbatim
                        data, end = bytearray(), b"\x1b[201~"
                        while not data.endswith(end):
                            c = bytes([_TA_BUF.pop(0)]) if _TA_BUF else os.read(fd, 1)
                            if not c:
                                break
                            data += c
                        if data.endswith(end):
                            del data[-len(end):]
                        # A paste carries CR, CRLF or LF depending on the source; normalise so
                        # the buffer holds one \n per line and the text survives round-tripping.
                        text = (data.decode("utf-8", "replace")
                                .replace("\r\n", "\n").replace("\r", "\n"))
                        for cc in text:
                            buf.insert(pos, cc); pos += 1
                        redraw()
                    elif seq == b"[A" and _rl and hidx > 0:
                        if hidx == hlen:
                            saved = "".join(buf)
                        hidx -= 1; load(_rl.get_history_item(hidx + 1) or "")
                    elif seq == b"[B" and _rl and hidx < hlen:
                        hidx += 1; load(saved if hidx == hlen else (_rl.get_history_item(hidx + 1) or ""))
                    elif seq == b"[C" and pos < len(buf):
                        pos += 1; redraw()
                    elif seq == b"[D" and pos > 0:
                        pos -= 1; redraw()
                    elif seq in (b"[H", b"OH"):
                        pos = 0; redraw()
                    elif seq in (b"[F", b"OF"):
                        pos = len(buf); redraw()
                    elif seq == b"[Z":                 # Shift+Tab → cycle permission mode
                        sys.stdout.write("\r\n"); return "".join(buf), "cycle"
                    else:                              # F-keys (plain or Ctrl/Alt+Fn) → one-shot seat
                        fk = _FKEY_SEQ.get(re.sub(rb";\d+", b"", seq))
                        if fk:
                            sys.stdout.write("\r\n"); return "".join(buf), "seat:" + fk
            elif ch >= b"\x20":                        # printable (+ utf-8 continuation)
                b0 = ch[0]
                extra = 0 if b0 < 0x80 else (1 if b0 < 0xE0 else (2 if b0 < 0xF0 else 3))
                if extra:
                    ch += os.read(fd, extra)
                try:
                    for cc in ch.decode():
                        buf.insert(pos, cc); pos += 1
                    redraw()
                except Exception:
                    pass
    finally:
        sys.stdout.write("\033[?2004l")
        sys.stdout.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def code_blocks(text):
    blocks, cur, in_code = [], [], False
    for line in (text or "").split("\n"):
        if line.lstrip().startswith("```"):
            if in_code:
                blocks.append("\n".join(cur)); cur, in_code = [], False
            else:
                in_code = True
        elif in_code:
            cur.append(line)
    if in_code and cur:
        blocks.append("\n".join(cur))
    return blocks


