                         "out, then ask me what I'd like to do with it. Don't start acting yet.")
                print(f"{DIM}● loaded job {jid} — {mj.get('title','')[:50]} ({stj}); task + result in "
                      f"context, full history at {os.path.join(jd, 'history.json')}{RESET}")
                _turn(history, thinks, block, stats)   # fire an orientation turn right away
                print(_status_line(stats))
            elif sub in ("rm", "delete", "del", "clean"):   # delete job dirs (never active ones)
                target = (rest.split()[0] if rest else "") or ("done" if sub == "clean" else "")
                if not target:
                    print(f"{DIM}usage: /jobs rm <id> · rm done (finished) · rm all · clean{RESET}"); continue
                jobs = list_jobs()
                if target in ("done", "finished", "old"):
                    victims = [j for j in jobs if job_state(j) in
                               ("done", "failed", "killed", "stalled", "dead")]
                elif target == "all":
                    victims = list(jobs)
                else:
                    victims = [j for j in jobs if j["id"] == target]
                    if not victims:
                        print(f"{DIM}no such job {target}{RESET}"); continue
                removed = kept = 0
                for j in victims:
                    stt = job_state(j)
                    alive = bool(j.get("pid") and _pid_alive(j["pid"]))
                    if stt in ("running", "queued", "blocked") or alive:   # never delete a live job
                        print(f"{DIM}  keeping {j['id']} — {stt}"
                              f"{' (/jobs answer first)' if stt == 'blocked' else ' (/jobs stop first)'}{RESET}")
                        kept += 1; continue
                    try:
                        shutil.rmtree(_job_dir(j["id"])); _JOBS_SEEN.pop(j["id"], None); removed += 1
                    except Exception as e:
                        print(f"{DIM}  {j['id']}: {e}{RESET}")
                print(f"{DIM}removed {removed} job{'s' if removed != 1 else ''}"
                      f"{f' · kept {kept} active' if kept else ''}{RESET}")
            else:
                print(f"{DIM}/jobs [list] · show|log <id> · stop <id> · answer <id> <text> · load <id> · "
                      f"rm <id>|done|all · build <plan-id> [model] · run <goal…> · review <file|dir path>{RESET}")
            continue
        if user == "/goal" or user.startswith("/goal "):
            arg = user[len("/goal"):].strip()
            if arg.lower() in ("off", "clear", "done"):
                GOAL, GOAL_SEAT, GOAL_BLOCKED = "", "", ""
                _session_save(history, thinks)
                print(f"{DIM}goal cleared{RESET}")
            elif arg.lower().startswith("answer "):
                if not GOAL_BLOCKED:
                    print(f"{DIM}nothing is blocked{RESET}")
                else:
                    _turn(history, thinks, arg[7:].strip(), stats); print(_status_line(stats))
            elif arg:
                GOAL, GOAL_BLOCKED = arg, ""
                dom, cx = classify_complexity(arg)      # hard reasoning → capable seat for the loop
                GOAL_SEAT = reasoning_seat() if cx == "hard" else ""
                print(f"{GREEN_BUILD}● goal set{RESET}{DIM} — working toward it now until met or hard-blocked:\n  {arg}{RESET}")
                if GOAL_SEAT:
                    print(f"{DIM}  ({dom}/{cx} → goal loop on {GOAL_SEAT}; hard reasoning off weak seats){RESET}")
                print(f"{DIM}  ends with GOAL MET / BLOCKED · Esc or ^C interrupts · /goal off to stop{RESET}")
                _turn(history, thinks, "Begin now: work toward the goal until the exit criteria are met.", stats)
                print(_status_line(stats))
            else:
                if GOAL:
                    st = f"{RED_VIVID}BLOCKED — needs: {GOAL_BLOCKED}{RESET}" if GOAL_BLOCKED else "active"
                    print(f"{DIM}goal ({st}{DIM}): {GOAL}\n  /goal off · /goal answer <text> (when blocked) · /goal <new criteria>{RESET}")
                else:
                    print(f"{DIM}no goal — /goal <exit criteria> makes the agent work toward it until met or hard-blocked{RESET}")
