# --- /goal: exit criteria the agent works toward (anti-early-abort) -------------------
# A goal is a termination CONTRACT for a thread (the session, a sub-agent, a job): keep
# working until the exit criteria are met; don't stop at the first plausible answer. The
# only legitimate early stop is a HARD BLOCK — needs a credential/secret, an ambiguous spec
# that requires a human decision, a destructive/irreversible step, or repeated tool failure.
# Then the thread parks in `blocked` with a PRECISE need (resumable), never silently quits.
GOAL = ""              # the session's exit criteria ("" = none)
GOAL_SEAT = ""         # seat the goal loop is pinned to (set when the goal is HARD; "" = active seat)
GOAL_BLOCKED = ""      # the precise need when the session is hard-blocked ("" = not blocked)
GOAL_MAX_NUDGES = 4    # per turn: how many times we push the model back to work before pausing
GOAL_MAX_ROUNDS = 40   # tool-round budget PER goal segment (a re-invocation boundary, not a cap)
GOAL_STALL_LIMIT = 3   # consecutive no-progress segments before we abort a goal as stalled
GOAL_HARD_MAX_SEGMENTS = 1000  # runaway backstop only (~40k rounds); stall detection is the real guard


def reasoning_seat():
    """The capable seat agentic HARD reasoning escalates to (settings `reasoning_seat`).
    Hard reasoning doesn't belong on weak local models — the goal/task's contract (GOAL MET /
    BLOCKED) and multi-step planning need a strong model; trivial/medium work stays on
    saint-auto (routed cheaply)."""
    s = load_settings().get("reasoning_seat") or "cloud-large"   # Opus: hard reasoning belongs on the strong seat
    return s if s in SEATS else "saint"


def classify_complexity(text):
    """Ask SAINT to classify `text` (one throwaway token; SAINT caches). Returns
    (domain, complexity) e.g. ('code','hard'), or ('','') if SAINT is unreachable."""
    try:
        req = urllib.request.Request(
            SAINT_BASE + "/chat/completions",
            json.dumps({"model": "saint-auto", "max_tokens": 1,
                        "messages": [{"role": "user", "content": (text or "")[:2000]}]}).encode(),
            {"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=8) as r:
            return r.headers.get("x-saint-domain", ""), r.headers.get("x-saint-complexity", "")
    except Exception:
        return "", ""


def agentic_seat(task, pinned=None, default="saint"):
    """Resolve the seat for agentic work: an explicit pin wins; else classify the task once —
    HARD → reasoning_seat() (capable), otherwise `default` (saint-auto routes per turn). The
    task's difficulty is judged from the WHOLE brief, not the trivial per-turn nudges, so a
    hard goal/job stays on a strong model for its whole loop."""
    if pinned:
        return pinned
    _, cx = classify_complexity(task)
    return reasoning_seat() if cx == "hard" else default
_GOAL_DIRECTIVE = (
    "SESSION GOAL (exit criteria): {goal}\n"
    "Work toward this goal persistently across turns until the exit criteria are genuinely met — "
    "do NOT stop early, do NOT declare success without evidence, do NOT ask permission for "
    "routine steps. When the criteria are met, end your reply with a line `GOAL MET: <evidence>`. "
    "The ONLY reason to stop short is a hard block: you need a credential/secret, the spec is "
    "ambiguous in a way only the user can resolve, the next step is destructive/irreversible, "
    "or a tool has failed repeatedly (3+) despite fixes. Then end your reply with ONE line "
    "`BLOCKED: <exactly what you need>` and stop. Otherwise keep going."
)
_GOAL_DELEGATE = (
    "DELEGATE to conserve this seat: you are running on a strong, expensive seat, and you have "
    "`spawn_agent` — it runs a sub-agent on a cheaper seat by default (pin one with `model` when a "
    "sub-task needs more power). Offload self-contained, mechanical, or independent sub-tasks to it "
    "— scaffolding a file, running a test suite, gathering facts, drafting boilerplate — and fan "
    "several out in parallel when they are independent. Keep your own turns for planning, hard "
    "reasoning, integration, and judgment. Quality-critical work may stay with you, but do not "
    "spend this seat on routine grunt work a sub-agent can do."
)
_GOAL_MET_RE = re.compile(r"^\s*GOAL MET\b", re.M)
_GOAL_BLOCKED_RE = re.compile(r"^\s*BLOCKED:\s*(.+)$", re.M)
_GOAL_ABANDON_RE = re.compile(
    r"\b(stop(?:\s+(?:here|now|it))?|abandon|cancel|give\s+up|drop\s+(?:it|this|the\s+goal)|"
    r"forget\s+(?:it|this|the\s+goal)|leave\s+it|never\s*mind|quit(?:\s+the\s+goal)?|"
    r"call\s+it(?:\s+(?:off|quits))?|that'?s\s+enough|end\s+the\s+goal)\b", re.I)


def _looks_like_abandon(text):
    """True when a reply to a BLOCKED goal is a stop/abandon directive rather than unblocking
    info — so we clear the goal instead of resuming its loop (a met goal already self-clears;
    this gives an abandoned one the same one-step exit). Tight on purpose: a short message, an
    abandon phrase, and neither a 'do something else instead' redirect nor a 'keep going' resume."""
    t = (text or "").strip()
    if not t or len(t) > 100:                      # a long reply is almost certainly real content
        return False
    if re.search(r"\b(instead|rather|and then|then do|but (?:first|also|do)|next)\b", t, re.I):
        return False                               # a redirect ("stop X and do Y") is not abandon
    if re.search(r"\b(don'?t|do not|keep (?:going|at)|continue|carry on|resume|proceed)\b", t, re.I):
        return False                               # an explicit resume, not abandon
    return bool(_GOAL_ABANDON_RE.search(t))


def goal_terminate(goal, nudges_left):
    """Build a run_thread `terminate` hook for `goal`. Returns (done, nudge)."""
    state = {"left": nudges_left}

    def _t(text, res):
        global GOAL_BLOCKED
        t = text or ""
        m = _GOAL_BLOCKED_RE.search(t)
        if m:
            GOAL_BLOCKED = m.group(1).strip()
            res["blocked"] = GOAL_BLOCKED
            return True, None                   # parked: needs the user (resumable)
        if _GOAL_MET_RE.search(t):
            res["goal_met"] = True
            return True, None
        if state["left"] <= 0:
            res["goal_paused"] = True
            return True, None                   # pause; user can say "continue"
        state["left"] -= 1
        return False, ("The goal is not yet met. Continue working toward the exit criteria: "
                       f"{goal}. If you are genuinely hard-blocked, reply with `BLOCKED: <need>`; "
                       "when done, `GOAL MET: <evidence>`.")
    return _t


# --- sidebar chats: fork the thread, branch a side discussion, fold conclusions back ------
# A sidebar shares the context up to the fork point, then diverges. On merge, only a CONCISE
# CONCLUSION returns to the main thread (not the whole side transcript) — so a tangent doesn't
# bloat the main history. A stack, so sidebars can nest.
SIDEBARS = []   # ACTIVE (entered) sidebars; a stack so they nest. Each: {"label","id"}. The live
                # `history` IS the top sidebar's branch (or the main thread when this list is empty).
_SB_UNDER = []  # parallel to SIDEBARS: the saved history of the layer BENEATH each active sidebar,
                # restored AS IT STANDS NOW (never a stale fork snapshot) on merge/drop/return — so
                # you can /return to main, work there, /resume, and /merge without clobbering main.
_SB_PAUSED = [] # suspended sidebars kept alive to resume later: {"label","id","branch":[...msgs...]}.
_SB_SEQ = 0     # monotonic id source so paused sidebars get stable, pickable handles (#1, #2 …).
_PREFILL = ""   # command line to hand back pre-filled on the next prompt (Tab from a picker)


def sidebar_summarize(history, model, base, incremental=False):
    """Ask the model to distill the branch discussion for the main thread. `incremental` gives a
    brief interim status (for /update, sidebar stays open); otherwise a full carry-back conclusion."""
    ask = ("Give a BRIEF interim update from this side discussion for the main thread in 1–3 "
           "sentences: the latest state, findings, or decisions so far. No preamble." if incremental else
           "Summarize the CONCLUSIONS of this side discussion for the main thread in 2–5 sentences: "
           "decisions reached, findings, anything to carry back. No preamble, just the conclusion.")
    res = run_thread(ask, history=list(history), model=model, base=base, quiet=True, max_rounds=1)
    return (res.get("text") or "").strip()


def _sb_fork(history, label):
    """Enter a NEW sidebar branching from the current thread (main or an outer sidebar)."""
    global _SB_SEQ
    _SB_SEQ += 1
    _SB_UNDER.append(list(history))                # remember the layer we're diverging from
    SIDEBARS.append({"label": label[:60], "id": _SB_SEQ})
    history.append({"role": "user", "content": f"[Entering a SIDEBAR about: {label}] The main task is "
                    "paused. Explore this side thread; when we finish I'll fold the conclusions back."})
    history.append({"role": "assistant", "content": f"In a sidebar on '{label}'. What would you like to explore?"})
    return SIDEBARS[-1]


def _sb_leave(history):
    """Pop the active sidebar and restore the layer beneath it (as it stands NOW). Returns the frame."""
    history[:] = _SB_UNDER.pop()
    return SIDEBARS.pop()


def _sb_pause(history):
    """/return — suspend the active sidebar (keeping its branch) and drop to the layer beneath."""
    branch = list(history)
    frame = _sb_leave(history)
    _SB_PAUSED.append({"label": frame["label"], "id": frame["id"], "branch": branch})
    return frame


def _sb_resume(history, entry):
    """Re-enter a paused sidebar: stash the current thread as its 'under', make its branch live."""
    _SB_UNDER.append(list(history))                # the thread we're leaving is what merge returns to
    history[:] = entry["branch"]
    SIDEBARS.append({"label": entry["label"], "id": entry["id"]})
    _SB_PAUSED.remove(entry)
    return entry


def _sb_match_paused(tok):
    """Find a paused sidebar by #id / id / label-substring; None if no match."""
    t = tok.strip().lstrip("#").lower()
    for f in _SB_PAUSED:
        if str(f["id"]) == t:
            return f
    return next((f for f in _SB_PAUSED if t and t in f["label"].lower()), None)


