                jd = _job_dir(jid); rp = os.path.join(jd, "result.md")
                stj = job_state(mj)
                result = open(rp).read() if os.path.exists(rp) else ""
                # Lightweight orientation only — task + result (capped) + PATHS to the full
                # artifacts. No 100K-token history prefill; the agent reads them if it needs to.
                block = (f"[Loaded background job {jid} — {mj.get('title','')} · state: {stj}]\n\n"
                         f"Its task:\n{mj.get('goal') or mj.get('title') or '(none)'}\n\n"
                         f"Its result:\n{result[:8000] or f'(no result yet — job is {stj})'}"
                         f"{'  …[truncated; read result.md in full]' if len(result) > 8000 else ''}\n\n"
                         f"Full artifacts, if you need more than the summary above — read them with "
                         f"your tools, don't assume:\n"
