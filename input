def tools_menu():
    """Per-tool on/off. ↑/↓ or j/k move; space/enter toggle; a/n all/none; q/esc close.
    Persists the disabled set to settings so it survives restarts."""
    names = list(TOOLS)
    if not names:
        print("(no tools registered)")
        return
    if not sys.stdin.isatty():                    # piped: just show state, can't toggle
        for n in names:
            print(f"  {'[x]' if TOOLS[n].enabled else '[ ]'} {n}  [{TOOLS[n].source}]")
        return
    import select, termios, tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    sel = 0
    off = f"  {DIM}(tools globally OFF — /tools on){RESET}" if not TOOLS_ON else ""
    print(f"{DIM}↑/↓ move · space/enter toggle · a all · n none · q done{RESET}{off}")

    def draw(first=False):
        if not first:
            sys.stdout.write(f"\033[{len(names)}A")
        for i, n in enumerate(names):
            t = TOOLS[n]
            box = f"{CODE_FG}[x]{RESET}" if t.enabled else f"{DIM}[ ]{RESET}"
            cur = f"{BOLD}❯{RESET} " if i == sel else "  "
            sys.stdout.write(f"\r\033[K{cur}{box} {n:<18}{DIM}[{t.source}]  "
                             f"{t.description[:42]}{RESET}\r\n")
        sys.stdout.flush()

    try:
        tty.setraw(fd)
        draw(first=True)
        while True:
            ch = os.read(fd, 1)
            if ch in (b"q", b"\x03"):
                break
            if ch in (b" ", b"\r", b"\n"):
                TOOLS[names[sel]].enabled = not TOOLS[names[sel]].enabled; draw()
            elif ch in (b"a", b"A"):
                for n in names: TOOLS[n].enabled = True
                draw()
            elif ch in (b"n", b"N"):
                for n in names: TOOLS[n].enabled = False
                draw()
            elif ch in (b"j", b"J"):
                sel = (sel + 1) % len(names); draw()
            elif ch in (b"k", b"K"):
                sel = (sel - 1) % len(names); draw()
            elif ch == b"\x1b":
                if select.select([fd], [], [], 0.05)[0]:
                    seq = os.read(fd, 2)
                    if seq == b"[A":
                        sel = (sel - 1) % len(names); draw()
                    elif seq == b"[B":
                        sel = (sel + 1) % len(names); draw()
                else:
                    break                          # bare Esc closes
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
    st = load_settings()
    st["tools_state"] = {n: TOOLS[n].enabled for n in TOOLS
                         if TOOLS[n].enabled != TOOLS[n].default_enabled}
    st.pop("tools_disabled", None)                    # migrated to tools_state
    save_settings(st)
    on = sum(TOOLS[n].enabled for n in names)
    print(f"{DIM}→ {on}/{len(names)} tools enabled{RESET}")


