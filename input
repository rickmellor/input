# --- settings + always-on grounding context -------------------------------------
# settings.json is the shared config store (location now; tool prefs later). Grounding
# is injected into the system context on EVERY request so the model always knows the
# current time — cheaper and more reliable than a get_current_time tool it must decide
# to call. Location rides along when set (settings 'location' or $INPUT_LOCATION).
_SETTINGS = os.path.expanduser("~/.config/input/settings.json")


def load_settings():
    try:
        return json.load(open(_SETTINGS))
    except Exception:
        return {}


def save_settings(d):
    try:
        os.makedirs(os.path.dirname(_SETTINGS), exist_ok=True)
        json.dump(d, open(_SETTINGS, "w"), indent=2)
        return True
    except Exception:
        return False


def ground_text():
    now = datetime.now().astimezone()
    s = "Current date and time: " + now.strftime("%A, %Y-%m-%d %H:%M %Z (%z)") + "."
    loc = os.environ.get("INPUT_LOCATION") or load_settings().get("location")
    if loc:
        s += f" User location: {loc}."
    return s


# The chat system prompt is a user-editable template at ~/.config/input/system.md.
# {{tokens}} substitute fresh at send time; unknown {{tokens}} and literal braces in the
# body are left untouched. Absent/empty file → "{{stable}}".
#
# CACHING: SAINT breakpoints the FIRST system message (saint/backends.py); a system
# prefix that changes every turn invalidates the whole cached prefix (system + history)
# once a chat crosses cache.prompt_cache_min_chars — and also defeats local prefix reuse
# (vLLM APC / llama.cpp). So the default {{stable}} carries only session-stable grounding
# (date at day resolution + location) — no minute clock. {{time}}/{{datetime}} are
# available for users who want a live clock in the prompt, at that cache cost. Live
# minute-time on demand is a job for the get_current_time tool (v2.1), not the prefix.
# Shell/goal modes keep the full-resolution ground_text() (single-shot, no cache to protect).
_SYSTEM_TMPL = os.path.expanduser("~/.config/input/system.md")


def stable_context():
    """Session-stable grounding for the system prefix — no minute clock, so SAINT's
    system breakpoint and local prefix reuse stay warm across turns."""
    s = "Today is " + datetime.now().astimezone().strftime("%A, %Y-%m-%d") + "."
    loc = os.environ.get("INPUT_LOCATION") or load_settings().get("location")
    if loc:
        s += f" You are assisting a user located in {loc}."
    return s


def _tokens():
    now = datetime.now().astimezone()
    loc = os.environ.get("INPUT_LOCATION") or load_settings().get("location") or ""
    return {"stable": stable_context(), "grounding": ground_text(),
            "datetime": now.strftime("%A, %Y-%m-%d %H:%M %Z (%z)"),
            "date": now.strftime("%A, %Y-%m-%d"), "time": now.strftime("%H:%M %Z"),
            "tz": now.strftime("%Z"), "location": loc,
            "cwd": os.getcwd(), "os": platform.system(), "shell": SHELL}


def load_system_template():
    try:
        t = open(_SYSTEM_TMPL).read()
        return t if t.strip() else "{{stable}}"
    except Exception:
        return "{{stable}}"


def system_prompt():
    """Render the template: substitute known {{tokens}}, leave the rest verbatim."""
    toks = _tokens()
    return re.sub(r"\{\{(\w+)\}\}", lambda m: toks.get(m.group(1), m.group(0)),
                  load_system_template()).strip()


def chat_system():
    """Fresh chat system message from the template, or None if it renders empty."""
    s = system_prompt()
    return {"role": "system", "content": s} if s else None


# --- tool framework --------------------------------------------------------------
# A Tool = name + description + JSON-Schema parameters + run(args:dict) -> str. Built-ins
# register below; user tools auto-load from ~/.config/input/tools/*.py (each file defines
# TOOL, a dict, or TOOLS, a list of them). MCP tools will register the same way later.
# Tools ride the OpenAI tools/tool_calls protocol, which every seat accepts (local + SAINT).
_TOOLS_DIR = os.path.expanduser("~/.config/input/tools")
TOOLS = {}            # name -> Tool
TOOLS_ON = True       # set from settings at REPL start; /tools toggles + persists
MAX_TOOL_ROUNDS = 8   # cap the call→result→call loop so a stuck model can't spin forever


class Tool:
    def __init__(self, name, description, parameters, run, source="built-in",
                 confirm="never", display="compact", default_enabled=True):
        self.name, self.description = name, description
        self.parameters, self.run, self.source = parameters, run, source
        self.default_enabled = default_enabled   # MCP tools default OFF; built-ins/user ON
        self.enabled = default_enabled           # per-tool on/off; /tools menu, settings tools_state
        self.confirm = confirm        # gate policy: "never" | "review" | "always" (see _gate)
        self.display = display        # result view: "compact" (one line) | "full" (whole output)

    def schema(self):
        return {"type": "function", "function": {
            "name": self.name, "description": self.description, "parameters": self.parameters}}


def register(tool):
    TOOLS[tool.name] = tool
    return tool


def active_tools():
    """Enabled tool schemas to send with a chat request, or None when off/none enabled."""
    if not TOOLS_ON:
        return None
    return [t.schema() for t in TOOLS.values() if t.enabled] or None


def run_tool_call(tc):
    """Execute one OpenAI tool_call dict; always returns a string (the tool result)."""
    fn = tc.get("function") or {}
    name = fn.get("name")
    try:
        args = json.loads(fn.get("arguments") or "{}")
    except Exception:
        args = {}
    tool = TOOLS.get(name)
    if tool is None:
        return f"Error: no such tool {name!r}"
    try:
        return str(tool.run(args))
    except Exception as e:
        return f"Error running {name}: {e}"


def _confirm():
    try:
        return input("  run? [y]es/[N]o: ").strip().lower() in ("y", "yes")
    except (EOFError, KeyboardInterrupt):
        return False


def _gate(policy, cmd):
    """Risk gate for a tool call; prints notes, prompts as needed. Returns True to proceed.
    'review' rates a shell command via gemma (auto-run none/low, confirm the rest); the
    catastrophic denylist always prompts; 'always' confirms every call."""
    if cmd and danger(cmd):
        print(f"{RED}  ⚠ matches a catastrophic pattern — review carefully{RESET}")
        return _confirm()
    if policy == "review" and cmd:
        v = review(cmd)
        if v and v[0] in ("none", "low"):
            print(f"{DIM}  gemma: {v[0]} risk — auto-run{RESET}")
            return True
        if v:
            print(f"{YEL}  gemma: {v[0]} risk — {v[1]}{RESET}")
        else:
            print(f"{YEL}  gemma review unavailable — confirm{RESET}")
        return _confirm()
    return _confirm()   # "always", or "review" with no command to rate


def execute_tool(tc):
    """Gate (per the tool's confirm policy) then run one tool call."""
    fn = tc.get("function") or {}
    tool = TOOLS.get(fn.get("name"))
    if tool is not None and getattr(tool, "confirm", "never") != "never":
        try:
            args = json.loads(fn.get("arguments") or "{}")
        except Exception:
            args = {}
        cmd = args.get("command") if isinstance(args, dict) else None
        if not _gate(tool.confirm, cmd):
            return "Declined by the user; not run."
    return run_tool_call(tc)


def load_user_tools():
    import glob, importlib.util
    for path in sorted(glob.glob(os.path.join(_TOOLS_DIR, "*.py"))):
        try:
            spec = importlib.util.spec_from_file_location(
                "input_tool_" + os.path.basename(path)[:-3], path)
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            defs = getattr(mod, "TOOLS", None)
            if defs is None and hasattr(mod, "TOOL"):
                defs = [mod.TOOL]
            for d in defs or []:
                register(Tool(d["name"], d["description"],
                              d.get("parameters", {"type": "object", "properties": {}}),
                              d["run"], source=os.path.basename(path),
                              confirm=d.get("confirm", "never"),
                              display=d.get("display", "compact")))
        except Exception as e:
            print(f"{DIM}(tool load failed: {os.path.basename(path)}: {e}){RESET}")


def _tool_current_time(args):
    tzname = (args or {}).get("timezone")
    if tzname:
        try:
            from zoneinfo import ZoneInfo
            return datetime.now(ZoneInfo(tzname)).strftime("%A, %Y-%m-%d %H:%M:%S %Z (%z)")
        except Exception:
            local = datetime.now().astimezone().strftime("%A, %Y-%m-%d %H:%M:%S %Z (%z)")
            return f"Unknown timezone {tzname!r}. Local time is {local}."
    now = datetime.now().astimezone()
    loc = os.environ.get("INPUT_LOCATION") or load_settings().get("location")
    s = now.strftime("%A, %Y-%m-%d %H:%M:%S %Z (%z)")
    return s + (f" (user location: {loc})" if loc else "")


