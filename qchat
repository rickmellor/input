#!/usr/bin/env python3
"""qchat — chat REPL, NL shell-command generator, and shell goal-agent for local seats.

Chat REPL:  qchat [seat|model [base_url]]        thinking streams dimmed
            /models toggle seat · /clear · /quit
Command:    qchat -e <task>   propose → execute|revise|describe|copy|quit
            qchat -x <task>   propose → execute immediately
            qchat --gen <buf> print one command to stdout (Ctrl-G binding)
Goal agent: qchat --goal <task>   iterate: propose→confirm→run→observe→next
            qchat --auto <task>   iterate autonomously; denylist + gemma risk gate
Bare -e/-x/--goal/--auto with no words prompts for the task (no shell quoting).

Seats: gemma (chat default) | coder (command/goal default) | qwen38 (on-demand).
REPL: reasoning streams live then collapses to one line (/think re-expands);
      code blocks render boxed + line-numbered; ^C copies the last reply's code
      blocks (^D or /quit to exit); /models switches seat.
Shell integration (! / !! prefixes, Ctrl-G): source qchat-shell.bash.
"""
import json, math, os, platform, re, shutil, subprocess, sys, time, urllib.request

DIM, BOLD, RED, YEL, RESET = "\033[2m", "\033[1m", "\033[31m", "\033[33m", "\033[0m"
ITAL, ULINE, CODE_FG = "\033[3m", "\033[4m", "\033[36m"
SHELL = os.environ.get("SHELL", "/bin/bash")
SESSION = None  # per-REPL x-session-id: scopes SAINT conversation affinity to this run
                # (else it keys on a hash of the first message — "hello" collides across chats)

# readline gives the prompt up/down input-history recall; persist it across sessions.
try:
    import readline as _rl
    _HIST = os.path.expanduser("~/.config/qchat/history")
    try:
        os.makedirs(os.path.dirname(_HIST), exist_ok=True)
        _rl.read_history_file(_HIST)
    except Exception:
        pass
    _rl.set_history_length(2000)
    import atexit
    atexit.register(lambda: _safe(lambda: _rl.write_history_file(_HIST)))
except Exception:
    _rl = None


def _safe(fn):
    try:
        fn()
    except Exception:
        pass

SEATS = {
    "gemma":  ("gemma-4-26B-A4B-it-FP8-Dynamic", "http://127.0.0.1:8002/v1"),
    "coder":  ("qwen-27b-coder",                 "http://127.0.0.1:8003/v1"),
    "qwen38": ("Qwen3.8-27B-AWQ-INT4",           "http://127.0.0.1:8004/v1"),
    "saint":       ("saint-auto",         "http://127.0.0.1:4000/v1"),  # router: classify → local/cloud
    "cloud-large": ("saint-cloud-large",  "http://127.0.0.1:4000/v1"),  # force cloud (Opus/Sonnet tier) via SAINT
    "cloud-small": ("saint-cloud-small",  "http://127.0.0.1:4000/v1"),  # force cloud (Haiku tier) via SAINT
}
MAX_AUTO_STEPS = 8
_DEFAULT_CFG = os.path.expanduser("~/.config/qchat/default-seat")


def load_default_seat():
    try:
        n = open(_DEFAULT_CFG).read().strip()
        return n if n in SEATS else None
    except Exception:
        return None


def save_default_seat(name):
    try:
        os.makedirs(os.path.dirname(_DEFAULT_CFG), exist_ok=True)
        open(_DEFAULT_CFG, "w").write(name)
        return True
    except Exception:
        return False

# --- catastrophic-command denylist: hard-blocked even in --auto, no LLM involved.
_DENY = [
    r"\brm\s+(-\w*\s+)*-\w*[rf]\w*\s+(-\w*\s+)*/(\s|$)",   # rm -rf /
    r"\brm\s+(-\w*\s+)*-\w*[rf].*\s/\*",                    # rm -rf /*
    r"\bdd\b.*\bof=/dev/",                                   # dd of=/dev/sdX
    r"\bmkfs\b", r":\(\)\s*\{.*\|.*&.*\}", r"\bshutdown\b", r"\breboot\b",
    r">\s*/dev/sd", r"\bchmod\s+-R\s+0*\s+/", r"\bchown\s+-R\s+\S+\s+/(\s|$)",
    r"\bcurl\b[^|]*\|\s*(sudo\s+)?(ba)?sh", r"\bwget\b[^|]*\|\s*(sudo\s+)?(ba)?sh",
    r"\bgit\b.*\bpush\b.*--force", r"\bmv\s+.*\s+/dev/null",
]


def danger(cmd):
    for pat in _DENY:
        if re.search(pat, cmd):
            return pat
    return None


def _post(model, base, messages, think, max_tokens):
    body = {"model": model, "messages": messages, "max_tokens": max_tokens}
    if not think:
        body["chat_template_kwargs"] = {"enable_thinking": False}
    req = urllib.request.Request(f"{base}/chat/completions", json.dumps(body).encode(),
                                 {"Content-Type": "application/json"})
    d = json.load(urllib.request.urlopen(req, timeout=600))
    return (d["choices"][0]["message"].get("content") or "").strip()


def complete(messages, think=False, max_tokens=8192):
    return _post(MODEL, BASE, messages, think, max_tokens)


def seat_alive(base):
    try:
        urllib.request.urlopen(f"{base}/models", timeout=1.5).read()
        return True
    except Exception:
        return False


def clean_cmd(text):
    lines = [l for l in text.strip().splitlines() if not l.strip().startswith("```")]
    return "\n".join(lines).strip()


def review(cmd):
    """Ask gemma to risk-rate a command. Returns (risk, reason) or None if unavailable."""
    model, base = SEATS["gemma"]
    sysmsg = ("You are a shell-command safety reviewer. Rate the RISK of running the command. "
              'Reply ONLY compact JSON: {"risk":"none|low|medium|high|critical","reason":"short"}. '
              "high/critical = data loss, overwrite, exfiltration, system damage, irreversible.")
    try:
        raw = _post(model, base, [{"role": "system", "content": sysmsg},
                                  {"role": "user", "content": cmd}], think=False, max_tokens=200)
        m = re.search(r"\{.*\}", raw, re.S)
        v = json.loads(m.group(0))
        return v.get("risk", "unknown"), v.get("reason", "")
    except Exception:
        return None


def run(cmd, capture=False):
    if not capture:
        return subprocess.run(cmd, shell=True, executable=SHELL).returncode, ""
    p = subprocess.run(cmd, shell=True, executable=SHELL, capture_output=True, text=True)
    out = (p.stdout or "") + (p.stderr or "")
    sys.stdout.write(out)
    sys.stdout.flush()
    return p.returncode, out


def copy_clip(text):
    # Prefer a local clipboard tool only when there's a local display; otherwise (e.g.
    # over SSH) use OSC 52, which the terminal emulator puts on *your* clipboard.
    if os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"):
        for tool in (["wl-copy"], ["xclip", "-selection", "clipboard"], ["xsel", "-ib"]):
            if shutil.which(tool[0]):
                subprocess.run(tool, input=text.encode(), check=False)
                return True
    import base64
    seq = "\033]52;c;" + base64.b64encode(text.encode()).decode() + "\a"
    if os.environ.get("TMUX"):                       # tmux passthrough wrapper
        seq = "\033Ptmux;\033" + seq + "\033\\"
    sys.stdout.write(seq); sys.stdout.flush()
    return True


def _cmd_sys():
    ctx = os.environ.get("QCHAT_CTX", "").strip()
    ctx = f" Recent shell history:\n{ctx}\n" if ctx else ""
    return (f"You generate shell commands for {platform.system()} / {SHELL} / cwd {os.getcwd()}.{ctx}"
            "Output ONLY the command — no markdown, no backticks, no explanation.")


def generate(task):
    return clean_cmd(complete([{"role": "system", "content": _cmd_sys()},
                               {"role": "user", "content": task}], max_tokens=1024))


# --- one-shot command mode (-e / -x) --------------------------------------------
def shell_mode(task, auto=False):
    messages = [{"role": "system", "content": _cmd_sys()}, {"role": "user", "content": task}]
    cmd = clean_cmd(complete(messages, max_tokens=1024))
    messages.append({"role": "assistant", "content": cmd})
    if auto:
        d = danger(cmd)
        print(f"{BOLD}{cmd}{RESET}", file=sys.stderr)
        if d:
            print(f"{RED}BLOCKED: catastrophic pattern — refusing to auto-run.{RESET}", file=sys.stderr)
            return 1
        return run(cmd)[0]
    while True:
        print(f"{BOLD}{cmd}{RESET}")
        if danger(cmd):
            print(f"{RED}⚠ matches a catastrophic pattern — review carefully.{RESET}")
        try:
            choice = input("> execute | revise | describe | copy | quit: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            return 130
        if choice in ("e", "execute"):
            return run(cmd)[0]
        if choice in ("r", "revise"):
            fb = input("revision: ").strip()
            messages.append({"role": "user", "content": f"Revise: {fb}. Output only the command."})
            cmd = clean_cmd(complete(messages, max_tokens=1024))
            messages.append({"role": "assistant", "content": cmd})
        elif choice in ("d", "describe"):
            print(DIM + complete(messages + [{"role": "user", "content":
                  "Explain what this does, plain text, brief."}], max_tokens=512) + RESET)
        elif choice in ("c", "copy"):
            print("(copied)" if copy_clip(cmd) else "(no clipboard tool)")
        elif choice in ("q", "quit"):
            return 0


# --- goal agent (! / !!) --------------------------------------------------------
def goal_mode(task, auto=False):
    goal_sys = (f"Accomplish a shell goal step by step on {platform.system()} / {SHELL} / cwd {os.getcwd()}. "
                "Each turn output EITHER the single next command (no markdown/explanation) "
                "OR a line 'DONE: <summary>' when the goal is met. Commands must be non-interactive. "
                "You are shown each command's exit code and output.")
    ctx = os.environ.get("QCHAT_CTX", "").strip()
    first = f"Goal: {task}" + (f"\n\nRecent shell history:\n{ctx}" if ctx else "")
    messages = [{"role": "system", "content": goal_sys}, {"role": "user", "content": first}]
    for step in range(1, MAX_AUTO_STEPS + 1):
        out = clean_cmd(complete(messages, max_tokens=1024))
        if out.upper().startswith("DONE"):
            print(f"{DIM}✓ {out[4:].lstrip(': ').strip() or 'done'}{RESET}")
            return 0
        cmd = out
        messages.append({"role": "assistant", "content": cmd})
        print(f"{BOLD}[{step}/{MAX_AUTO_STEPS}] {cmd}{RESET}")
        d = danger(cmd)
        proceed = False
        if d:
            print(f"{RED}⚠ catastrophic pattern — manual confirmation required.{RESET}")
        elif auto:
            v = review(cmd)
            if v and v[0] in ("none", "low"):
                print(f"{DIM}gemma: {v[0]} risk — auto-proceeding{RESET}")
                proceed = True
            elif v:
                print(f"{YEL}gemma: {v[0]} risk — {v[1]}{RESET}")
            else:
                print(f"{YEL}gemma review unavailable — confirm manually{RESET}")
        if not proceed:
            try:
                ans = input("> run this? [y]es/[s]kip/[q]uit: ").strip().lower()
            except (EOFError, KeyboardInterrupt):
                return 130
            if ans in ("q", "quit"):
                return 0
            if ans in ("s", "skip", "n", "no"):
                messages.append({"role": "user", "content": "Skipped by user. Propose an alternative or DONE."})
                continue
        rc, o = run(cmd, capture=True)
        messages.append({"role": "user", "content": f"exit={rc}\noutput:\n{o[:1500]}"})
    print(f"{YEL}reached {MAX_AUTO_STEPS}-step cap.{RESET}")
    return 0


# --- chat REPL ------------------------------------------------------------------
def _inline(s):
    """Render inline markdown: `code`, **bold**, *italic*, ~~strike~~."""
    s = re.sub(r"`([^`]+)`", lambda m: f"{CODE_FG}{m.group(1)}{RESET}", s)  # code first (protects)
    s = re.sub(r"\*\*([^*]+)\*\*|__([^_]+)__",
               lambda m: f"{BOLD}{m.group(1) or m.group(2)}{RESET}", s)
    s = re.sub(r"~~([^~]+)~~", lambda m: f"\033[9m{m.group(1)}{RESET}", s)
    s = re.sub(r"(?<![\*\w])\*([^*\s][^*]*?)\*(?!\w)", lambda m: f"{ITAL}{m.group(1)}{RESET}", s)
    s = re.sub(r"(?<![_\w])_([^_\s][^_]*?)_(?!\w)", lambda m: f"{ITAL}{m.group(1)}{RESET}", s)
    return s


def _prose(line):
    """Format one non-code line of markdown for the terminal."""
    h = re.match(r"^(#{1,6})\s+(.*)", line)
    if h:
        return f"{BOLD}{ULINE}{_inline(h.group(2))}{RESET}"
    b = re.match(r"^(\s*)[-*+]\s+(.*)", line)
    if b:
        return f"{b.group(1)}{DIM}•{RESET} {_inline(b.group(2))}"
    return _inline(line)


class MDRender:
    """Line-buffered streaming renderer: prose formatted; ```fenced``` blocks stream
    plain (top border + gutter, live) then redraw boxed + line-numbered on close, so a
    long code generation shows progress instead of a frozen gap while it buffers."""
    def __init__(self):
        self.tty = sys.stdout.isatty()
        self.buf, self.in_code, self.lang, self.code = "", False, "", []
        self.plain_rows = 0                   # terminal rows drawn for the in-progress block

    def _cols(self):
        return shutil.get_terminal_size((80, 24)).columns

    def feed(self, text):
        if not self.tty:                      # piped: keep it raw
            sys.stdout.write(text); sys.stdout.flush(); return
        self.buf += text
        while "\n" in self.buf:
            line, self.buf = self.buf.split("\n", 1)
            self._line(line)

    def _line(self, line):
        if line.lstrip().startswith("```"):
            if not self.in_code:
                self.in_code, self.lang, self.code = True, line.lstrip()[3:].strip(), []
                self._open()
            else:
                self._flush(); self.in_code = False
            return
        if self.in_code:
            self.code.append(line); self._stream_code(line)
        else:
            print(_prose(line))

    def _open(self):
        """Provisional top border so a streaming code block is visible immediately."""
        lang = self.lang or "code"
        inner = max(10, min(self._cols(), 80) - 2)
        sys.stdout.write(f"{DIM}┌─ {lang} " + "─" * max(0, inner - len(lang) - 3) + f"{RESET}\n")
        sys.stdout.flush()
        self.plain_rows = 1

    def _stream_code(self, cl):
        """Print one code line live, plain (no number — count isn't known yet)."""
        sys.stdout.write(f"{DIM}│{RESET} {cl}\n"); sys.stdout.flush()
        self.plain_rows += max(1, math.ceil(len("│ " + cl) / self._cols()))

    def _flush(self):
        rows, self.plain_rows = self.plain_rows, 0
        inner = max(10, min(self._cols(), 80) - 2)
        height = shutil.get_terminal_size((80, 24)).lines
        if rows and rows < height - 1:        # safe to erase the plain stream and redraw
            sys.stdout.write(f"\033[{rows}A\r\033[J")
            lang = self.lang or "code"
            numw = max(2, len(str(len(self.code))))
            print(f"{DIM}┌─ {lang} " + "─" * max(0, inner - len(lang) - 3) + RESET)
            for i, cl in enumerate(self.code, 1):
                print(f"{DIM}{str(i).rjust(numw)} │{RESET} {cl}")
            print(f"{DIM}└" + "─" * inner + RESET)
        else:                                 # taller than the viewport — keep the plain
            print(f"{DIM}└" + "─" * inner + RESET)  # stream, just close the box (no numbers)

    def finalize(self):
        if not self.tty:
            return
        if self.buf:
            if self.buf.lstrip().startswith("```"):   # trailing close fence, no newline
                self.buf = ""
            elif self.in_code:
                self.code.append(self.buf); self._stream_code(self.buf); self.buf = ""
            else:
                print(_prose(self.buf), end=""); self.buf = ""
        if self.in_code:
            self._flush(); self.in_code = False


def _collapse_think(think_buf, t0):
    """Erase the live-streamed thinking block and leave a one-line summary."""
    n = len("".join(think_buf))
    summary = f"{DIM}▸ thought {time.monotonic() - t0:.1f}s, {n} chars · /think to expand{RESET}"
    if not sys.stdout.isatty():           # piped: can't erase — just newline off the thinking
        sys.stdout.write(f"{RESET}\n{summary}\n")
        return
    width = shutil.get_terminal_size((80, 24)).columns
    visible = "[think] " + "".join(think_buf)
    rows = sum(max(1, math.ceil(len(l) / width)) for l in visible.split("\n"))
    sys.stdout.write(RESET)
    if rows > 1:
        sys.stdout.write(f"\033[{rows - 1}A")  # up to the block's first row
    sys.stdout.write(f"\r\033[J{summary}\n")   # wipe region, drop the summary


def stream(messages, think_store, model=None, base=None):
    model, base = model or MODEL, base or BASE
    body = json.dumps({"model": model, "messages": messages, "max_tokens": 8192, "stream": True}).encode()
    headers = {"Content-Type": "application/json"}
    if SESSION:
        headers["x-session-id"] = SESSION
    req = urllib.request.Request(f"{base}/chat/completions", body, headers)
    reply, think_buf, phase, t0 = [], [], "start", None
    md = MDRender()
    import select as _sel
    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    fd, old_tty = sys.stdin.fileno(), None
    try:
        if interactive:
            import termios, tty
            old_tty = termios.tcgetattr(fd)
            tty.setcbreak(fd)   # poll stdin for Esc without echo; keeps output CR + SIGINT
        with urllib.request.urlopen(req, timeout=600) as r:
            saint_b = r.headers.get("x-saint-backend")  # only SAINT sets x-saint-*
            dom, cx = r.headers.get("x-saint-domain", ""), r.headers.get("x-saint-complexity", "")
            cls, state = r.headers.get("x-saint-classifier", ""), r.headers.get("x-saint-state", "")
            bits = " · ".join(x for x in (f"{dom}/{cx}" if dom else "", cls, state) if x)
            banner_done = not saint_b
            for raw in r:
                if interactive and _sel.select([fd], [], [], 0)[0]:
                    ch = os.read(fd, 1)
                    if ch == b"\x1b":                        # Esc: bare = abort, seq = ignore
                        if _sel.select([fd], [], [], 0.02)[0]:
                            os.read(fd, 2)                   # drain arrow/escape sequence
                        else:
                            raise KeyboardInterrupt          # bare Esc aborts the generation
                line = raw.decode().strip()
                if not line.startswith("data: ") or line == "data: [DONE]":
                    continue
                chunk = json.loads(line[6:])
                if not banner_done:  # first chunk carries the actually-served model name
                    served = chunk.get("model", "")
                    arrow = f" >> {served}" if served and served != saint_b else ""
                    print(f"{DIM}⟿ saint → {saint_b}{arrow}" + (f" · {bits}" if bits else "") + RESET)
                    banner_done = True
                delta = chunk["choices"][0].get("delta") or {}
                rc = delta.get("reasoning_content") or delta.get("reasoning")
                if rc:
                    if phase != "thinking":
                        sys.stdout.write(f"{DIM}[think] "); phase, t0 = "thinking", time.monotonic()
                    sys.stdout.write(rc); sys.stdout.flush()
                    think_buf.append(rc)
                c = delta.get("content")
                if c:
                    if phase == "thinking":
                        _collapse_think(think_buf, t0)
                    phase = "content"
                    reply.append(c); md.feed(c)
    finally:
        if old_tty is not None:
            import termios
            termios.tcsetattr(fd, termios.TCSADRAIN, old_tty)
    md.finalize()
    sys.stdout.write(RESET if phase == "thinking" else "")
    print()
    if think_buf:
        think_store.append("".join(think_buf))
    return "".join(reply)


def _pick(labels, start):
    """Selector; returns (index, make_default) or None. Falls back to numbers off-TTY.

    enter → use for the session; ctrl+enter (terminals that send LF) or 'd' → also
    persist as the launch default; q / bare-Esc → cancel.
    """
    if not sys.stdin.isatty():
        for i, lab in enumerate(labels, 1):
            print(f" {i}. {lab}")
        try:
            s = input("switch to (number, or Nd for default, blank=keep): ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            return None
        mk = s.endswith("d"); s = s[:-1] if mk else s
        return (int(s) - 1, mk) if s.isdigit() and 1 <= int(s) <= len(labels) else None

    import select, termios, tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    sel = start
    print(f"{DIM}↑/↓ or j/k · enter use · ctrl+enter or d set default · q cancel{RESET}")

    def draw(first=False):
        if not first:
            sys.stdout.write(f"\033[{len(labels)}A")
        for i, lab in enumerate(labels):
            cur = f"{BOLD}❯ " if i == sel else "  "
            sys.stdout.write(f"\r\033[K{cur}{lab}{RESET}\r\n")
        sys.stdout.flush()

    try:
        tty.setraw(fd)                       # raw ONCE for the whole selection
        draw(first=True)
        while True:
            ch = os.read(fd, 1)              # read the fd directly, not buffered stdin
            if ch == b"\r":                  # Enter → session only
                return (sel, False)
            if ch in (b"\n", b"d", b"D"):    # Ctrl+Enter (LF) or 'd' → set as default
                return (sel, True)
            if ch in (b"q", b"\x03"):        # q / Ctrl-C
                return None
            if ch == b"\x1b":                # ESC: arrow burst (ESC [ A/B) or bare ESC
                if select.select([fd], [], [], 0.05)[0]:
                    seq = os.read(fd, 2)
                    if seq == b"[A":
                        sel = (sel - 1) % len(labels); draw()
                    elif seq == b"[B":
                        sel = (sel + 1) % len(labels); draw()
                else:
                    return None              # bare ESC cancels
            elif ch == b"k":
                sel = (sel - 1) % len(labels); draw()
            elif ch == b"j":
                sel = (sel + 1) % len(labels); draw()
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def models_menu():
    global MODEL, BASE
    names = list(SEATS)
    default = load_default_seat() or "gemma"
    cur = next((i for i, n in enumerate(names) if SEATS[n] == (MODEL, BASE)), 0)
    labels = []
    for n in names:
        m, b = SEATS[n]
        status = "up" if seat_alive(b) else f"{DIM}down{RESET}"
        star = f"{YEL}★{RESET}" if n == default else " "
        labels.append(f"{star} {n:<8} {m}  [{status}]")
    res = _pick(labels, cur)
    if res is None:
        return
    idx, make_default = res
    MODEL, BASE = SEATS[names[idx]]
    tail = ""
    if make_default:
        tail = "  (saved as default)" if save_default_seat(names[idx]) else "  (default save failed)"
    print(f"→ {MODEL} @ {BASE}{tail}  (history carries over)")


def _seat_labels():
    names, default = list(SEATS), load_default_seat() or "gemma"
    cur = next((i for i, n in enumerate(names) if SEATS[n] == (MODEL, BASE)), 0)
    labels = []
    for n in names:
        m, b = SEATS[n]
        status = "up" if seat_alive(b) else f"{DIM}down{RESET}"
        star = f"{YEL}★{RESET}" if n == default else " "
        labels.append(f"{star} {n:<12} {m}  [{status}]")
    return names, labels, cur


def choose_seat():
    """Open the picker, return a seat name for a one-shot (never persists/activates)."""
    names, labels, cur = _seat_labels()
    res = _pick(labels, cur)
    return names[res[0]] if res else None


def active_name():
    return next((n for n, (m, b) in SEATS.items() if (m, b) == (MODEL, BASE)), MODEL)


def _prompt():
    n = active_name()
    color = YEL if n == "saint" or n.startswith("cloud") else CODE_FG   # highlight routed/cloud seats
    return f"{color}{n}{RESET} > "


def read_line(prompt):
    """cbreak line reader: returns (text, mode). mode 'send' on Enter, 'pick' on
    Ctrl+Enter (terminals that send LF), None text with 'eof' on Ctrl-D. Falls back
    to input() off-TTY. Up/down walk readline history; basic cursor editing."""
    if not sys.stdin.isatty():
        try:
            return input(prompt), "send"
        except EOFError:
            return None, "eof"
    import select, termios
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    new = termios.tcgetattr(fd)
    new[3] &= ~(termios.ICANON | termios.ECHO)             # lflag: no line-buffer/echo (ISIG stays)
    new[0] &= ~(termios.ICRNL | termios.INLCR | termios.IGNCR)  # keep CR (Enter) and NL (Ctrl+Enter) distinct
    new[6][termios.VMIN], new[6][termios.VTIME] = 1, 0
    buf, pos = [], 0
    hlen = _rl.get_current_history_length() if _rl else 0
    hidx, saved = hlen, ""

    def redraw():
        sys.stdout.write("\r\033[K" + prompt + "".join(buf))
        back = len(buf) - pos
        if back:
            sys.stdout.write(f"\033[{back}D")
        sys.stdout.flush()

    def load(item):
        nonlocal buf, pos
        buf, pos = list(item), len(item); redraw()

    try:
        termios.tcsetattr(fd, termios.TCSANOW, new)
        redraw()
        while True:
            ch = os.read(fd, 1)
            if ch == b"\r":
                sys.stdout.write("\r\n"); return "".join(buf), "send"
            if ch == b"\n":
                sys.stdout.write("\r\n"); return "".join(buf), "pick"
            if ch == b"\x04":                          # Ctrl-D
                if not buf:
                    sys.stdout.write("\r\n"); return None, "eof"
            elif ch in (b"\x7f", b"\x08"):             # backspace
                if pos > 0:
                    del buf[pos - 1]; pos -= 1; redraw()
            elif ch == b"\x01":                        # Ctrl-A home
                pos = 0; redraw()
            elif ch == b"\x05":                        # Ctrl-E end
                pos = len(buf); redraw()
            elif ch == b"\x15":                        # Ctrl-U kill to start
                del buf[:pos]; pos = 0; redraw()
            elif ch == b"\x0b":                        # Ctrl-K kill to end
                del buf[pos:]; redraw()
            elif ch == b"\x1b":                        # escape sequences
                if select.select([fd], [], [], 0.05)[0]:
                    seq = os.read(fd, 2)
                    if seq == b"[A" and _rl and hidx > 0:
                        if hidx == hlen:
                            saved = "".join(buf)
                        hidx -= 1; load(_rl.get_history_item(hidx + 1) or "")
                    elif seq == b"[B" and _rl and hidx < hlen:
                        hidx += 1; load(saved if hidx == hlen else (_rl.get_history_item(hidx + 1) or ""))
                    elif seq == b"[C" and pos < len(buf):
                        pos += 1; redraw()
                    elif seq == b"[D" and pos > 0:
                        pos -= 1; redraw()
                    elif seq in (b"[H", b"OH"):
                        pos = 0; redraw()
                    elif seq in (b"[F", b"OF"):
                        pos = len(buf); redraw()
            elif ch >= b"\x20":                        # printable (+ utf-8 continuation)
                b0 = ch[0]
                extra = 0 if b0 < 0x80 else (1 if b0 < 0xE0 else (2 if b0 < 0xF0 else 3))
                if extra:
                    ch += os.read(fd, extra)
                try:
                    for cc in ch.decode():
                        buf.insert(pos, cc); pos += 1
                    redraw()
                except Exception:
                    pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def code_blocks(text):
    blocks, cur, in_code = [], [], False
    for line in (text or "").split("\n"):
        if line.lstrip().startswith("```"):
            if in_code:
                blocks.append("\n".join(cur)); cur, in_code = [], False
            else:
                in_code = True
        elif in_code:
            cur.append(line)
    if in_code and cur:
        blocks.append("\n".join(cur))
    return blocks


def _turn(history, thinks, user, model=None, base=None):
    history.append({"role": "user", "content": user})
    try:
        history.append({"role": "assistant", "content": stream(history, thinks, model=model, base=base)})
    except KeyboardInterrupt:
        print(f"{RESET}\n(interrupted)"); history.pop()
    except Exception as e:
        print(f"[error: {e}]"); history.pop()


def repl():
    global SESSION
    history, thinks = [], []
    SESSION = "qchat-" + os.urandom(6).hex()
    print(f"qchat → {MODEL} @ {BASE}  (enter send · ctrl+enter one-shot to another seat · "
          f"/models /think /clear · exit/^D quits · Esc aborts · ^C copies code)")
    while True:
        print()  # blank line before each prompt
        try:
            user, mode = read_line(_prompt())
        except KeyboardInterrupt:
            # ^C on the prompt: copy the last reply's code blocks (terminals that copy a
            # mouse selection on ^C never deliver this — so selection-copy still wins).
            last = next((m["content"] for m in reversed(history) if m["role"] == "assistant"), "")
            blocks = code_blocks(last)
            if blocks and copy_clip("\n\n".join(blocks)):
                print(f"\n(copied {len(blocks)} code block{'s' * (len(blocks) != 1)})")
            elif blocks:
                print("\n(no clipboard tool found)")
            else:
                print("\n(no code blocks — ^D or /quit to exit)")
            continue
        if user is None:                       # Ctrl-D
            break
        user = user.strip()
        if user and _rl:                       # every submitted line joins input history
            _safe(lambda: _rl.add_history(user))
        if mode == "pick":                     # Ctrl+Enter → one-shot to a chosen seat
            if not user:
                continue
            seat = choose_seat()
            if not seat:
                print("(cancelled)"); continue
            m, b = SEATS[seat]
            _turn(history, thinks, user, model=m, base=b)
            print(f"{DIM}(one-shot via {seat} · active seat still {MODEL}){RESET}")
            continue
        if not user or user in ("/quit", "exit"):
            break
        if user in ("/models", "/model"):
            models_menu(); continue
        if user in ("/think", "/expand"):
            print(f"{DIM}{thinks[-1]}{RESET}" if thinks else "(no thinking recorded yet)")
            continue
        if user == "/clear":
            history.clear(); thinks.clear()
            SESSION = "qchat-" + os.urandom(6).hex()   # fresh conversation → fresh affinity
            print("(history cleared)"); continue
        _turn(history, thinks, user)


# --- arg parsing ----------------------------------------------------------------
argv = sys.argv[1:]
MODE, task_words = None, None
for flag in ("-e", "-x", "--goal", "--auto", "--gen"):
    if flag in argv:
        i = argv.index(flag)
        MODE, task_words, argv = flag, argv[i + 1:], argv[:i]
        break

if argv and argv[0] in SEATS:
    MODEL, BASE = SEATS[argv[0]]
elif argv:
    MODEL, BASE = argv[0], (argv[1] if len(argv) > 1 else "http://127.0.0.1:8002/v1")
elif MODE in ("-e", "-x", "--goal", "--auto", "--gen"):
    MODEL, BASE = SEATS["coder"]     # command/goal work → coder seat
else:
    MODEL, BASE = SEATS[load_default_seat() or "gemma"]   # chat → saved default (else gemma)


def _task():
    t = " ".join(task_words)
    if t:
        return t
    if MODE == "--gen":
        sys.exit("usage: qchat --gen <buffer text>")
    try:
        return input("task: ").strip()
    except (EOFError, KeyboardInterrupt):
        sys.exit(130)


if MODE == "--gen":
    sys.stdout.write(generate(_task()))
elif MODE in ("-e", "-x"):
    sys.exit(shell_mode(_task(), auto=(MODE == "-x")))
elif MODE in ("--goal", "--auto"):
    sys.exit(goal_mode(_task(), auto=(MODE == "--auto")))
else:
    repl()
